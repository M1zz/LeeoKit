    "같은 iCloud 를 쓰는 두 앱은 같은 할 일을 봅니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvě aplikace se stejným iCloudem vidí stejné úkoly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To apps på den samme iCloud ser de samme opgaver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Apps mit derselben iCloud sehen dieselben Aufgaben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο εφαρμογές στο ίδιο iCloud βλέπουν τις ίδιες εργασίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two apps on the same iCloud see the same tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos apps con el mismo iCloud ven las mismas tareas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi samaa iCloudia käyttävää appia näkee samat tehtävät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux apps sur le même iCloud voient les mêmes tâches."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua aplikasi pada iCloud yang sama melihat tugas yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due app sullo stesso iCloud vedono le stesse attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じiCloudを使う二つのアプリは、同じやることを見ています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 iCloud 를 쓰는 두 앱은 같은 할 일을 봅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To apper på samme iCloud ser de samme oppgavene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee apps met dezelfde iCloud zien dezelfde taken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie aplikacje na tym samym koncie iCloud widzą te same zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois apps no mesmo iCloud veem as mesmas tarefas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два приложения на одном iCloud видят одни и те же дела."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två appar med samma iCloud ser samma uppgifter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองแอปที่ใช้ iCloud เดียวกันจะเห็นงานเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı iCloud hesabını kullanan iki uygulama aynı görevleri görür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ứng dụng dùng chung iCloud sẽ thấy cùng danh sách việc cần làm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用同一个 iCloud 的两个应用，看到的是同一批待办。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用同一個 iCloud 的兩個應用，看到的是同一批待辦。"
          }
        }
      }
    },
    "같은 답장을 하루에도 몇 번씩 보내는 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří posílají stejnou odpověď několikrát denně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der sender det samme svar flere gange om dagen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die dieselbe Antwort mehrmals am Tag verschicken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι στέλνουν την ίδια απάντηση πολλές φορές τη μέρα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who send the same reply several times a day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien envía la misma respuesta varias veces al día"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka lähettävät saman vastauksen monta kertaa päivässä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui envoient la même réponse plusieurs fois par jour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang mengirim balasan yang sama beberapa kali sehari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi manda la stessa risposta più volte al giorno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ返信を一日に何度も送る人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 답장을 하루에도 몇 번씩 보내는 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som sender det samme svaret flere ganger om dagen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die dezelfde reactie meerdere keren per dag versturen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które kilka razy dziennie wysyłają tę samą odpowiedź"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem envia a mesma resposta várias vezes por dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто по нескольку раз в день отправляет один и тот же ответ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som skickar samma svar flera gånger om dagen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ส่งข้อความตอบกลับเดิมๆ หลายครั้งต่อวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı yanıtı günde birkaç kez gönderenler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người gửi cùng một câu trả lời nhiều lần mỗi ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天要发好几次相同回复的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一天要發好幾次相同回覆的人"
          }
        }
      }
    },
    "같은 문장을 다시 쓰지 않고, 마감을 놓치지 않습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejné řádky už nikdy nepřepisujete a nezmeškáte žádný termín."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skriver aldrig de samme linjer igen, og du misser aldrig en deadline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tippst dieselben Zeilen nie wieder ab und verpasst keine Frist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ξαναγράφετε ποτέ τις ίδιες φράσεις και δεν χάνετε ποτέ προθεσμία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You never retype the same lines, and you never miss the deadline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vuelves a escribir las mismas frases y nunca se te pasa un plazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samoja rivejä ei tarvitse kirjoittaa uudelleen, eikä yksikään määräaika unohdu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne retapez plus les mêmes phrases, et vous ne manquez plus l’échéance."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang sama tak perlu ditulis ulang, dan tenggat tidak terlewat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riscrivi mai le stesse righe e non perdi mai una scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ文章を書き直さず、締め切りも逃しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 문장을 다시 쓰지 않고, 마감을 놓치지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skriver aldri de samme linjene på nytt, og du går aldri glipp av en frist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je typt nooit meer dezelfde zinnen opnieuw en mist nooit meer een deadline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przepisujesz w kółko tych samych zdań i nie przegapiasz terminu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você nunca redigita as mesmas frases e nunca perde o prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одни и те же фразы не приходится писать заново, а срок не проходит мимо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skriver aldrig om samma rader och missar aldrig en deadline."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องพิมพ์ประโยคเดิมซ้ำ และไม่พลาดกำหนดส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı satırları bir daha yazmazsınız, son tarihi de kaçırmazsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải gõ lại cùng một câu, không lỡ hạn chót."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的句子不用再写一遍，截止也不会错过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同樣的句子不用再寫一遍，截止也不會錯過。"
          }
        }
      }
    },
    "같은 사람이 만든 앱들입니다. 겹치는 자리가 있어서, 붙여 두면 하루가 이어집니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto aplikace pochází od stejného autora. Na některých místech se překrývají, takže když je používáte vedle sebe, provedou vás celým dnem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er apps fra den samme udvikler. De overlapper nogle steder, så når du bruger dem side om side, hænger dagen sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind Apps vom selben Entwickler. Sie überschneiden sich an manchen Stellen, und nebeneinander genutzt tragen sie dich durch den Tag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές οι εφαρμογές είναι του ίδιου δημιουργού. Αλληλοσυμπληρώνονται, οπότε μαζί σάς συνοδεύουν σε όλη τη μέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are apps by the same maker. They overlap in places, so keeping them side by side lets a day carry through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son apps del mismo creador. Se solapan en algunos puntos, así que tenerlas juntas hace que el día fluya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä apit ovat saman tekijän. Ne kohtaavat toisensa monessa kohdassa, joten rinnakkain käytettyinä ne kantavat läpi päivän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces apps sont du même créateur. Elles se recoupent par endroits : en les gardant côte à côte, votre journée s’enchaîne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini aplikasi buatan orang yang sama. Ada bagian yang bertumpang tindih, jadi bila disandingkan, satu hari jadi tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono app dello stesso autore. Si sovrappongono in alcuni punti, quindi tenerle una accanto all’altra fa scorrere la giornata senza interruzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ作者が作ったアプリです。重なる部分があるので、並べておくと一日がつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 사람이 만든 앱들입니다. 겹치는 자리가 있어서, 붙여 두면 하루가 이어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse appene er laget av samme utvikler. De overlapper noen steder, så når du bruker dem side om side, henger dagen sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn apps van dezelfde maker. Ze overlappen op sommige plekken, dus als je ze naast elkaar gebruikt, loopt je dag soepel door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To aplikacje tego samego twórcy. W kilku miejscach się zazębiają, więc używane razem prowadzą Cię przez cały dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São apps do mesmo criador. Eles se complementam em alguns pontos, então usá-los lado a lado deixa o dia fluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложения одного автора. У них есть общие места, и если держать их рядом, день не рвётся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här apparna kommer från samma utvecklare. De överlappar på flera ställen, så när du använder dem sida vid sida hänger dagen ihop."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเหล่านี้สร้างโดยผู้พัฒนาคนเดียวกัน มีส่วนที่ทับซ้อนกัน ใช้คู่กันแล้ววันของคุณจะต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar aynı geliştiricinin uygulamaları. Bazı yerlerde kesişirler; yan yana kullanınca gününüz kesintisiz ilerler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là các ứng dụng của cùng một nhà phát triển. Chúng giao nhau ở nhiều chỗ, nên dùng cạnh nhau giúp cả ngày liền mạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "都是同一个人做的应用。彼此有重叠的地方，放在一起，一天就接得上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "都是同一個人做的應用。彼此有重疊的地方，放在一起，一天就接得上。"
          }
        }
      }
    },
