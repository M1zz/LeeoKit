    "아직 답장이 없어요. 모든 의견은 개발자가 직접 읽어요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Antwort. Der Entwickler liest jedes Feedback persönlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply yet. The developer reads every message personally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay respuesta. El desarrollador lee personalmente cada comentario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de réponse. Le développeur lit personnellement chaque avis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada balasan. Pengembang membaca setiap masukan secara langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna risposta. Lo sviluppatore legge personalmente ogni feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ返信はありません。すべてのご意見は開発者が直接読んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 답장이 없어요. 모든 의견은 개발자가 직접 읽어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem resposta. O desenvolvedor lê pessoalmente cada feedback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответа пока нет. Разработчик лично читает каждый отзыв."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการตอบกลับ ผู้พัฒนาอ่านทุกความคิดเห็นด้วยตัวเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có phản hồi. Nhà phát triển tự đọc mọi góp ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有回复。每条反馈开发者都会亲自阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有回覆。每則意見開發者都會親自閱讀。"
          }
        }
      }
    },
    "예) 매번 다른 앱에서 복사해 와요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Ich kopiere es jedes Mal aus einer anderen App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. I copy it from another app every time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., lo copio de otra app cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. Je le copie depuis une autre app à chaque fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. Saya menyalinnya dari aplikasi lain setiap kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. Lo copio ogni volta da un'altra app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）毎回ほかのアプリからコピーしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 매번 다른 앱에서 복사해 와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: Copio de outro app toda vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: каждый раз копирую из другого приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น คัดลอกมาจากแอปอื่นทุกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví dụ: Lần nào tôi cũng sao chép từ ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例）每次都从别的 App 复制过来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例）每次都從別的 App 複製過來。"
          }
        }
      }
    },
    "의견을 보내면 여기에 남고, 답장도 여기로 와요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesendetes Feedback bleibt hier, und Antworten kommen ebenfalls hierher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback you send is kept here, and replies arrive here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios que envíes se guardan aquí y las respuestas también llegan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avis envoyés restent ici, et les réponses arrivent ici aussi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukan yang Anda kirim tersimpan di sini, dan balasannya juga datang ke sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback inviato resta qui e anche le risposte arrivano qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送ったご意見はここに残り、返信もここに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 보내면 여기에 남고, 답장도 여기로 와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O feedback enviado fica aqui, e as respostas também chegam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправленные отзывы хранятся здесь, сюда же приходят ответы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นที่ส่งจะเก็บไว้ที่นี่ และการตอบกลับก็จะมาที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góp ý bạn gửi được lưu ở đây, và phản hồi cũng sẽ đến đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送的反馈会保存在这里，回复也会送到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "送出的意見會保留在這裡，回覆也會送到這裡。"
          }
        }
      }
    },
    "이 기기에서 보낸 의견이 없어요": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Gerät wurde noch kein Feedback gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't sent feedback from this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has enviado comentarios desde este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun avis envoyé depuis cet appareil"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada masukan yang dikirim dari perangkat ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun feedback inviato da questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末から送ったご意見はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 보낸 의견이 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum feedback enviado deste dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этого устройства отзывы не отправлялись"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้ส่งความคิดเห็นจากอุปกรณ์นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa gửi góp ý nào từ thiết bị này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备还没有发送过反馈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置還沒有送出過意見"
          }
        }
      }
    },
    "이메일이 없어도 답장은 설정의 보낸 의견에서 볼 수 있어요. 이메일은 이 기기에만 저장해 다음에 다시 채워드려요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch ohne E-Mail findest du Antworten unter Einstellungen > Gesendetes Feedback. Die E-Mail wird nur auf diesem Gerät gespeichert und beim nächsten Mal eingesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even without an email, you can read replies in Settings > Sent Feedback. Your email is saved only on this device to fill in next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque no dejes correo, puedes ver las respuestas en Ajustes > Comentarios enviados. El correo solo se guarda en este dispositivo para rellenarlo la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même sans e-mail, vous pouvez lire les réponses dans Réglages > Avis envoyés. L’e-mail est enregistré uniquement sur cet appareil pour être prérempli la prochaine fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa email pun, balasan dapat dibaca di Pengaturan > Masukan Terkirim. Email hanya disimpan di perangkat ini untuk diisi otomatis lain kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche senza email, puoi leggere le risposte in Impostazioni > Feedback inviati. L'email viene salvata solo su questo dispositivo per compilarla la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールがなくても、返信は設定の「送ったご意見」で見られます。メールはこの端末にだけ保存し、次回自動で入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일이 없어도 답장은 설정의 보낸 의견에서 볼 수 있어요. 이메일은 이 기기에만 저장해 다음에 다시 채워드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo sem e-mail, você vê as respostas em Ajustes > Feedback enviado. O e-mail fica salvo só neste dispositivo para ser preenchido da próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже без e-mail ответы можно прочитать в Настройках > Отправленные отзывы. E-mail хранится только на этом устройстве и подставится в следующий раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ไม่มีอีเมล คุณก็อ่านการตอบกลับได้ที่ การตั้งค่า > ความคิดเห็นที่ส่งแล้ว อีเมลจะบันทึกไว้ในอุปกรณ์นี้เท่านั้นเพื่อกรอกให้ในครั้งถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù không có email, bạn vẫn đọc được phản hồi trong Cài đặt > Góp ý đã gửi. Email chỉ được lưu trên thiết bị này để tự điền lần sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使不留邮箱，也能在 设置 > 已发送的反馈 中查看回复。邮箱只保存在这台设备上，下次自动填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使不留電子郵件，也能在 設定 > 已送出的意見 中查看回覆。電子郵件只儲存在這台裝置上，下次自動填寫。"
          }
        }
      }
    },
