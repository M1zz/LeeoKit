          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "意見回饋已發送！\n謝謝你寶貴的意見 🙏"
          }
        }
      }
    },
    "피드백을 불러오지 못했어요: %@": {
      "localizations": {
