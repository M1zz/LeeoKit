          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能建议"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "功能建議"
          }
        }
      }
    },
    "기타": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Other"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
