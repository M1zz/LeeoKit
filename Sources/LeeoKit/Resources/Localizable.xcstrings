    "종료 10분 전, 5분 전처럼 원하는 시점마다 미리 알립니다. 잠금 화면과 애플워치에서 남은 시간이 계속 보입니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es warnt dich zu den Zeitpunkten, die du wählst, zehn Minuten vor dem Ende, fünf Minuten vorher. Die verbleibende Zeit bleibt auf dem Sperrbildschirm und auf der Apple Watch sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It warns you at the points you choose, ten minutes before the end, five minutes before. The time left stays visible on the Lock Screen and on Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa en los momentos que elijas: diez minutos antes del final, cinco minutos antes. El tiempo restante sigue visible en la pantalla bloqueada y en el Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous prévient aux moments que vous choisissez, dix minutes avant la fin, cinq minutes avant. Le temps restant reste visible sur l’écran verrouillé et sur l’Apple Watch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia memberi tahu pada saat yang Anda pilih, sepuluh menit sebelum berakhir, lima menit sebelumnya. Sisa waktu terus terlihat di Layar Terkunci dan Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa nei momenti che scegli, dieci minuti prima della fine, cinque minuti prima. Il tempo rimasto resta visibile sulla schermata di blocco e su Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了10分前、5分前など、好きな時点で先に知らせます。ロック画面とApple Watchに残り時間が出続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 10분 전, 5분 전처럼 원하는 시점마다 미리 알립니다. 잠금 화면과 애플워치에서 남은 시간이 계속 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele avisa nos momentos que você escolher, dez minutos antes do fim, cinco minutos antes. O tempo restante fica visível na Tela Bloqueada e no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он предупредит в те моменты, что вы выбрали: за десять минут до конца, за пять. Оставшееся время видно на заблокированном экране и на Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนล่วงหน้าตามเวลาที่คุณเลือก เช่น ก่อนหมดเวลา 10 นาทีหรือ 5 นาที เวลาที่เหลือแสดงตลอดบนหน้าจอล็อกและ Apple Watch"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo trước vào những thời điểm bạn chọn, như mười phút hay năm phút trước khi kết thúc. Thời gian còn lại luôn hiện trên màn hình khóa và Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束前十分钟、五分钟，你想要的时点都会先提醒。锁定屏幕和 Apple Watch 上一直看得到剩余时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束前十分鐘、五分鐘，你想要的時點都會先提醒。鎖定螢幕和 Apple Watch 上一直看得到剩餘時間。"
          }
        }
      }
    },
    "주 단위로 계획을 세워 두고 움직이는 사람": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die jeweils eine Woche planen, bevor sie loslegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who plan a week at a time before they move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien planifica la semana entera antes de ponerse en marcha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui planifient la semaine avant d’agir"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang merencanakan sepekan lebih dulu sebelum bergerak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi pianifica una settimana alla volta prima di muoversi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一週間単位で計画を立ててから動く人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 단위로 계획을 세워 두고 움직이는 사람"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem planeja uma semana de cada vez antes de agir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто сначала планирует неделю, а потом действует"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่วางแผนเป็นรายสัปดาห์ก่อนลงมือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người lên kế hoạch theo tuần trước khi bắt tay vào làm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯先按周做计划再行动的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣先按周做計劃再行動的人"
          }
        }
      }
    },
    "중간에 들어온 문의는 클립키보드에 정해 둔 답장으로 짧게 끊습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen, die mitten in der Stunde reinkommen, beantwortest du kurz mit einer in ClipKeyboard hinterlegten Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions that arrive mid-hour get cut short with a reply you set in ClipKeyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las consultas que llegan a mitad de la hora se despachan con una respuesta que preparaste en ClipKeyboard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions qui arrivent en cours d’heure sont écourtées grâce à une réponse préparée dans ClipKeyboard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan yang masuk di tengah jalan dipotong pendek dengan balasan yang sudah disiapkan di ClipKeyboard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande che arrivano a metà dell’ora si chiudono in fretta con una risposta impostata in ClipKeyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で入った問い合わせは、ClipKeyboardに決めておいた返信で短く切ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간에 들어온 문의는 클립키보드에 정해 둔 답장으로 짧게 끊습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas que chegam no meio da hora são encerradas rapidinho com uma resposta que você deixou pronta no ClipKeyboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы, пришедшие посреди часа, закрываются заготовленным ответом из ClipKeyboard."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำถามที่เข้ามากลางคัน ตอบสั้นๆ ด้วยข้อความที่ตั้งไว้ใน ClipKeyboard"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu hỏi đến giữa chừng được trả lời gọn bằng câu soạn sẵn trong ClipKeyboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中途进来的问询，用剪贴键盘里设好的回复短短带过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中途進來的問詢，用剪貼鍵盤裡設好的回覆短短帶過。"
          }
        }
      }
    },
    "지금 쓰고 계신 앱이 나오는 장면들입니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Szenen, in denen die App vorkommt, die du gerade nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenes where the app you are using shows up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escenas en las que aparece la app que estás usando."
          }
        },
        "fr": {
          "stringUnit": {
