    "사라지기 전에 무엇을 했나요?": {
      "comment": "Data loss prompt: what happened before",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste dělali, než data zmizela?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad gjorde du, før det forsvandt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hast du vorher gemacht?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι κάνατε πριν χαθούν;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did you do right before it disappeared?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hiciste antes de que desapareciera?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä teit ennen kuin tiedot katosivat?"
          }
