    "종료 10분 전, 5분 전처럼 원하는 시점마다 미리 알립니다. 잠금 화면과 애플워치에서 남은 시간이 계속 보입니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorní vás ve zvolených okamžicích, deset minut před koncem, pět minut předem. Zbývající čas máte stále na očích na zamčené obrazovce i na Apple Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den advarer dig på de tidspunkter, du vælger – ti minutter før slut, fem minutter før. Den resterende tid kan ses hele tiden på låseskærmen og på Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es warnt dich zu den Zeitpunkten, die du wählst, zehn Minuten vor dem Ende, fünf Minuten vorher. Die verbleibende Zeit bleibt auf dem Sperrbildschirm und auf der Apple Watch sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σας ειδοποιεί στα σημεία που επιλέγετε, δέκα λεπτά πριν από το τέλος, πέντε λεπτά πριν. Ο χρόνος που απομένει φαίνεται συνεχώς στην οθόνη κλειδώματος και στο Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It warns you at the points you choose, ten minutes before the end, five minutes before. The time left stays visible on the Lock Screen and on Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa en los momentos que elijas: diez minutos antes del final, cinco minutos antes. El tiempo restante sigue visible en la pantalla bloqueada y en el Apple Watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se varoittaa valitsemissasi kohdissa, kuten kymmenen ja viisi minuuttia ennen loppua. Jäljellä oleva aika näkyy koko ajan lukitusnäytöllä ja Apple Watchissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous prévient aux moments que vous choisissez, dix minutes avant la fin, cinq minutes avant. Le temps restant reste visible sur l’écran verrouillé et sur l’Apple Watch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia memberi tahu pada saat yang Anda pilih, sepuluh menit sebelum berakhir, lima menit sebelumnya. Sisa waktu terus terlihat di Layar Terkunci dan Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa nei momenti che scegli, dieci minuti prima della fine, cinque minuti prima. Il tempo rimasto resta visibile sulla schermata di blocco e su Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了10分前、5分前など、好きな時点で先に知らせます。ロック画面とApple Watchに残り時間が出続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 10분 전, 5분 전처럼 원하는 시점마다 미리 알립니다. 잠금 화면과 애플워치에서 남은 시간이 계속 보입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den varsler deg på tidspunktene du velger, ti minutter før slutt, fem minutter før. Tiden som er igjen, vises hele tiden på låseskjermen og på Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij waarschuwt je op de momenten die jij kiest: tien minuten voor het einde, vijf minuten ervoor. De resterende tijd blijft zichtbaar op het toegangsscherm en op je Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrzega w wybranych momentach: dziesięć minut przed końcem, pięć minut przed końcem. Pozostały czas jest cały czas widoczny na ekranie blokady i na Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele avisa nos momentos que você escolher, dez minutos antes do fim, cinco minutos antes. O tempo restante fica visível na Tela Bloqueada e no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он предупредит в те моменты, что вы выбрали: за десять минут до конца, за пять. Оставшееся время видно на заблокированном экране и на Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den varnar dig vid de tidpunkter du väljer, tio minuter före slutet, fem minuter före. Tiden som är kvar syns hela tiden på låsskärmen och på Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนล่วงหน้าตามเวลาที่คุณเลือก เช่น ก่อนหมดเวลา 10 นาทีหรือ 5 นาที เวลาที่เหลือแสดงตลอดบนหน้าจอล็อกและ Apple Watch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz anlarda, bitimine on dakika ve beş dakika kala sizi uyarır. Kalan süre Kilitli Ekran'da ve Apple Watch'ta görünmeye devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo trước vào những thời điểm bạn chọn, như mười phút hay năm phút trước khi kết thúc. Thời gian còn lại luôn hiện trên màn hình khóa và Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束前十分钟、五分钟，你想要的时点都会先提醒。锁定屏幕和 Apple Watch 上一直看得到剩余时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束前十分鐘、五分鐘，你想要的時點都會先提醒。鎖定螢幕和 Apple Watch 上一直看得到剩餘時間。"
          }
        }
      }
    },
    "주 단위로 계획을 세워 두고 움직이는 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří si naplánují celý týden, než se do něj pustí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der planlægger en uge ad gangen, før de går i gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die jeweils eine Woche planen, bevor sie loslegen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι σχεδιάζουν μια εβδομάδα τη φορά πριν ξεκινήσουν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who plan a week at a time before they move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien planifica la semana entera antes de ponerse en marcha"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka suunnittelevat viikon kerrallaan ennen kuin toimivat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui planifient la semaine avant d’agir"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang merencanakan sepekan lebih dulu sebelum bergerak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi pianifica una settimana alla volta prima di muoversi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一週間単位で計画を立ててから動く人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 단위로 계획을 세워 두고 움직이는 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som planlegger en uke om gangen før de setter i gang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die steeds een week vooruit plannen voordat ze beginnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które planują tydzień z góry, zanim zaczną działać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
