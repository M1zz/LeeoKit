          }
        }
      }
    },
    "혼자 쓰기보다, 이어 쓸 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better together than alone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih baik disambung daripada sendiri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつで使うより、つないで使うとき"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе лучше, чем поодиночке"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比起单独用，连起来用时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比起單獨用，連起來用時"
          }
        }
      }
    },
    "활성 피드백이 없어요. 모두 완료했어요 🎉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active feedback. All done 🎉"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada masukan aktif. Semua selesai 🎉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなフィードバックはありません。すべて完了 🎉"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待处理的反馈，全都处理完了 🎉"
