            "value": "Jeder Code kann nur einmal von einer Person eingelöst werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε κωδικός χρησιμοποιείται μία φορά από ένα άτομο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each code can be used once, by one person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada código solo puede usarlo una persona, una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunkin koodin voi käyttää vain kerran ja vain yksi henkilö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque code ne peut être utilisé qu’une fois, par une seule personne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kode hanya bisa dipakai sekali oleh satu orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni codice può essere usato una sola volta, da una sola persona."
          }
        },
