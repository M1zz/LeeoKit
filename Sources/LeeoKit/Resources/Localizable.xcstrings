            "value": "Des scènes où apparaît l’app que vous utilisez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Adegan tempat aplikasi yang sedang Anda pakai muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene in cui compare l’app che stai usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今お使いのアプリが出てくる場面です。"
