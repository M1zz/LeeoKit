        }
      }
    },
    "맥을 켜고 오늘 할 일을 앉히는 삼십 분.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thirty minutes where you switch on the Mac and seat today's work."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga puluh menit untuk menyalakan Mac dan menata pekerjaan hari ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macを立ち上げ、今日の仕事を並べる三十分。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полчаса, за которые вы включаете Mac и рассаживаете сегодняшние дела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Mac、把今天的活儿安排好的三十分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Mac、把今天的活兒安排好的三十分鐘。"
          }
        }
      }
    },
    "메뉴바에서 한 번, 맥에서도 같은 문장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One click in the menu bar, the same lines on your Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali klik di bilah menu, kalimat yang sama di Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーからひと押し、Macでも同じ文章"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие в строке меню, те же фразы на Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏点一下，Mac 上也是同样的句子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜單欄點一下，Mac 上也是同樣的句子"
          }
        }
      }
    },
    "메일 앱을 열 수 없습니다": {
      "localizations": {
