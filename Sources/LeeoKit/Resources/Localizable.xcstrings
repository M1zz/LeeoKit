    "탭하면 개발자에게 바로 전송됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to send directly to the developer"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mengirim langsung ke pengembang"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると開発者に直接送信されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
