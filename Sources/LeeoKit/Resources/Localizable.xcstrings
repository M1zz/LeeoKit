    "%@를 즐겁게 쓰고 계신가요?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir %@?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you enjoying %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te está gustando %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aimez utiliser %@ ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda menikmati %@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti piace usare %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を楽しくお使いいただけていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 즐겁게 쓰고 계신가요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está gostando do %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам нравится %@?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณชอบใช้ %@ ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thích dùng %@ không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 用得还开心吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 用得還開心嗎？"
          }
        }
      }
    },
    "5분이 비었는데 무엇부터 할지 모를 때": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn fünf Minuten frei werden und du nicht weißt, womit du anfangen sollst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When five minutes open up and you cannot decide what to start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se abren cinco minutos y no sabes por dónde empezar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cinq minutes se libèrent et que vous ne savez pas par quoi commencer"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ada lima menit kosong tetapi bingung mulai dari mana"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si liberano cinque minuti e non sai da cosa cominciare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分空いたのに、何から始めるか決められないとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분이 비었는데 무엇부터 할지 모를 때"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando surgem cinco minutos livres e você não sabe por onde começar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда освободились пять минут, а с чего начать, непонятно"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีเวลาว่าง 5 นาทีแต่ไม่รู้จะเริ่มอะไรก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có năm phút rảnh mà không biết bắt đầu từ đâu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空出五分钟，却不知道先做什么时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空出五分鐘，卻不知道先做什麼時"
          }
        }
      }
    },
