    "흰 화면이어도 괜찮아요. 옆 버튼과 볼륨 올리기 버튼을 함께 누르면 찍혀요.": {
      "comment": "Attachment how-to: screen before crash",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevadí, když je obrazovka bílá. Snímek obrazovky pořídíte současným stisknutím bočního tlačítka a tlačítka pro zvýšení hlasitosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er fint, selvom skærmen er hvid. Tryk på sideknappen og knappen Lydstyrke op samtidig for at tage et skærmbillede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch ein weißer Bildschirm hilft. Drücke gleichzeitig die Seitentaste und die Lauter-Taste, um ein Bildschirmfoto zu machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν πειράζει αν η οθόνη είναι λευκή. Για στιγμιότυπο οθόνης, πατήστε ταυτόχρονα το πλαϊνό κουμπί και το κουμπί αύξησης έντασης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even a blank white screen helps. Press the side button and volume up button at the same time to take a screenshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque sea una pantalla en blanco, sirve. Pulsa a la vez el botón lateral y el botón de subir volumen para hacer la captura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valkoinenkin näyttö käy. Ota kuvakaappaus painamalla sivupainiketta ja äänenvoimakkuuden lisäyspainiketta yhtä aikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même un écran blanc est utile. Appuyez en même temps sur le bouton latéral et le bouton d'augmentation du volume pour faire une capture."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar putih pun tidak apa-apa. Untuk mengambil gambar layar, tekan tombol samping dan tombol volume naik bersamaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene anche una schermata bianca. Premi insieme il tasto laterale e il tasto per alzare il volume per fare uno screenshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白い画面でも大丈夫です。サイドボタンと音量を上げるボタンを同時に押すと撮れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰 화면이어도 괜찮아요. 옆 버튼과 볼륨 올리기 버튼을 함께 누르면 찍혀요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går fint selv om skjermen er hvit. Trykk på sideknappen og volum opp-knappen samtidig for å ta et skjermbilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook een wit scherm is prima. Druk tegelijk op de zijknop en de volume-omhoogknop om een schermafbeelding te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet jeśli ekran jest biały, to nic. Aby zrobić zrzut ekranu, naciśnij jednocześnie przycisk boczny i przycisk zwiększania głośności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser até uma tela branca. Pressione o botão lateral e o botão de aumentar volume ao mesmo tempo para capturar a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже если экран белый, это нормально. Чтобы сделать снимок экрана, одновременно нажмите боковую кнопку и кнопку увеличения громкости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går bra även om skärmen är vit. Tryck på sidoknappen och volym upp-knappen samtidigt för att ta en skärmavbild."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้จะเป็นหน้าจอขาวก็ไม่เป็นไร กดปุ่มด้านข้างพร้อมกับปุ่มเพิ่มเสียงเพื่อถ่ายภาพหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran beyaz olsa da olur. Ekran görüntüsü almak için yan düğmeye ve sesi açma düğmesine aynı anda basın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình trắng cũng không sao. Nhấn đồng thời nút sườn và nút tăng âm lượng để chụp màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白屏也没关系。同时按下侧边按钮和调高音量按钮即可截屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白畫面也沒關係。同時按下側邊按鈕和調高音量按鈕即可截圖。"
          }
        }
      }
    },
