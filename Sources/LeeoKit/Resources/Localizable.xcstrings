    "평생을 사도 구독은 저절로 멈추지 않아요. 산 뒤 구독 관리에서 해지해 주세요. 남은 기간은 그대로 써요.": {
      "comment": "Graduation offer: the subscription must be cancelled by the user",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup doživotní verze předplatné sám nezruší. Po nákupu ho zrušte ve správě předplatného. Zbývající období vám zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Livstid stopper ikke dit abonnement af sig selv. Opsig det under abonnementer, når du har købt. Den resterende tid kan du stadig bruge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebenslang beendet dein Abo nicht von selbst. Kündige es nach dem Kauf in der Abo-Verwaltung. Die restliche Laufzeit bleibt dir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά εφ’ όρου ζωής δεν σταματά αυτόματα τη συνδρομή. Μετά την αγορά, ακυρώστε τη από τη διαχείριση συνδρομών. Ο υπόλοιπος χρόνος παραμένει δικός σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buying Lifetime won’t stop your subscription on its own. Cancel it in subscription management after buying. You keep the time you have left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar de por vida no cancela tu suscripción automáticamente. Después de comprar, cancélala en la gestión de suscripciones. Conservas el tiempo que te queda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinikäisen osto ei lopeta tilausta itsestään. Peru tilaus oston jälkeen tilausten hallinnasta. Jäljellä oleva aika säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat à vie n’arrête pas votre abonnement tout seul. Après l’achat, résiliez-le dans la gestion des abonnements. Vous gardez le temps restant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membeli Seumur Hidup tidak menghentikan langganan secara otomatis. Setelah membeli, batalkan di pengelolaan langganan. Sisa masa langganan tetap bisa dipakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprare a vita non ferma l’abbonamento da solo. Dopo l’acquisto, annullalo nella gestione abbonamenti. Il periodo rimanente resta tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りを買ってもサブスクは自動で止まりません。購入後、サブスクリプションの管理から解約してください。残りの期間はそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생을 사도 구독은 저절로 멈추지 않아요. 산 뒤 구독 관리에서 해지해 주세요. 남은 기간은 그대로 써요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Livstid stopper ikke abonnementet av seg selv. Si det opp under abonnementer etter kjøpet. Gjenværende tid kan du fortsatt bruke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levenslang kopen stopt je abonnement niet vanzelf. Zeg het na de aankoop op via abonnementsbeheer. De resterende tijd houd je gewoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup dostępu dożywotniego nie zatrzyma subskrypcji sam. Po zakupie anuluj ją w zarządzaniu subskrypcjami. Pozostały okres nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar o vitalício não cancela a assinatura sozinho. Depois da compra, cancele em gerenciar assinaturas. Você continua usando o tempo restante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка навсегда не отменяет подписку сама. После покупки отмените её в управлении подписками. Оставшийся срок сохранится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livstid stoppar inte prenumerationen av sig själv. Avsluta den under prenumerationer efter köpet. Återstående tid får du behålla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อแบบตลอดชีพไม่ได้หยุดการสมัครสมาชิกให้อัตโนมัติ หลังซื้อแล้วโปรดยกเลิกในการจัดการการสมัครสมาชิก ระยะเวลาที่เหลือยังใช้ได้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ömür boyu satın almak aboneliği kendiliğinden durdurmaz. Satın aldıktan sonra abonelik yönetiminden iptal edin. Kalan süreyi kullanmaya devam edersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua trọn đời không tự dừng gói đăng ký. Sau khi mua, hãy hủy trong phần quản lý đăng ký. Thời gian còn lại vẫn dùng bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买永久版不会自动停止订阅。购买后请在订阅管理中取消。剩余的订阅期仍可照常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買永久版不會自動停止訂閱。購買後請到訂閱管理取消。剩下的訂閱期間仍可照常使用。"
          }
        }
      }
    },
    "폰과 맥을 오가며 같은 문장을 쓰는 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří používají stejné řádky v telefonu i na Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der bruger de samme linjer på iPhone og Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die dieselben Zeilen auf iPhone und Mac verwenden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι χρησιμοποιούν τις ίδιες φράσεις σε τηλέφωνο και Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who use the same lines across phone and Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien usa las mismas frases en el teléfono y en el Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka käyttävät samoja rivejä iPhonella ja Macilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui utilisent les mêmes phrases sur le téléphone et le Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang memakai kalimat yang sama di ponsel dan di Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi usa le stesse frasi tra telefono e Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとMacを行き来しながら同じ文章を使う人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰과 맥을 오가며 같은 문장을 쓰는 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som bruker de samme tekstene på både iPhone og Mac"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die dezelfde zinnen op iPhone en Mac gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które używają tych samych zdań w telefonie i na Macu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem usa as mesmas frases no celular e no Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто пользуется одними фразами и на телефоне, и на Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som använder samma rader på både iPhone och Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ใช้ประโยคเดียวกันทั้งบนโทรศัพท์และ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı satırları iPhone'da ve Mac'te kullananlar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng cùng những câu trên cả điện thoại và Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机和 Mac 之间来回、用同一批句子的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機和 Mac 之間來回、用同一批句子的人"
          }
        }
      }
    },
    "폰에서 모은 것을 맥에서 쓰고, 폰에서 쪼갠 것을 맥에서 짭니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste nasbírali v telefonu, použijete na Macu, a co jste rozložili v telefonu, naplánujete na Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du samlede på iPhone, bruger du på Mac'en, og det, du delte op på iPhone, planlægger du på Mac'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf dem iPhone gesammelt hast, nutzt du auf dem Mac, und was du auf dem iPhone zerlegt hast, planst du auf dem Mac ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι μαζέψατε στο iPhone το χρησιμοποιείτε στο Mac, και ό,τι χωρίσατε στο iPhone το τοποθετείτε στο Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you gathered on the phone gets used on the Mac, and what you split on the phone gets laid out on the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que reuniste en el teléfono se usa en el Mac, y lo que dividiste en el teléfono se organiza en el Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonella kerätty käytetään Macilla, ja iPhonella pilkottu aikataulutetaan Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez rassemblé sur le téléphone sert sur le Mac, et ce que vous avez découpé sur le téléphone s’organise sur le Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dikumpulkan di ponsel dipakai di Mac, yang dipecah di ponsel ditata di Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che raccogli sul telefono lo usi sul Mac, e quello che suddividi sul telefono lo organizzi sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでためたものをMacで使い、iPhoneで分けたものをMacで組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 모은 것을 맥에서 쓰고, 폰에서 쪼갠 것을 맥에서 짭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du samlet på iPhone, bruker du på Macen, og det du delte opp på iPhone, planlegger du på Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je op je iPhone hebt verzameld, gebruik je op de Mac, en wat je op je iPhone hebt opgedeeld, plan je op de Mac in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co zebrałeś w telefonie, wykorzystujesz na Macu, a to, co podzieliłeś w telefonie, rozkładasz na Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você juntou no celular é usado no Mac, e o que você dividiu no celular é organizado no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собранное на телефоне идёт в дело на Mac, а разбитое на телефоне раскладывается на Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du samlat på iPhone används på Macen, och det du delat upp på iPhone planeras på Macen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่เก็บบนโทรศัพท์นำไปใช้บน Mac และสิ่งที่แบ่งบนโทรศัพท์นำไปจัดบน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da topladıklarınızı Mac'te kullanır, iPhone'da böldüklerinizi Mac'te planlarsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì gom trên điện thoại được dùng trên Mac, những gì chia trên điện thoại được sắp xếp trên Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上攒的在 Mac 上用，手机上拆的在 Mac 上排。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上攢的在 Mac 上用，手機上拆的在 Mac 上排。"
          }
        }
      }
    },
    "폰에서 저장한 것이 그대로 있으니 다시 옮겨 적을 일이 없습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste uložili v telefonu, už tam je, takže nic nemusíte psát dvakrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du har gemt på iPhone, er der allerede, så du skal ikke skrive noget to gange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf dem iPhone gespeichert hast, ist schon da, also musst du nichts zweimal tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι αποθηκεύσατε στο iPhone είναι ήδη εκεί, οπότε δεν χρειάζεται να ξαναγράψετε τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you saved on the phone is already there, so nothing has to be typed twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que guardaste en el teléfono ya está ahí, así que no hay que escribir nada dos veces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonella tallentamasi on jo valmiina, joten mitään ei tarvitse kirjoittaa kahdesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez enregistré sur le téléphone est déjà là : rien à retaper."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang tersimpan di ponsel sudah ada di sana, jadi tak perlu disalin ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che hai salvato sul telefono è già lì, quindi non devi riscrivere nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで保存したものがそのままあるので、書き写す手間がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 저장한 것이 그대로 있으니 다시 옮겨 적을 일이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du lagret på iPhone, er der allerede, så ingenting må skrives to ganger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je op je iPhone hebt bewaard, staat er al, dus je hoeft niets twee keer te typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co zapisałeś w telefonie, już tam jest, więc nic nie trzeba przepisywać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você salvou no celular já está lá, então nada precisa ser digitado duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённое на телефоне уже здесь, переписывать заново нечего."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du sparat på iPhone finns redan där, så inget behöver skrivas två gånger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่บันทึกบนโทรศัพท์อยู่ครบ จึงไม่ต้องพิมพ์ซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da kaydettikleriniz zaten orada; hiçbir şeyi iki kez yazmanız gerekmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì đã lưu trên điện thoại vẫn còn nguyên, nên không phải chép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上存的东西原样都在，不必再抄一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上存的東西原樣都在，不必再抄一遍。"
          }
        }
      }
    },
    "폰에서 쪼개고 맥에서 짠다": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozložte v telefonu, naplánujte na Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del op på iPhone, planlæg på Mac'en"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone zerlegen, auf dem Mac einplanen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίστε στο iPhone, οργανώστε στο Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split on the phone, lay it out on the Mac"
