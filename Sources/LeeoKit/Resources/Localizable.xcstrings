          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha recibido ningún comentario"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautetta ei ole vielä tullut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun commentaire reçu pour l’instant"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada masukan yang diterima"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun feedback ricevuto per ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ受信したフィードバックはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 접수된 피드백이 없어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilbakemeldinger mottatt ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen feedback ontvangen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze żadnych opinii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum feedback recebido ainda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзывов пока нет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen feedback har kommit in än"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีความคิดเห็นเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz geri bildirim alınmadı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa nhận được góp ý nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有收到反馈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有收到意見回饋"
          }
        }
      }
    },
    "알림 권한이 꺼져 있어요. iOS 설정 > %@ > 알림에서 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou vypnutá. Povolte je v Nastavení iOS > %@ > Oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra. Tillad dem i iOS-indstillinger > %@ > Notifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind ausgeschaltet. Bitte erlaube sie in den iOS-Einstellungen > %@ > Mitteilungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις είναι απενεργοποιημένες. Επιτρέψτε τις στις Ρυθμίσεις iOS > %@ > Ειδοποιήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off. Please allow them in iOS Settings > %@ > Notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permítelas en Ajustes de iOS > %@ > Notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset on laitettu pois päältä. Salli ne kohdassa iOS:n Asetukset > %@ > Ilmoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorisez-les dans Réglages iOS > %@ > Notifications."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dinonaktifkan. Izinkan di Pengaturan iOS > %@ > Notifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Consentile in Impostazioni di iOS > %@ > Notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっています。iOSの設定 > %@ > 通知で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 꺼져 있어요. iOS 설정 > %@ > 알림에서 허용해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslinger er slått av. Tillat dem i iOS-innstillinger > %@ > Varslinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit. Sta ze toe in de iOS-instellingen > %@ > Berichtgeving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Zezwól na nie w Ustawieniach iOS > %@ > Powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Permita em Ajustes do iOS > %@ > Notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены. Разрешите их в Настройках iOS > %@ > Уведомления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är avstängda. Tillåt dem i iOS Inställningar > %@ > Notiser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดอยู่ โปรดอนุญาตใน การตั้งค่า iOS > %@ > การแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı. Lütfen iOS Ayarlar > %@ > Bildirimler bölümünden izin verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt. Hãy cho phép trong Cài đặt iOS > %@ > Thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知权限没打开。请在“iOS 设置 > %@ > 通知”里允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知權限沒開啟。請在「iOS 設定 > %@ > 通知」裡允許。"
          }
        }
      }
    },
