    "발표나 시험처럼 남은 시간을 배분해야 할 때": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die verbleibende Zeit einteilen musst, etwa bei einem Vortrag oder einer Prüfung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you have to budget the time left, like a talk or an exam"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tienes que repartir el tiempo que queda, como en una charla o un examen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous devez répartir le temps restant, comme pour un exposé ou un examen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat harus membagi sisa waktu, seperti presentasi atau ujian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando devi distribuire il tempo rimasto, come in una presentazione o un esame"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発表や試験のように、残り時間を配分するとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발표나 시험처럼 남은 시간을 배분해야 할 때"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você precisa distribuir o tempo que resta, como numa apresentação ou numa prova"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда нужно распределить оставшееся время: доклад, экзамен"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องแบ่งเวลาที่เหลือ เช่น การนำเสนอหรือการสอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi phải chia thời gian còn lại, như buổi thuyết trình hay kỳ thi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演讲或考试这类需要分配剩余时间的场合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "演講或考試這類需要分配剩餘時間的場合"
          }
        }
      }
    },
