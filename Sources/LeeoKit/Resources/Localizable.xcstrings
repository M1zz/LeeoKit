    "예) 적던 것이 그대로 남아 있어야 해요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. Rozepsaný text tam měl zůstat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fx: Det, jeg skrev, burde stadig være der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Mein Text hätte noch da sein sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Ό,τι έγραψα θα έπρεπε να είναι ακόμη εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. What I typed should still be there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P. ej.: Lo que escribí debería seguir ahí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. kirjoittamani tekstin pitäisi olla yhä tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : ce que j’avais tapé devrait toujours être là."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. Yang saya ketik seharusnya tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Quello che avevo scritto dovrebbe essere ancora lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）入力した内容がそのまま残っているべきです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 적던 것이 그대로 남아 있어야 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Det jeg skrev, skulle fortsatt vært der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. Wat ik typte, had er nog moeten staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. wpisany tekst powinien zostać na miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: O que eu digitei deveria continuar lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: введённое должно было сохраниться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. Det jag skrev borde finnas kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น สิ่งที่พิมพ์ไว้ควรยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. Yazdıklarım hâlâ orada olmalıydı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví dụ: Nội dung đang gõ lẽ ra vẫn còn đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例）刚输入的内容应该还在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例）剛輸入的內容應該還在。"
          }
        }
      }
    },
