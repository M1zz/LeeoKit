            "value": "Hvad føltes besværligt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was war umständlich?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι σας δυσκόλεψε;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What felt inconvenient?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te resultó incómodo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tuntui hankalalta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’est-ce qui vous a gêné ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang terasa kurang nyaman?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti è sembrato scomodo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこが不便でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 점이 불편하셨나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva føltes tungvint?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat vond je onhandig?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co było niewygodne?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que foi incômodo?"
          }
        },
        "ru": {
