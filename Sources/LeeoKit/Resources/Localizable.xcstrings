    "평생 가격이 %@부터 올라요. 이미 산 분은 그대로 써요.": {
      "comment": "Pricing ladder: lifetime price increase notice. %@ = date",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena doživotní verze se od %@ zvýší. Kdo už koupil, tomu se nic nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på livstid stiger fra %@. Har du allerede købt, ændres intet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab %@ steigt der Preis für Lebenslang. Wer schon gekauft hat, für den ändert sich nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τιμή εφ’ όρου ζωής αυξάνεται από %@. Αν έχετε ήδη αγοράσει, δεν αλλάζει τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lifetime price goes up on %@. If you already bought it, nothing changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio de por vida sube a partir del %@. Si ya lo compraste, no cambia nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinikäisen hinta nousee %@ alkaen. Jos olet jo ostanut, mikään ei muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix à vie augmente à partir du %@. Si vous l’avez déjà acheté, rien ne change."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga Seumur Hidup naik mulai %@. Yang sudah membeli tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo a vita aumenta dal %@. Se l’hai già comprato, non cambia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から買い切りの価格が上がります。購入済みの方はそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 가격이 %@부터 올라요. 이미 산 분은 그대로 써요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisen på livstid øker fra %@. Har du allerede kjøpt, endres ingenting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prijs van levenslang stijgt vanaf %@. Heb je al gekocht, dan verandert er niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena dostępu dożywotniego wzrośnie od %@. Kto już kupił, nic się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço do vitalício sobe a partir de %@. Quem já comprou continua igual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С %@ цена покупки навсегда вырастет. Если вы уже купили, ничего не изменится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priset för livstid höjs från %@. Har du redan köpt ändras ingenting."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาแบบตลอดชีพจะขึ้นตั้งแต่ %@ ผู้ที่ซื้อแล้วใช้ต่อได้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ömür boyu fiyatı %@ itibarıyla artıyor. Zaten satın aldıysanız hiçbir şey değişmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trọn đời sẽ tăng từ %@. Ai đã mua thì vẫn dùng như cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久版价格将于 %@ 起上涨。已购买的用户不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久版價格將於 %@ 起調漲。已購買的使用者不受影響。"
          }
        }
      }
    },
