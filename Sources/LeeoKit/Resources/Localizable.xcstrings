    "덩어리로 해야 하는 일에 시간을 떼어 둔 날.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den s vyhrazeným časem na práci, která jde udělat jen v jednom kuse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag med tid sat af til arbejde, der kun bliver til noget i én blok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag mit Zeit, die für Arbeit reserviert ist, die nur am Stück gelingt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μέρα με χρόνο δεσμευμένο για δουλειά που γίνεται μόνο μονοκόμματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day with time set aside for work that only happens in one block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día con tiempo reservado para un trabajo que solo sale de un tirón."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivä, jona olet varannut aikaa työlle, joka onnistuu vain yhtenä kokonaisuutena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée avec du temps réservé pour un travail qui ne se fait qu’en un seul bloc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari saat waktu disisihkan untuk pekerjaan yang harus utuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una giornata con del tempo riservato a un lavoro che si fa solo in un unico blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとまった時間が要る仕事のために、時間を空けておいた日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덩어리로 해야 하는 일에 시간을 떼어 둔 날."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag med tid satt av til arbeid som bare blir gjort i én sammenhengende økt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag met tijd vrijgehouden voor werk dat alleen in één blok lukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień z czasem zarezerwowanym na pracę, którą da się zrobić tylko w jednym bloku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia com tempo reservado para um trabalho que só sai em um bloco só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, где время отложено под работу, которая идёт только целым куском."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag med tid avsatt för arbete som bara blir gjort i ett svep."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่กันเวลาไว้สำหรับงานที่ต้องทำต่อเนื่องเป็นก้อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancak tek parça hâlinde yapılabilecek işlere zaman ayırdığınız bir gün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày dành riêng thời gian cho việc chỉ làm được trong một khối liền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为需要整块时间的事留出时间的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為需要整塊時間的事留出時間的一天。"
          }
        }
      }
    },
