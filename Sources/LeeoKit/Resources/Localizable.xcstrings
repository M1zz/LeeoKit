    "쪼개는 곳과 앉히는 곳이 달라도 목록은 하나입니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozkládáte jinde, než plánujete, ale seznam je jen jeden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der, hvor du deler op, og der, hvor du planlægger, er forskellige, men listen er den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo du zerlegst und wo du einplanst, ist verschieden, aber die Liste ist eine."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλού χωρίζετε και αλλού τοποθετείτε, αλλά η λίστα είναι μία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The place you split and the place you lay out differ, but the list is one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sitio donde divides y el sitio donde organizas son distintos, pero la lista es una sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilkot yhdessä paikassa ja aikataulutat toisessa, mutta lista on yksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endroit où vous découpez et celui où vous organisez diffèrent, mais la liste est la même."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat memecah dan tempat menata berbeda, tetapi daftarnya satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il posto dove suddividi e quello dove organizzi sono diversi, ma l’elenco è uno solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分ける場所と置く場所が違っても、リストはひとつです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쪼개는 곳과 앉히는 곳이 달라도 목록은 하나입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du deler opp ett sted og planlegger et annet, men listen er den samme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar je opdeelt en waar je inplant verschilt, maar de lijst is één en dezelfde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie indziej dzielisz, gdzie indziej planujesz, ale lista jest jedna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lugar onde você divide e o lugar onde você organiza são diferentes, mas a lista é uma só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место, где разбиваешь, и место, где раскладываешь, разные, а список один."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stället där du delar upp och stället där du planerar är olika, men listan är en och samma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้จะแบ่งงานกับวางงานคนละที่ แต่รายการมีเพียงหนึ่งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böldüğünüz yer ile yerleştirdiğiniz yer farklı, ama liste tek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi chia việc và nơi sắp xếp khác nhau, nhưng danh sách chỉ có một."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆的地方和排的地方不同，清单却只有一份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拆的地方和排的地方不同，清單卻只有一份。"
          }
        }
      }
    },
    "책상에 앉으면 맥에서 그 단계들을 요일과 시간대에 앉힙니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U stolu Mac rozvrhne tyto kroky do dnů a hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved skrivebordet lægger Mac'en de trin ud på dage og tidspunkter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Schreibtisch verteilt der Mac diese Schritte auf Tage und Uhrzeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο γραφείο, το Mac τοποθετεί αυτά τα βήματα σε μέρες και ώρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the desk, the Mac seats those steps into days and hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el escritorio, el Mac coloca esos pasos en días y horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työpöydän ääressä Mac asettaa vaiheet päiville ja kellonajoille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au bureau, le Mac place ces étapes dans les jours et les créneaux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Begitu duduk di meja, Mac mendudukkan langkah-langkah itu ke hari dan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla scrivania, il Mac sistema quei passaggi nei giorni e nelle ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "机に着いたら、Macでその段階を曜日と時間帯に置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책상에 앉으면 맥에서 그 단계들을 요일과 시간대에 앉힙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved skrivebordet fordeler Macen disse trinnene på dager og klokkeslett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan je bureau verdeelt de Mac die stappen over dagen en tijdstippen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy biurku Mac rozkłada te kroki na dni i godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesa, o Mac encaixa esses passos em dias e horários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За столом Mac рассаживает эти шаги по дням и часам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid skrivbordet lägger du in stegen på dagar och tider på Macen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อนั่งที่โต๊ะ จัดขั้นตอนเหล่านั้นลงวันและช่วงเวลาบน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaya oturduğunuzda Mac bu adımları günlere ve saatlere yerleştirir."
          }
        },
        "vi": {
          "stringUnit": {
