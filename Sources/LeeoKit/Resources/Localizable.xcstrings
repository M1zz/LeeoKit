            "state": "translated",
            "value": "O sırada ne yapıyordunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc đó bạn đang làm gì?"
          }
        },
        "zh-Hans": {
