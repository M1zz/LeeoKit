    "복사한 계좌번호와 주소는 클립키보드가 갈래를 나눠 쌓아 둡니다. 다시 찾아 헤맬 일이 없습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard roztřídí a uschová čísla účtů a adresy, které jste zkopírovali. Už je nemusíte hledat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard sorterer og gemmer de kontonumre og adresser, du har kopieret. Slut med at lede efter dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard sortiert und bewahrt die Kontonummern und Adressen auf, die du kopiert hast. Kein Suchen mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ClipKeyboard ταξινομεί και κρατά τους αριθμούς λογαριασμού και τις διευθύνσεις που αντιγράψατε. Τέλος το ψάξιμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard sorts and keeps the account numbers and addresses you copied. No more hunting for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard clasifica y guarda los números de cuenta y las direcciones que copiaste. Se acabó buscarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard lajittelee ja säilyttää kopioimasi tilinumerot ja osoitteet. Etsiminen jää pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard trie et conserve les numéros de compte et adresses que vous avez copiés. Fini de les chercher."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor rekening dan alamat yang Anda salin dipilah dan disimpan ClipKeyboard. Tak perlu mencari lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard ordina e conserva i numeri di conto e gli indirizzi che hai copiato. Non dovrai più andarli a cercare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした口座番号や住所は、ClipKeyboardが種類ごとに整理して残します。もう探し回りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 계좌번호와 주소는 클립키보드가 갈래를 나눠 쌓아 둡니다. 다시 찾아 헤맬 일이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard sorterer og tar vare på kontonumrene og adressene du har kopiert. Slutt på leting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard sorteert en bewaart de rekeningnummers en adressen die je hebt gekopieerd. Nooit meer zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard porządkuje i przechowuje skopiowane numery kont i adresy. Koniec z ich szukaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ClipKeyboard organiza e guarda os números de conta e endereços que você copiou. Nada de ficar procurando de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные номера счетов и адреса ClipKeyboard раскладывает по видам и хранит. Искать больше не нужно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard sorterar och sparar kontonumren och adresserna du har kopierat. Du behöver aldrig leta efter dem igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard จัดหมวดหมู่และเก็บเลขบัญชีกับที่อยู่ที่คุณคัดลอกไว้ ไม่ต้องค้นหาอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard kopyaladığınız hesap numaralarını ve adresleri sınıflandırıp saklar. Artık aramak yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipKeyboard phân loại và giữ lại số tài khoản và địa chỉ bạn đã sao chép. Không phải đi tìm lại nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制过的账号和地址，剪贴键盘会分好类留着。不用再翻找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製過的帳號和地址，剪貼鍵盤會分好類留著。不用再翻找。"
          }
        }
      }
    },
    "복사해 둔 것을 조금 뒤에 다시 찾아야 할 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když potřebujete něco, co jste před chvílí zkopírovali"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skal bruge noget, du kopierede for et øjeblik siden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du etwas brauchst, das du gerade eben kopiert hast"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χρειάζεστε κάτι που αντιγράψατε πριν από λίγο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need something you copied a moment ago"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando necesitas algo que copiaste hace un momento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tarvitset jotain, minkä kopioit hetki sitten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous avez besoin de quelque chose copié il y a un instant"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda perlu lagi sesuatu yang baru saja disalin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti serve qualcosa che hai copiato poco fa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し前にコピーしたものを、もう一度使いたいとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사해 둔 것을 조금 뒤에 다시 찾아야 할 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du trenger noe du kopierte for litt siden"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iets nodig hebt dat je net hebt gekopieerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy potrzebujesz czegoś, co skopiowałeś przed chwilą"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você precisa de algo que copiou há pouco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда нужно то, что вы скопировали чуть раньше"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du behöver något du kopierade nyss"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องหาสิ่งที่เพิ่งคัดลอกไว้เมื่อครู่"
          }
        },
        "tr": {
