          "stringUnit": {
            "state": "translated",
            "value": "Spolu lépe než samostatně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedre sammen end hver for sig"
          }
        },
        "de": {
