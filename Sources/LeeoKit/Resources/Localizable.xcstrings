    "결제를 확인하지 못했어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platbu se nepodařilo ověřit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen kunne ikke bekræftes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung konnte nicht bestätigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση της πληρωμής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify the payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el pago."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksua ei voitu vahvistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier le paiement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran tidak dapat diverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare il pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いを確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제를 확인하지 못했어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bekrefte betalingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling kon niet worden geverifieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить платёж."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalningen kunde inte verifieras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันการชำระเงินได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme doğrulanamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh khoản thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证这笔付款。"
          }
        },
