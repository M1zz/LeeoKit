    "판매 중인 상품을 찾지 못했어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentálně nejsou k dispozici žádné produkty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen produkter tilgængelige lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit sind keine Produkte verfügbar."
