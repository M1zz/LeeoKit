    "사진 %d장을 붙이셨는데 이 경로로는 함께 보낼 수 없어요. 메일에 직접 첨부해 주세요.": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Přiložili jste %d fotky, ale touto cestou je nelze odeslat. Přiložte je prosím přímo v poštovní aplikaci."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Přiložili jste %d fotky, ale touto cestou je nelze odeslat. Přiložte je prosím přímo v poštovní aplikaci."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Přiložili jste %d fotku, ale touto cestou ji nelze odeslat. Přiložte ji prosím přímo v poštovní aplikaci."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Přiložili jste %d fotek, ale touto cestou je nelze odeslat. Přiložte je prosím přímo v poštovní aplikaci."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Du har vedhæftet %d foto, men det kan ikke sendes med på denne måde. Vedhæft det direkte i mailappen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Du har vedhæftet %d fotos, men de kan ikke sendes med på denne måde. Vedhæft dem direkte i mailappen."
                }
              }
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %d Foto(s) angehängt, aber auf diesem Weg können sie nicht mitgeschickt werden. Bitte hänge sie direkt in der Mail-App an."
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Επισυνάψατε %d φωτογραφία, αλλά δεν μπορεί να σταλεί με αυτόν τον τρόπο. Επισυνάψτε τη απευθείας στην εφαρμογή Mail."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Επισυνάψατε %d φωτογραφίες, αλλά δεν μπορούν να σταλούν με αυτόν τον τρόπο. Επισυνάψτε τες απευθείας στην εφαρμογή Mail."
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You attached %d photo(s), but this path cannot send them. Please attach them in the mail app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has adjuntado %d foto(s), pero por esta vía no se pueden enviar. Adjúntalas en la app de correo."
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Liitit %d kuvan, mutta sitä ei voi lähettää tätä kautta. Liitä se suoraan Mail-apissa."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Liitit %d kuvaa, mutta niitä ei voi lähettää tätä kautta. Liitä ne suoraan Mail-apissa."
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez joint %d photo(s), mais elles ne peuvent pas être envoyées par ce moyen. Joignez-les directement dans l’app Mail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda melampirkan %d foto, tetapi cara ini tidak dapat mengirimnya. Lampirkan langsung di aplikasi email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai allegato %d foto, ma da qui non è possibile inviarle. Allegale direttamente nell’app Mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真%d枚を添付されましたが、この経路では送れません。メールに直接添付してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %d장을 붙이셨는데 이 경로로는 함께 보낼 수 없어요. 메일에 직접 첨부해 주세요."
