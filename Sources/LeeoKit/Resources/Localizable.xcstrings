          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenas em que o app que você está usando aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцены, в которых появляется приложение, которым вы пользуетесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉากที่แอปที่คุณกำลังใช้ปรากฏอยู่"
          }
        },
        "vi": {
