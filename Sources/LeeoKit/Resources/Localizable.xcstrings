    "메일과 문서 작업이 맥에서 끝나는 사람": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People whose mail and documents live on the Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang pekerjaan surel dan dokumennya selesai di Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールや書類の作業がMacで完結する人"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, у кого почта и документы живут на Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件和文档工作都在 Mac 上完成的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "郵件和文檔工作都在 Mac 上完成的人"
          }
        }
      }
    },
    "메일과 문서에 들어갈 문장은 메뉴바의 클립키보드에서 단축키로 꺼냅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lines for mail and documents come out of ClipKeyboard in the menu bar, by hotkey."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat untuk surel dan dokumen diambil lewat pintasan dari ClipKeyboard di bilah menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールや書類に入れる文章は、メニューバーのClipKeyboardからショートカットで取り出します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразы для писем и документов достаются по сочетанию клавиш из ClipKeyboard в строке меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件和文档里要用的句子，从菜单栏的剪贴键盘用快捷键取出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "郵件和文檔裡要用的句子，從菜單欄的剪貼鍵盤用快速鍵取出。"
          }
        }
      }
    },
    "무엇을 하는 앱인가": {
      "localizations": {
