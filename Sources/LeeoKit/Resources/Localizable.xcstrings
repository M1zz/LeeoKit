    "사진 %d장을 붙이셨는데 이 경로로는 함께 보낼 수 없어요. 메일에 직접 첨부해 주세요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %d Foto(s) angehängt, aber auf diesem Weg können sie nicht mitgeschickt werden. Bitte hänge sie direkt in der Mail-App an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You attached %d photo(s), but this path cannot send them. Please attach them in the mail app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has adjuntado %d foto(s), pero por esta vía no se pueden enviar. Adjúntalas en la app de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez joint %d photo(s), mais elles ne peuvent pas être envoyées par ce moyen. Joignez-les directement dans l’app Mail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You attached %d photo(s), but this path cannot send them. Please attach them in the mail app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai allegato %d foto, ma da qui non è possibile inviarle. Allegale direttamente nell’app Mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真%d枚を添付されましたが、この経路では送れません。メールに直接添付してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %d장을 붙이셨는데 이 경로로는 함께 보낼 수 없어요. 메일에 직접 첨부해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você anexou %d foto(s), mas por este caminho não é possível enviá-las. Anexe-as no app de e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы прикрепили %d фото, но этим способом их не отправить. Приложите их в почте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแนบรูป %d รูป แต่ช่องทางนี้ส่งรูปไปด้วยไม่ได้ โปรดแนบในแอปเมลเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đính kèm %d ảnh nhưng cách gửi này không gửi kèm được. Hãy đính kèm trực tiếp trong ứng dụng mail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你添加了%d张图片，但这个方式无法一起发送。请在邮件中直接附加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你新增了%d張圖片，但這個方式無法一起傳送。請在郵件中直接附加。"
          }
        }
      }
    },
