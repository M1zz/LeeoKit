    "불편하신 점이나 제안 사항을 자유롭게 적어주세요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidně popište svůj problém nebo návrh"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv gerne dit problem eller dit forslag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreib gern dein Problem oder deinen Vorschlag"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιγράψτε ελεύθερα το πρόβλημα ή την πρότασή σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel free to describe your issue or suggestion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos con libertad tu problema o sugerencia"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro vapaasti ongelmastasi tai ehdotuksestasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez librement votre problème ou votre suggestion"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan jelaskan kendala atau saran Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi liberamente il problema o il tuo suggerimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不便な点やご提案を自由にお書きください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불편하신 점이나 제안 사항을 자유롭게 적어주세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv gjerne problemet eller forslaget ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf gerust je probleem of suggestie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz swobodnie problem albo propozycję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique à vontade para descrever o problema ou a sugestão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите, что вам неудобно, или поделитесь предложением"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv gärna ditt problem eller ditt förslag"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่าปัญหาหรือข้อเสนอแนะของคุณได้ตามสบาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorununuzu ya da önerinizi dilediğiniz gibi anlatın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thoải mái mô tả vấn đề hoặc đề xuất của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么不便或建议，都可以写下来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有什麼不便或建議，都可以寫下來"
          }
        }
