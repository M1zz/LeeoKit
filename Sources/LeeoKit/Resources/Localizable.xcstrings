    "탭하면 개발자에게 바로 전송됩니다": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím odešlete přímo vývojáři"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at sende direkte til udvikleren"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um es direkt an den Entwickler zu senden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για αποστολή απευθείας στον προγραμματιστή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to send directly to the developer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para enviarlo directamente al desarrollador"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä suoraan kehittäjälle napauttamalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour envoyer directement au développeur"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mengirim langsung ke pengembang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per inviarlo direttamente allo sviluppatore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると開発者に直接送信されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 개발자에게 바로 전송됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å sende direkte til utvikleren"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om het direct naar de ontwikkelaar te sturen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby wysłać bezpośrednio do dewelopera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para enviar direto ao desenvolvedor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы отправить разработчику напрямую"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att skicka direkt till utvecklaren"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อส่งถึงผู้พัฒนาโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan geliştiriciye göndermek için dokunun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để gửi thẳng cho nhà phát triển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下就直接发给开发者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下就直接發給開發者"
          }
        }
      }
    },
    "폰과 맥을 오가며 같은 문장을 쓰는 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří používají stejné řádky v telefonu i na Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der bruger de samme linjer på iPhone og Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die dieselben Zeilen auf iPhone und Mac verwenden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι χρησιμοποιούν τις ίδιες φράσεις σε τηλέφωνο και Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who use the same lines across phone and Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien usa las mismas frases en el teléfono y en el Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka käyttävät samoja rivejä iPhonella ja Macilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui utilisent les mêmes phrases sur le téléphone et le Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang memakai kalimat yang sama di ponsel dan di Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi usa le stesse frasi tra telefono e Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとMacを行き来しながら同じ文章を使う人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰과 맥을 오가며 같은 문장을 쓰는 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som bruker de samme tekstene på både iPhone og Mac"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die dezelfde zinnen op iPhone en Mac gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które używają tych samych zdań w telefonie i na Macu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem usa as mesmas frases no celular e no Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто пользуется одними фразами и на телефоне, и на Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som använder samma rader på både iPhone och Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ใช้ประโยคเดียวกันทั้งบนโทรศัพท์และ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı satırları iPhone'da ve Mac'te kullananlar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng cùng những câu trên cả điện thoại và Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机和 Mac 之间来回、用同一批句子的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機和 Mac 之間來回、用同一批句子的人"
          }
        }
      }
    },
    "폰에서 모은 것을 맥에서 쓰고, 폰에서 쪼갠 것을 맥에서 짭니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste nasbírali v telefonu, použijete na Macu, a co jste rozložili v telefonu, naplánujete na Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du samlede på iPhone, bruger du på Mac'en, og det, du delte op på iPhone, planlægger du på Mac'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf dem iPhone gesammelt hast, nutzt du auf dem Mac, und was du auf dem iPhone zerlegt hast, planst du auf dem Mac ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι μαζέψατε στο iPhone το χρησιμοποιείτε στο Mac, και ό,τι χωρίσατε στο iPhone το τοποθετείτε στο Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you gathered on the phone gets used on the Mac, and what you split on the phone gets laid out on the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que reuniste en el teléfono se usa en el Mac, y lo que dividiste en el teléfono se organiza en el Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonella kerätty käytetään Macilla, ja iPhonella pilkottu aikataulutetaan Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez rassemblé sur le téléphone sert sur le Mac, et ce que vous avez découpé sur le téléphone s’organise sur le Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dikumpulkan di ponsel dipakai di Mac, yang dipecah di ponsel ditata di Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che raccogli sul telefono lo usi sul Mac, e quello che suddividi sul telefono lo organizzi sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでためたものをMacで使い、iPhoneで分けたものをMacで組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 모은 것을 맥에서 쓰고, 폰에서 쪼갠 것을 맥에서 짭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du samlet på iPhone, bruker du på Macen, og det du delte opp på iPhone, planlegger du på Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je op je iPhone hebt verzameld, gebruik je op de Mac, en wat je op je iPhone hebt opgedeeld, plan je op de Mac in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co zebrałeś w telefonie, wykorzystujesz na Macu, a to, co podzieliłeś w telefonie, rozkładasz na Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você juntou no celular é usado no Mac, e o que você dividiu no celular é organizado no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собранное на телефоне идёт в дело на Mac, а разбитое на телефоне раскладывается на Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du samlat på iPhone används på Macen, och det du delat upp på iPhone planeras på Macen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่เก็บบนโทรศัพท์นำไปใช้บน Mac และสิ่งที่แบ่งบนโทรศัพท์นำไปจัดบน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da topladıklarınızı Mac'te kullanır, iPhone'da böldüklerinizi Mac'te planlarsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì gom trên điện thoại được dùng trên Mac, những gì chia trên điện thoại được sắp xếp trên Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上攒的在 Mac 上用，手机上拆的在 Mac 上排。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上攢的在 Mac 上用，手機上拆的在 Mac 上排。"
          }
        }
      }
    },
    "폰에서 저장한 것이 그대로 있으니 다시 옮겨 적을 일이 없습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste uložili v telefonu, už tam je, takže nic nemusíte psát dvakrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du har gemt på iPhone, er der allerede, så du skal ikke skrive noget to gange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf dem iPhone gespeichert hast, ist schon da, also musst du nichts zweimal tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι αποθηκεύσατε στο iPhone είναι ήδη εκεί, οπότε δεν χρειάζεται να ξαναγράψετε τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you saved on the phone is already there, so nothing has to be typed twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que guardaste en el teléfono ya está ahí, así que no hay que escribir nada dos veces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonella tallentamasi on jo valmiina, joten mitään ei tarvitse kirjoittaa kahdesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez enregistré sur le téléphone est déjà là : rien à retaper."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang tersimpan di ponsel sudah ada di sana, jadi tak perlu disalin ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che hai salvato sul telefono è già lì, quindi non devi riscrivere nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで保存したものがそのままあるので、書き写す手間がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 저장한 것이 그대로 있으니 다시 옮겨 적을 일이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du lagret på iPhone, er der allerede, så ingenting må skrives to ganger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je op je iPhone hebt bewaard, staat er al, dus je hoeft niets twee keer te typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co zapisałeś w telefonie, już tam jest, więc nic nie trzeba przepisywać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você salvou no celular já está lá, então nada precisa ser digitado duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённое на телефоне уже здесь, переписывать заново нечего."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du sparat på iPhone finns redan där, så inget behöver skrivas två gånger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่บันทึกบนโทรศัพท์อยู่ครบ จึงไม่ต้องพิมพ์ซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da kaydettikleriniz zaten orada; hiçbir şeyi iki kez yazmanız gerekmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì đã lưu trên điện thoại vẫn còn nguyên, nên không phải chép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上存的东西原样都在，不必再抄一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上存的東西原樣都在，不必再抄一遍。"
          }
        }
      }
    },
    "폰에서 쪼개고 맥에서 짠다": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozložte v telefonu, naplánujte na Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del op på iPhone, planlæg på Mac'en"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone zerlegen, auf dem Mac einplanen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίστε στο iPhone, οργανώστε στο Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split on the phone, lay it out on the Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide en el teléfono, organiza en el Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilko iPhonella, aikatauluta Macilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découper sur le téléphone, organiser sur le Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pecah di ponsel, tata di Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suddividi sul telefono, organizza sul Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで分けて、Macで組む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 쪼개고 맥에서 짠다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del opp på iPhone, planlegg på Macen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdelen op je iPhone, inplannen op je Mac"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziel w telefonie, planuj na Macu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida no celular, organize no Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбить на телефоне, разложить на Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela upp på iPhone, planera på Macen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบ่งบนโทรศัพท์ จัดบน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da böl, Mac'te planla"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia trên điện thoại, sắp xếp trên Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上拆开，Mac 上排布"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上拆開，Mac 上排布"
          }
        }
      }
    },
    "폰에서 쪼갠 할 일을 큰 화면에서 배치하고 싶은 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří chtějí úkoly rozložené v telefonu uspořádat na velké obrazovce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der vil arrangere de opgaver, de har delt op på iPhone, på en stor skærm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die die auf dem iPhone zerlegten Aufgaben auf einem großen Bildschirm anordnen wollen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι θέλουν να τακτοποιήσουν σε μεγάλη οθόνη τις εργασίες που χώρισαν στο iPhone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who want to arrange, on a big screen, the tasks they split on the phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien quiere ordenar en una pantalla grande las tareas que dividió en el teléfono"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka haluavat järjestellä iPhonella pilkotut tehtävät isolla näytöllä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui veulent organiser sur grand écran les tâches découpées sur le téléphone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang ingin menata di layar besar tugas yang dipecah di ponsel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi vuole disporre su uno schermo grande le attività suddivise sul telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで分けたやることを、大きな画面で配置したい人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 쪼갠 할 일을 큰 화면에서 배치하고 싶은 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som vil ordne oppgavene de delte opp på iPhone, på en stor skjerm"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die de taken die ze op hun iPhone hebben opgedeeld op een groot scherm willen indelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które chcą rozłożyć na dużym ekranie zadania podzielone w telefonie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem quer organizar numa tela grande as tarefas que dividiu no celular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто хочет разложить на большом экране дела, разбитые на телефоне"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som vill ordna uppgifterna som delats upp på iPhone på en stor skärm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่อยากจัดงานที่แบ่งไว้บนโทรศัพท์บนหน้าจอใหญ่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da böldükleri görevleri büyük bir ekranda düzenlemek isteyenler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người muốn sắp xếp trên màn hình lớn những việc đã chia trên điện thoại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想把手机上拆好的待办放到大屏幕上排布的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想把手機上拆好的待辦放到大螢幕上排布的人"
          }
        }
      }
    },
