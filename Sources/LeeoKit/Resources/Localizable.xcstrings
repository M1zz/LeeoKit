    "덩어리로 해야 하는 일에 시간을 떼어 둔 날.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day with time set aside for work that only happens in one block."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari saat waktu disisihkan untuk pekerjaan yang harus utuh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとまった時間が要る仕事のために、時間を空けておいた日。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, где время отложено под работу, которая идёт только целым куском."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为需要整块时间的事留出时间的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為需要整塊時間的事留出時間的一天。"
          }
        }
      }
    },
    "두번알림": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder - Smart alarm"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder - Smart alarm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "두번알림"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "두번알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder 再提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder 再提醒"
          }
        }
      }
    },
    "두번알림으로 한 시간을 재고, 끝나기 10분 전에 마무리 신호를 받습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder times the hour and signals you to wrap up ten minutes before it ends."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder menghitung satu jam dan memberi aba-aba merapikan sepuluh menit sebelum habis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminderで一時間を計り、終わる10分前に仕上げの合図を受け取ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder отмеряет час и за десять минут до конца подаёт знак закругляться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Rereminder 计一个小时，结束前十分钟收到收尾的信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Rereminder 計一個小時，結束前十分鐘收到收尾的信號。"
          }
        }
      }
    },
    "떼어 둔 시간이 조각으로 부서지지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hour you set aside does not break into pieces."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu yang sudah disisihkan tidak pecah menjadi kepingan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空けておいた時間が、細切れに壊れません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложенный час не рассыпается на куски."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留出的时间不会被敲成碎片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留出的時間不會被敲成碎片。"
          }
        }
      }
    },
    "리뷰 남기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a Review"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
