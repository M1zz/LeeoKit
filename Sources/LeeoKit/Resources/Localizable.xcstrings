    "환불된 선물이에요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za tento dárek byly vráceny peníze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaven er blevet refunderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Geschenk wurde erstattet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για αυτό το δώρο έγινε επιστροφή χρημάτων."
