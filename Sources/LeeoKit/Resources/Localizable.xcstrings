    "구독은 아직 켜져 있어요. 구독 관리에서 해지하면 다음 갱신부터 더 내지 않아요.": {
      "comment": "Graduation offer: body after buying, asks to cancel the subscription",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné je stále aktivní. Zrušte ho ve správě předplatného a při dalším obnovení už nezaplatíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit abonnement er stadig aktivt. Opsig det under abonnementer, så betaler du ikke ved næste fornyelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo läuft noch. Kündige es in der Abo-Verwaltung, dann zahlst du ab der nächsten Verlängerung nichts mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνδρομή σας είναι ακόμη ενεργή. Ακυρώστε τη από τη διαχείριση συνδρομών και δεν θα χρεωθείτε στην επόμενη ανανέωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription is still on. Cancel it in subscription management and you won’t pay at the next renewal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción sigue activa. Cancélala en la gestión de suscripciones y no pagarás en la próxima renovación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi on yhä voimassa. Peru se tilausten hallinnasta, niin seuraavaa uusintaa ei veloiteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement est toujours actif. Résiliez-le dans la gestion des abonnements pour ne plus payer au prochain renouvellement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan masih aktif. Batalkan di pengelolaan langganan agar tidak ditagih pada perpanjangan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento è ancora attivo. Annullalo nella gestione abbonamenti e dal prossimo rinnovo non pagherai più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクはまだ有効です。サブスクリプションの管理で解約すると、次の更新から支払いは発生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 아직 켜져 있어요. 구독 관리에서 해지하면 다음 갱신부터 더 내지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet er fortsatt aktivt. Si det opp under abonnementer, så betaler du ikke ved neste fornyelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement loopt nog. Zeg het op via abonnementsbeheer, dan betaal je vanaf de volgende verlenging niets meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja jest nadal aktywna. Anuluj ją w zarządzaniu subskrypcjami, a przy następnym odnowieniu nie zapłacisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura ainda está ativa. Cancele em gerenciar assinaturas e você não paga mais a partir da próxima renovação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка всё ещё активна. Отмените её в управлении подписками, и со следующего продления платить не придётся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationen är fortfarande aktiv. Avsluta den under prenumerationer så betalar du inget vid nästa förnyelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกยังเปิดอยู่ ยกเลิกได้ในการจัดการการสมัครสมาชิก แล้วจะไม่ถูกเรียกเก็บเงินในรอบต่ออายุถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliğiniz hâlâ açık. Abonelik yönetiminden iptal ederseniz bir sonraki yenilemede ödeme yapmazsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký vẫn đang bật. Hủy trong phần quản lý đăng ký để không bị tính phí ở lần gia hạn tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅仍在生效。在订阅管理中取消后，下次续订起不再扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱仍在生效。到訂閱管理取消後，下次續訂起就不會再扣款。"
          }
        }
      }
    },
