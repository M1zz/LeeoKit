          "stringUnit": {
            "state": "translated",
            "value": "코드 하나는 한 사람이 한 번 쓸 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kode kan brukes én gang av én person."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke code kan één keer door één persoon worden gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy kod może wykorzystać tylko jedna osoba i tylko raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
