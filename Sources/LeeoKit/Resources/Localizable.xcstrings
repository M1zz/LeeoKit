    "끝나기 전에 한 번 더 울리는 타이머": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovač, který ještě jednou zazvoní před koncem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En timer, der ringer én gang mere, før den slutter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Timer, der vor dem Ende noch einmal klingelt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρονόμετρο που χτυπά άλλη μία φορά πριν τελειώσει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A timer that rings once more before it ends"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador que suena una vez más antes de terminar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajastin, joka soi vielä kerran ennen loppua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un minuteur qui sonne une fois de plus avant la fin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengatur waktu yang berbunyi sekali lagi sebelum berakhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un timer che suona ancora una volta prima di finire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終わる前にもう一度鳴るタイマー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝나기 전에 한 번 더 울리는 타이머"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tidtaker som ringer en gang til før den er ferdig"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een timer die nog één keer afgaat voordat hij afloopt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutnik, który dzwoni jeszcze raz przed końcem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um timer que toca mais uma vez antes de terminar"
          }
        },
        "ru": {
