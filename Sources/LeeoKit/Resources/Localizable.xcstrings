    "화면 한 장이 글보다 빠릅니다. 스크린샷을 붙여 주시면 훨씬 정확하게 고칠 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden snímek obrazovky řekne víc než odstavec textu. Když ho přiložíte, můžeme chybu opravit mnohem přesněji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét skærmbillede siger mere end et helt afsnit. Hvis du vedhæfter et, kan vi rette det langt mere præcist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Screenshot sagt mehr als ein Absatz. Wenn du einen anhängst, können wir es viel genauer beheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα στιγμιότυπο λέει περισσότερα από μια παράγραφο. Αν επισυνάψετε ένα, μπορούμε να το διορθώσουμε με ακρίβεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One screenshot says more than a paragraph. Attaching one helps us fix it accurately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una captura dice más que un párrafo. Si adjuntas una, podremos arreglarlo con más precisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kuvakaappaus kertoo enemmän kuin kappale tekstiä. Kun liität sellaisen, voimme korjata ongelman paljon tarkemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture d’écran en dit plus qu’un paragraphe. En joindre une nous aide à corriger précisément."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tangkapan layar lebih jelas daripada satu paragraf. Lampirkan agar kami bisa memperbaikinya dengan tepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno screenshot dice più di un paragrafo. Allegarne uno ci aiuta a risolvere il problema con precisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一枚の画面が文章より早く伝わります。スクリーンショットを添えていただくと、より正確に直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 한 장이 글보다 빠릅니다. 스크린샷을 붙여 주시면 훨씬 정확하게 고칠 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett skjermbilde sier mer enn et avsnitt. Legger du ved et, blir det lettere for oss å rette feilen nøyaktig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén screenshot zegt meer dan een alinea. Als je er een toevoegt, kunnen we het veel nauwkeuriger oplossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zrzut ekranu mówi więcej niż akapit tekstu. Dzięki niemu naprawimy problem znacznie dokładniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma captura de tela diz mais do que um parágrafo. Anexar uma nos ajuda a corrigir com precisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один скриншот скажет больше, чем абзац. С ним мы исправим точнее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En skärmbild säger mer än ett stycke text. Om du bifogar en kan vi åtgärda det mycket mer exakt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอเดียวบอกได้มากกว่าข้อความ การแนบภาพช่วยให้เราแก้ไขได้แม่นยำขึ้นมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir ekran görüntüsü bir paragraftan fazlasını anlatır. Eklerseniz sorunu çok daha doğru şekilde düzeltebiliriz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ảnh màn hình nói được nhiều hơn một đoạn văn. Đính kèm ảnh giúp chúng tôi sửa chính xác hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张截图比一段文字更快说明问题。附上截图能帮我们更准确地修复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一張截圖比一段文字更快說明問題。附上截圖能幫我們更準確地修復。"
          }
        }
      }
    },
