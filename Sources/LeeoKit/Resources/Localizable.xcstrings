    "무지개 공방에서 오늘 요일 칸에 할 일을 끌어다 놓습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Rainbow Craft přetáhnete dnešní úkoly do sloupce daného dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I Rainbow Craft trækker du dagens opgaver over i kolonnen for dagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rainbow Craft ziehst du die heutigen Aufgaben in die Spalte des Tages."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Rainbow Craft σύρετε τις σημερινές εργασίες στη στήλη της ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rainbow Craft you drag today's tasks into the column for the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Rainbow Craft arrastras las tareas de hoy a la columna del día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow Craftissa vedät tämän päivän tehtävät päivän sarakkeeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Rainbow Craft, vous faites glisser les tâches du jour dans la colonne de ce jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Rainbow Craft, tugas hari ini diseret ke kolom harinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rainbow Craft trascini le attività di oggi nella colonna del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow Craftで、今日の曜日の列にやることをドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무지개 공방에서 오늘 요일 칸에 할 일을 끌어다 놓습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I Rainbow Craft drar du dagens oppgaver inn i kolonnen for dagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rainbow Craft sleep je de taken van vandaag naar de kolom van de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Rainbow Craft przeciągasz dzisiejsze zadania do kolumny tego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Rainbow Craft, você arrasta as tarefas de hoje para a coluna do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Rainbow Craft вы перетаскиваете дела в колонку сегодняшнего дня."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Rainbow Craft drar du dagens uppgifter till kolumnen för dagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Rainbow Craft ลากงานของวันนี้ไปวางในช่องของวันนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow Craft'ta bugünün görevlerini o günün sütununa sürüklersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Rainbow Craft, bạn kéo việc hôm nay vào cột của ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在彩虹工坊里，把今天要做的事拖进当天那一列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在彩虹工坊裡，把今天要做的事拖進當天那一列。"
          }
        }
      }
    },
    "문의 답변, 지원서, 예약 확인처럼 문장이 반복되는 일": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi zákazníkům, žádosti o práci, potvrzení rezervací: práce, kde se opakují stejné řádky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på henvendelser, ansøgninger, bookingbekræftelser: arbejde, hvor de samme linjer går igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Support-Antworten, Bewerbungen, Buchungsbestätigungen: Arbeit, bei der sich dieselben Zeilen wiederholen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαντήσεις σε ερωτήσεις, αιτήσεις, επιβεβαιώσεις κρατήσεων: δουλειά όπου οι ίδιες φράσεις επαναλαμβάνονται"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support replies, applications, booking confirmations: work where the same lines repeat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultas de clientes, solicitudes, confirmaciones de reserva: trabajo en el que se repiten las mismas frases"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakasvastaukset, hakemukset ja varausvahvistukset: työ, jossa samat rivit toistuvat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponses au support, candidatures, confirmations de réservation : un travail où les mêmes phrases reviennent"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan pertanyaan, lamaran, konfirmasi pemesanan: pekerjaan dengan kalimat yang berulang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposte all’assistenza, candidature, conferme di prenotazione: lavori in cui le stesse righe si ripetono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問い合わせ対応、応募書類、予約確認など、同じ文章が繰り返される仕事"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문의 답변, 지원서, 예약 확인처럼 문장이 반복되는 일"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kundesvar, søknader, bookingbekreftelser: arbeid der de samme linjene går igjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden op vragen, sollicitaties, boekingsbevestigingen: werk waarin dezelfde zinnen terugkomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi na zapytania, zgłoszenia, potwierdzenia rezerwacji: praca, w której powtarzają się te same zdania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas de suporte, candidaturas, confirmações de reserva: trabalhos em que as mesmas frases se repetem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы на обращения, заявки, подтверждения брони: работа, где фразы повторяются"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kundsvar, ansökningar, bokningsbekräftelser: arbete där samma rader återkommer"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ประโยคซ้ำกันบ่อย เช่น ตอบคำถาม ใบสมัคร ยืนยันการจอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek yanıtları, başvurular, rezervasyon onayları: aynı satırların tekrarlandığı işler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời câu hỏi, đơn ứng tuyển, xác nhận đặt chỗ: những việc lặp lại cùng câu chữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客服回复、投递申请、预订确认这类句子不断重复的事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "客服回覆、投遞申請、預訂確認這類句子不斷重複的事"
          }
        }
      }
    },
