    "새 피드백이 접수되면 이 기기로 푸시 알림이 와요. CloudKit admin 역할의 read 권한 설정 후에 동작해요.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Push-Mitteilung auf diesem Gerät, wenn neues Feedback eingeht. Funktioniert, sobald die Leserechte der CloudKit-Admin-Rolle eingerichtet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a push notification on this device when new feedback arrives. Works after the CloudKit admin role's read permission is set up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación push en este dispositivo cuando llegue un comentario nuevo. Funciona una vez configurado el permiso de lectura del rol admin de CloudKit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification push sur cet appareil à l’arrivée d’un nouveau commentaire. Fonctionne une fois le droit de lecture du rôle admin CloudKit configuré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan notifikasi push di perangkat ini saat masukan baru tiba. Berfungsi setelah izin baca peran admin CloudKit disiapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica push su questo dispositivo quando arriva un nuovo feedback. Funziona dopo aver configurato il permesso di lettura del ruolo admin in CloudKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいフィードバックが届くとこのデバイスにプッシュ通知が届きます。CloudKit adminロールのread権限設定後に動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 피드백이 접수되면 이 기기로 푸시 알림이 와요. CloudKit admin 역할의 read 권한 설정 후에 동작해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba uma notificação push neste dispositivo quando chegar um novo feedback. Funciona depois de configurar a permissão de leitura da função admin no CloudKit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда приходит новый отзыв, на это устройство приходит push-уведомление. Работает после настройки права read для роли admin в CloudKit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนแบบพุชบนอุปกรณ์นี้เมื่อมีความคิดเห็นใหม่ ใช้งานได้หลังตั้งค่าสิทธิ์ read ของบทบาท admin ใน CloudKit"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo đẩy trên thiết bị này khi có góp ý mới. Hoạt động sau khi thiết lập quyền read cho vai trò admin của CloudKit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新反馈时会给这台设备发推送通知。需要先设置好 CloudKit admin 角色的 read 权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有新意見回饋時會給這台裝置發推送通知。需要先設定好 CloudKit admin 角色的 read 權限。"
          }
        }
      }
    },
