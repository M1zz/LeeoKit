            "value": "Co jste koupili a co teď vidíte?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad købte du, og hvad vises nu?"
          }
        },
        "de": {
          "stringUnit": {
