    "약속한 시간보다 먼저 울리니, 기다리는 쪽이 아니라 먼저 연락하는 쪽이 됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní ještě před domluvenou hodinou, takže se ozvete první a nemusíte čekat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ringer før det aftalte tidspunkt, så det er dig, der tager kontakt først, i stedet for dig, der venter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es klingelt vor der vereinbarten Uhrzeit, du meldest dich also zuerst, statt zu warten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπά πριν από τη συμφωνημένη ώρα, έτσι εσείς επικοινωνείτε πρώτοι αντί να περιμένετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It rings before the promised hour, so you are the one who reaches out first instead of the one waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena antes de la hora prometida, así que eres tú quien se adelanta a contactar en lugar de quien espera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se soi ennen sovittua aikaa, joten sinä otat yhteyttä ensin etkä jää odottamaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sonne avant l’heure promise : c’est vous qui relancez en premier au lieu d’attendre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia berbunyi sebelum waktu yang dijanjikan, jadi Andalah yang menghubungi lebih dulu, bukan yang menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona prima dell’ora promessa, così sei tu a farti sentire per primo invece di restare ad aspettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約束の時間より先に鳴るので、待つ側ではなく先に連絡する側になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약속한 시간보다 먼저 울리니, 기다리는 쪽이 아니라 먼저 연락하는 쪽이 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ringer før det avtalte tidspunktet, så du er den som tar kontakt først i stedet for den som venter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij gaat af vóór het afgesproken tijdstip, dus jij neemt als eerste contact op in plaats van te wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzwoni przed umówioną godziną, więc to Ty odzywasz się pierwszy, zamiast czekać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele toca antes da hora combinada, então você é quem entra em contato primeiro, em vez de quem fica esperando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он звонит раньше обещанного часа, и первым выходит на связь уже не собеседник, а вы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ringer före den utlovade tiden, så du blir den som hör av sig först i stället för den som väntar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังก่อนเวลานัด คุณจึงเป็นฝ่ายติดต่อก่อน ไม่ใช่ฝ่ายรอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söz verilen saatten önce çalar; böylece bekleyen değil, ilk ulaşan siz olursunuz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó reo trước giờ hẹn, nên bạn là người chủ động liên lạc trước thay vì người phải chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在约定时间之前先响，于是你不是等着的那一方，而是先联系的那一方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會在約定時間之前先響，於是你不是等著的那一方，而是先聯繫的那一方。"
          }
        }
      }
    },
    "어떤 기능이 있으면 좋겠나요?\n예) 단축어를 폴더로 묶는 기능이 필요해요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakou funkci byste chtěli?\nNapř. Chtěl bych třídit úryvky do složek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken funktion kunne du tænke dig?\nFx: Jeg vil gerne samle tekststykker i mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Funktion wünschst du dir?\nz. B. Ich möchte Textbausteine in Ordnern gruppieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια λειτουργία θα θέλατε;\nπ.χ. Θα ήθελα να ομαδοποιώ τα αποσπάσματα σε φακέλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What feature would you like?\ne.g. I'd like to group snippets into folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué función te gustaría?\nP. ej.: Me gustaría agrupar los fragmentos en carpetas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minkä ominaisuuden haluaisit?\nEsim. haluaisin ryhmitellä tekstinpätkät kansioihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle fonctionnalité aimeriez-vous ?\nEx. : j’aimerais regrouper mes raccourcis dans des dossiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur apa yang Anda inginkan?\nmis. Saya ingin mengelompokkan cuplikan teks ke dalam folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale funzione ti piacerebbe avere?\nad es. Vorrei raggruppare gli snippet in cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな機能があるといいですか？\n例）ショートカットをフォルダにまとめる機能が欲しいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 기능이 있으면 좋겠나요?\n예) 단축어를 폴더로 묶는 기능이 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken funksjon ønsker du deg?\nF.eks. Jeg vil gruppere tekstbiter i mapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke functie zou je willen?\nBijv. Ik wil tekstfragmenten in mappen groeperen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakiej funkcji Ci brakuje?\nNp. Chcę grupować fragmenty tekstu w foldery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que recurso você gostaria de ter?\nEx.: Quero agrupar os atalhos em pastas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая функция вам нужна?\nНапример: хочу группировать фразы по папкам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken funktion skulle du vilja ha?\nT.ex. Jag vill kunna samla textsnuttar i mappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากได้ฟีเจอร์อะไร\nเช่น อยากจัดข้อความด่วนเป็นโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi özelliği istersiniz?\nÖrn. Metin parçalarını klasörlerde gruplamak istiyorum."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn có tính năng gì?\nVí dụ: Tôi muốn nhóm cụm từ vào thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望有什么功能？\n例）希望能把短语按文件夹归类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望有什麼功能？\n例）希望能把短語按資料夾歸類。"
          }
        }
      }
    },
    "어떤 부분이 궁금하신가요?\n예) 클립보드 히스토리는 어떻게 보나요?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co byste chtěli vědět?\nNapř. Jak zobrazím historii schránky?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du gerne vide?\nFx: Hvordan ser jeg historikken for udklipsholderen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du wissen?\nz. B. Wie sehe ich den Zwischenablage-Verlauf?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι θα θέλατε να μάθετε;\nπ.χ. Πώς βλέπω το ιστορικό του προχείρου;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to know?\ne.g. How do I view clipboard history?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te gustaría saber?\nP. ej.: ¿Cómo veo el historial del portapapeles?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä haluaisit tietää?\nEsim. miten näen leikepöydän historian?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous savoir ?\nEx. : comment consulter l’historique du presse-papiers ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ingin Anda ketahui?\nmis. Bagaimana cara melihat riwayat papan klip?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vorresti sapere?\nad es. Come vedo la cronologia degli appunti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの部分が気になりますか？\n例）クリップボード履歴はどこで見られますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 부분이 궁금하신가요?\n예) 클립보드 히스토리는 어떻게 보나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva lurer du på?\nF.eks. Hvordan ser jeg utklippshistorikken?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je weten?\nBijv. Hoe bekijk ik de klembordgeschiedenis?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czego chcesz się dowiedzieć?\nNp. Jak zobaczyć historię schowka?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você gostaria de saber?\nEx.: Como vejo o histórico da área de transferência?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы хотели бы узнать?\nНапример: как посмотреть историю буфера обмена?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad vill du veta?\nT.ex. Hur ser jag urklippshistoriken?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากทราบเรื่องอะไร\nเช่น ดูประวัติคลิปบอร์ดได้อย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne öğrenmek istersiniz?\nÖrn. Pano geçmişini nasıl görüntülerim?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn biết điều gì?\nVí dụ: Làm sao xem lịch sử bảng tạm?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想了解哪方面？\n例）剪贴板历史在哪里看？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你想瞭解哪方面？\n例）剪貼簿歷史在哪裡看？"
          }
        }
      }
    },
    "어떤 상황에서 문제가 발생했는지 알려주세요.\n예) 단축어를 저장할 때 앱이 종료됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popište, kdy problém nastává.\nNapř. Aplikace se ukončí, když ukládám úryvek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl os, hvornår problemet opstår.\nFx: Appen lukker, når jeg gemmer et tekststykke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, wann das Problem auftritt.\nz. B. Die App beendet sich, wenn ich einen Textbaustein speichere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πείτε μας πότε εμφανίζεται το πρόβλημα.\nπ.χ. Η εφαρμογή κλείνει όταν αποθηκεύω ένα απόσπασμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us when the problem happens.\ne.g. The app quits when I save a snippet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos cuándo ocurre el problema.\nP. ej.: La app se cierra cuando guardo un fragmento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, missä tilanteessa ongelma ilmenee.\nEsim. appi sulkeutuu, kun tallennan tekstinpätkän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous quand le problème se produit.\nEx. : l’app se ferme quand j’enregistre un raccourci."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan kapan masalahnya terjadi.\nmis. Aplikasi tertutup saat saya menyimpan cuplikan teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci quando si verifica il problema.\nad es. L’app si chiude quando salvo uno snippet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのような状況で問題が発生したか教えてください。\n例）ショートカットを保存するとアプリが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 상황에서 문제가 발생했는지 알려주세요.\n예) 단축어를 저장할 때 앱이 종료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortell oss når problemet oppstår.\nF.eks. Appen avsluttes når jeg lagrer en tekstbit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel ons wanneer het probleem optreedt.\nBijv. De app stopt als ik een tekstfragment bewaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz, kiedy pojawia się problem.\nNp. Aplikacja zamyka się, gdy zapisuję fragment tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte quando o problema acontece.\nEx.: O app fecha quando salvo um atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, когда возникает проблема.\nНапример: приложение закрывается при сохранении фразы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta när problemet uppstår.\nT.ex. Appen avslutas när jag sparar en textsnutt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกเราว่าปัญหาเกิดขึ้นตอนไหน\nเช่น แอปปิดตัวเมื่อบันทึกข้อความด่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunun ne zaman oluştuğunu bize anlatın.\nÖrn. Bir metin parçasını kaydederken uygulama kapanıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho chúng tôi biết sự cố xảy ra khi nào.\nVí dụ: Ứng dụng thoát khi tôi lưu cụm từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们问题是在什么情况下发生的。\n例）保存短语时 App 会闪退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請告訴我們問題是在什麼情況下發生的。\n例）儲存短語時 App 會閃退。"
          }
        }
      }
    },
    "어떤 점이 불편하셨나요? 어떻게 바뀌면 더 좋을지 알려주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co vám vadilo? Napište nám, jak by to mohlo být lepší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad var besværligt? Fortæl os, hvordan det kunne blive bedre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was war umständlich? Sag uns, wie es besser sein könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι σας δυσκόλεψε; Πείτε μας πώς θα μπορούσε να γίνει καλύτερο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was inconvenient? Let us know how it could be better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te resultó incómodo? Cuéntanos cómo podría mejorar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tuntui hankalalta? Kerro, miten se voisi olla paremmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’est-ce qui vous a gêné ? Dites-nous ce qui pourrait être amélioré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang kurang nyaman? Beri tahu kami bagaimana agar lebih baik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti ha dato fastidio? Dicci come potrebbe migliorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな点が不便でしたか？どう変わればより良いか教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 점이 불편하셨나요? 어떻게 바뀌면 더 좋을지 알려주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva var tungvint? Fortell oss hvordan det kunne blitt bedre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat was onhandig? Laat ons weten hoe het beter kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co było niewygodne? Napisz, co mogłoby działać lepiej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que foi incômodo? Conte como poderia ficar melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что было неудобно? Расскажите, как сделать лучше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad var krångligt? Berätta hur det kunde bli bättre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สะดวกตรงไหน บอกเราว่าควรปรับอย่างไรให้ดีขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zorlayıcıydı? Nasıl daha iyi olabileceğini bize anlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều gì khiến bạn thấy bất tiện? Hãy cho chúng tôi biết nên thay đổi thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪里让你觉得不方便？也告诉我们怎么改会更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪裡讓你覺得不方便？也告訴我們怎麼改會更好。"
          }
        }
      }
    },
    "언제 바빠지는지 미리 알고 싶은 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří chtějí dopředu vědět, kdy bude rušno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der gerne vil vide på forhånd, hvornår der bliver travlt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die vorher wissen wollen, wann es stressig wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι θέλουν να ξέρουν από πριν πότε θα έχουν φόρτο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who want to know in advance when things get busy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien quiere saber de antemano cuándo se va a complicar la cosa"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka haluavat tietää etukäteen, milloin tulee kiire"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui veulent savoir à l’avance quand ça va se charger"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang ingin tahu lebih dulu kapan waktunya akan padat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi vuole sapere in anticipo quando arriveranno i momenti pieni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ忙しくなるのかを先に知っておきたい人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 바빠지는지 미리 알고 싶은 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som vil vite på forhånd når det blir travelt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die van tevoren willen weten wanneer het druk wordt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które chcą wiedzieć z wyprzedzeniem, kiedy zrobi się gorąco"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem quer saber com antecedência quando as coisas vão apertar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто хочет заранее знать, когда станет плотно"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som vill veta i förväg när det blir mycket att göra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่อยากรู้ล่วงหน้าว่าจะยุ่งเมื่อไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlerin ne zaman yoğunlaşacağını önceden bilmek isteyenler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người muốn biết trước khi nào sẽ bận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想提前知道哪天会忙起来的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想提前知道哪天會忙起來的人"
          }
        }
      }
    },
    "여기서 아무것도 수집하지 않습니다. 눌러야만 App Store 가 열립니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady se nic neshromažďuje. App Store se otevře, jen když klepnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her indsamles intet. App Store åbner kun, når du trykker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wird nichts erfasst. Der App Store öffnet sich erst, wenn du tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν συλλέγεται εδώ. Το App Store ανοίγει μόνο όταν πατήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is collected here. The App Store opens only when you tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no se recoge nada. El App Store solo se abre si tocas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä ei kerätä mitään. App Store avautuu vain, kun napautat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est collecté ici. L’App Store ne s’ouvre que si vous touchez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dikumpulkan di sini. App Store hanya terbuka bila Anda menekannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non viene raccolto nulla. L’App Store si apre solo quando tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは何も集めません。押したときだけApp Storeが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 아무것도 수집하지 않습니다. 눌러야만 App Store 가 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting samles inn her. App Store åpnes bare når du trykker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wordt niets verzameld. De App Store opent pas als je tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tu nie jest zbierane. App Store otwiera się dopiero po stuknięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é coletado aqui. A App Store só abre quando você toca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не собирается. App Store откроется, только если нажать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting samlas in här. App Store öppnas bara om du trycker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นี่ไม่มีการเก็บข้อมูลใดๆ App Store จะเปิดเมื่อคุณแตะเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada hiçbir şey toplanmaz. App Store yalnızca dokunduğunuzda açılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thu thập gì ở đây. App Store chỉ mở khi bạn chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不收集任何东西。只有你点了，App Store 才会打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡不收集任何東西。只有你點了，App Store 才會開啟。"
          }
        }
      }
    },
    "열 군데에 비슷한 서류를 넣어야 하는 하루.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den, kdy posíláte skoro stejné dokumenty na deset míst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag, hvor du sender næsten ens dokumenter til ti steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag, an dem du fast gleiche Unterlagen an zehn Stellen schickst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μέρα που στέλνετε σχεδόν ίδια έγγραφα σε δέκα μέρη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day of sending near-identical documents to ten places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día de enviar documentos casi idénticos a diez sitios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivä, jona lähetät lähes samanlaiset paperit kymmeneen paikkaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée à envoyer des documents presque identiques à dix endroits."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu hari mengirim berkas serupa ke sepuluh tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una giornata passata a inviare documenti quasi identici a dieci posti diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じような書類を十か所に出す一日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 군데에 비슷한 서류를 넣어야 하는 하루."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag der du sender nesten like dokumenter til ti steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag waarop je bijna dezelfde documenten naar tien plekken stuurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień, w którym wysyłasz niemal identyczne dokumenty w dziesięć miejsc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia enviando documentos quase idênticos para dez lugares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, когда почти одинаковые бумаги уходят в десять мест."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag då du skickar nästan likadana dokument till tio ställen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ต้องส่งเอกสารคล้ายๆ กันไปสิบแห่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse aynı belgeleri on ayrı yere gönderdiğiniz bir gün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày gửi hồ sơ gần giống nhau đến mười nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要往十个地方投递差不多材料的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要往十個地方投遞差不多材料的一天。"
          }
        }
      }
    },
    "오른쪽으로 밀면 완료 표시(이 기기에만 저장돼요), 왼쪽으로 밀면 삭제. 삭제는 CloudKit admin 역할에 쓰기 권한이 있어야 반영돼요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím doprava označíte jako hotové (uloží se jen v tomto zařízení), přejetím doleva smažete. Mazání vyžaduje oprávnění k zápisu pro roli admin v CloudKitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub til højre for at markere som færdig (gemmes kun på denne enhed), skub til venstre for at slette. Sletning kræver skriveadgang for admin-rollen i CloudKit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach rechts wischen, um als erledigt zu markieren (nur auf diesem Gerät gespeichert), nach links wischen zum Löschen. Löschen erfordert Schreibrechte für die CloudKit-Admin-Rolle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε δεξιά για επισήμανση ως ολοκληρωμένο (αποθηκεύεται μόνο σε αυτήν τη συσκευή), αριστερά για διαγραφή. Η διαγραφή απαιτεί δικαίωμα εγγραφής στον ρόλο admin του CloudKit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to mark as done (saved on this device only), swipe left to delete. Delete requires write permission on the CloudKit admin role."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha para marcar como hecho (se guarda solo en este dispositivo) y a la izquierda para eliminar. Eliminar requiere permiso de escritura en el rol admin de CloudKit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise oikealle merkitäksesi valmiiksi (tallennetaan vain tähän laitteeseen) ja vasemmalle poistaaksesi. Poistaminen vaatii CloudKitin admin-roolille kirjoitusoikeuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers la droite pour marquer comme traité (enregistré uniquement sur cet appareil), vers la gauche pour supprimer. La suppression nécessite le droit d’écriture sur le rôle admin CloudKit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke kanan untuk menandai selesai (disimpan hanya di perangkat ini), geser ke kiri untuk menghapus. Menghapus memerlukan izin tulis pada peran admin CloudKit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso destra per segnare come completato (salvato solo su questo dispositivo), verso sinistra per eliminare. L’eliminazione richiede il permesso di scrittura sul ruolo admin di CloudKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右にスワイプで完了（この端末にのみ保存）、左にスワイプで削除。削除はCloudKit adminロールの書き込み権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽으로 밀면 완료 표시(이 기기에만 저장돼요), 왼쪽으로 밀면 삭제. 삭제는 CloudKit admin 역할에 쓰기 권한이 있어야 반영돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip til høyre for å merke som ferdig (lagres bare på denne enheten), sveip til venstre for å slette. Sletting krever skrivetilgang for admin-rollen i CloudKit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts om als afgehandeld te markeren (alleen op dit apparaat bewaard), veeg naar links om te verwijderen. Verwijderen vereist schrijfrechten voor de CloudKit-admin-rol."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w prawo, aby oznaczyć jako gotowe (zapisywane tylko na tym urządzeniu), w lewo, aby usunąć. Usuwanie wymaga uprawnienia do zapisu dla roli admin w CloudKit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a direita para marcar como concluído (salvo só neste dispositivo) e para a esquerda para apagar. Apagar exige permissão de escrita na função admin do CloudKit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вправо, чтобы отметить как выполненное (хранится только на этом устройстве), влево, чтобы удалить. Для удаления у роли admin в CloudKit должно быть право write."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt höger för att markera som klar (sparas bara på den här enheten), svep åt vänster för att radera. Radering kräver skrivbehörighet för admin-rollen i CloudKit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขวาเพื่อทำเครื่องหมายว่าเสร็จ (บันทึกในอุปกรณ์นี้เท่านั้น) ปัดซ้ายเพื่อลบ การลบต้องมีสิทธิ์ write ในบทบาท admin ของ CloudKit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı olarak işaretlemek için sağa kaydırın (yalnızca bu aygıtta saklanır), silmek için sola kaydırın. Silme işlemi için CloudKit admin rolünde yazma izni gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang phải để đánh dấu xong (chỉ lưu trên thiết bị này), vuốt sang trái để xóa. Xóa cần quyền write cho vai trò admin của CloudKit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑标为已处理（只存在这台设备上），左滑删除。删除需要 CloudKit admin 角色有写入权限才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑標為已處理（只存在這台裝置上），左滑刪除。刪除需要 CloudKit admin 角色有寫入權限才會生效。"
          }
        }
      }
    },
