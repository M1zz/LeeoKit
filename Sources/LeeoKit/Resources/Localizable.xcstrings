    "한쪽에서 고친 자리는 다른 쪽에도 곧 나타납니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf der einen Seite änderst, taucht bald auch auf der anderen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you change on one side shows up on the other before long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cambias en un lado aparece en el otro al poco rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous modifiez d’un côté apparaît bientôt de l’autre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang diubah di satu sisi segera muncul di sisi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che modifichi da una parte compare presto anche dall’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片方で直したところは、もう片方にもすぐ現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한쪽에서 고친 자리는 다른 쪽에도 곧 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você muda de um lado aparece do outro logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменённое на одной стороне вскоре появляется на другой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่แก้ฝั่งหนึ่งจะปรากฏอีกฝั่งในไม่ช้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ bạn sửa ở một bên sẽ sớm hiện ở bên kia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一边改动的地方，另一边很快也会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一邊改動的地方，另一邊很快也會出現。"
          }
        }
      }
    },
    "할 일 목록이 길어질수록 손이 안 가는 사람": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die ins Stocken geraten, je länger die To-do-Liste wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who stall as the to-do list gets longer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien se bloquea cuanto más larga es la lista de tareas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui bloquent à mesure que la liste de tâches s’allonge"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang makin enggan saat daftar tugasnya memanjang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi si blocca man mano che l’elenco delle cose da fare si allunga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やることリストが長くなるほど手が止まる人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 목록이 길어질수록 손이 안 가는 사람"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem trava conforme a lista de tarefas cresce"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, у кого руки опускаются, когда список дел растёт"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ยิ่งรายการงานยาวยิ่งไม่อยากเริ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người càng ngại bắt tay khi danh sách việc càng dài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办越长越提不起劲的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待辦越長越提不起勁的人"
          }
        }
      }
    },
    "할 일을 요일 격자에 끌어다 놓아 계획 블록으로 만듭니다. 수면과 식사 같은 고정 루틴을 먼저 깔고, 남은 자리에 일을 앉힙니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh Aufgaben in das Tagesraster, und sie werden zu geplanten Blöcken. Leg zuerst feste Routinen wie Schlaf und Mahlzeiten an und plane die Arbeit dann in den Rest ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag tasks onto the day grid and they become planned blocks. Lay down fixed routines like sleep and meals first, then seat the work in what is left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las tareas a la cuadrícula de días y se convierten en bloques planificados. Coloca primero las rutinas fijas, como dormir y comer, y luego encaja el trabajo en lo que queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des tâches sur la grille des jours pour en faire des blocs planifiés. Posez d’abord les routines fixes comme le sommeil et les repas, puis placez le travail dans ce qui reste."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret tugas ke petak hari dan ia menjadi blok rencana. Letakkan dulu rutinitas tetap seperti tidur dan makan, lalu dudukkan pekerjaan di sisa tempatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le attività sulla griglia dei giorni e diventano blocchi pianificati. Prima disponi le routine fisse come sonno e pasti, poi sistema il lavoro nello spazio rimasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やることを曜日のマス目にドラッグすると計画ブロックになります。睡眠や食事のような固定の予定を先に敷き、残った場所に仕事を置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 요일 격자에 끌어다 놓아 계획 블록으로 만듭니다. 수면과 식사 같은 고정 루틴을 먼저 깔고, 남은 자리에 일을 앉힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste tarefas para a grade da semana e elas viram blocos planejados. Coloque primeiro as rotinas fixas, como sono e refeições, e depois encaixe o trabalho no que sobrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите дело на сетку дня, и оно станет блоком плана. Сначала уложите постоянное: сон, еду, а работу посадите в то, что осталось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากงานลงตารางรายวันให้เป็นบล็อกแผนงาน วางกิจวัตรประจำ เช่น การนอนและมื้ออาหารก่อน แล้วจัดงานลงในช่องที่เหลือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo việc vào lưới ngày để biến thành khối kế hoạch. Đặt các thói quen cố định như ngủ và ăn trước, rồi xếp công việc vào chỗ còn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把待办拖到星期格子上，就成了计划块。先铺好睡眠、吃饭这类固定作息，再把工作放进剩下的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把待辦拖到星期格子上，就成了計劃塊。先鋪好睡眠、吃飯這類固定作息，再把工作放進剩下的位置。"
          }
        }
      }
    },
