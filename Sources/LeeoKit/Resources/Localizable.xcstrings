          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写评价"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫評價"
          }
        }
      }
    },
    "마감 직전에야 알아차려 곤란했던 사람": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who have been caught out by noticing a deadline too late"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang pernah repot karena baru sadar menjelang tenggat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切り直前に気づいて困ったことがある人"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто уже попадал впросак, заметив срок слишком поздно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾经临到截止才发现而手忙脚乱的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曾經臨到截止才發現而手忙腳亂的人"
          }
        }
      }
    },
    "마감이 있는 곳은 두번알림에 걸어 둡니다. 30분 전과 5분 전에 한 번 더 울립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anywhere with a deadline goes into Rereminder. It rings again thirty minutes before, and five minutes before."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang punya tenggat dititipkan ke Rereminder. Ia berbunyi lagi tiga puluh menit dan lima menit sebelumnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りのあるところはRereminderに登録します。30分前と5分前にもう一度鳴ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, у чего есть срок, уходит в Rereminder. Он звонит ещё раз за тридцать минут и за пять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止的地方交给 Rereminder。提前三十分钟和五分钟各响一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止的地方交給 Rereminder。提前三十分鐘和五分鐘各響一次。"
          }
        }
      }
    },
