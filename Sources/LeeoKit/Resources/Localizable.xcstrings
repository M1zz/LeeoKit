    "남겨주시면 답변을 드릴 수 있어요. 이 기기에만 저장해 다음에 다시 채워드려요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když nám zanecháte kontakt, můžeme vám odpovědět. Uloží se jen v tomto zařízení a příště se vyplní za vás."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du skriver dine kontaktoplysninger, kan vi svare dig. Gemmes kun på denne enhed og udfyldes for dig næste gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine Kontaktdaten hinterlässt, können wir dir antworten. Nur auf diesem Gerät gespeichert und beim nächsten Mal für dich ausgefüllt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αφήσετε στοιχεία επικοινωνίας, μπορούμε να σας απαντήσουμε. Αποθηκεύονται μόνο σε αυτήν τη συσκευή και συμπληρώνονται αυτόματα την επόμενη φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you leave your contact, we can get back to you. Saved on this device only and filled in for you next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si nos dejas tu contacto, podemos responderte. Se guarda solo en este dispositivo y se rellena por ti la próxima vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos jätät yhteystietosi, voimme vastata sinulle. Ne tallennetaan vain tähän laitteeseen ja täytetään valmiiksi ensi kerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous laissez vos coordonnées, nous pourrons vous répondre. Enregistrées uniquement sur cet appareil et préremplies la prochaine fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mencantumkan kontak, kami dapat membalas. Disimpan hanya di perangkat ini dan diisi otomatis lain kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lasci un contatto, possiamo risponderti. Viene salvato solo su questo dispositivo e compilato per te la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご記入いただければ返信いたします。この端末にのみ保存し、次回は自動で入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남겨주시면 답변을 드릴 수 있어요. 이 기기에만 저장해 다음에 다시 채워드려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du legger igjen kontaktinfo, kan vi svare deg. Lagres bare på denne enheten og fylles ut for deg neste gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je contactgegevens achterlaat, kunnen we je antwoorden. Alleen op dit apparaat bewaard en de volgende keer voor je ingevuld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zostawisz kontakt, będziemy mogli Ci odpowiedzieć. Zapisywany tylko na tym urządzeniu i uzupełniany za Ciebie następnym razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você deixar um contato, podemos responder. Fica salvo só neste dispositivo e é preenchido para você da próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте контакт, и мы сможем вам ответить. Он хранится только на этом устройстве и подставится в следующий раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du lämnar dina kontaktuppgifter kan vi svara dig. Sparas bara på den här enheten och fylls i åt dig nästa gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากฝากข้อมูลติดต่อไว้ เราจะตอบกลับได้ ข้อมูลจะบันทึกไว้ในอุปกรณ์นี้เท่านั้นและกรอกให้ในครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletişim bilgilerinizi bırakırsanız size dönebiliriz. Yalnızca bu aygıtta saklanır ve bir dahaki sefere sizin için doldurulur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn để lại thông tin, chúng tôi có thể trả lời bạn. Chỉ lưu trên thiết bị này và tự điền lại lần sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下联系方式，我们就能回复你。只存在这台设备上，下次会自动帮你填好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留下聯繫方式，我們就能回覆你。只存在這台裝置上，下次會自動幫你填好。"
          }
        }
      }
    },
