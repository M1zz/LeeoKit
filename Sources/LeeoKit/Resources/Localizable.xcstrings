    "회의와 마감 사이에 남은 시간을 찾을 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když hledáte volný čas mezi schůzkami a termíny"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du leder efter ledig tid mellem møder og deadlines"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die freie Zeit zwischen Meetings und Fristen suchst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ψάχνετε τον χρόνο που μένει ανάμεσα σε συσκέψεις και προθεσμίες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are looking for the time left between meetings and deadlines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando buscas el tiempo que queda entre reuniones y plazos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun etsit vapaata aikaa kokousten ja määräaikojen välistä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous cherchez le temps qui reste entre réunions et échéances"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat mencari waktu tersisa di antara rapat dan tenggat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando cerchi il tempo rimasto tra riunioni e scadenze"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議と締め切りの間に残った時間を探すとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의와 마감 사이에 남은 시간을 찾을 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du leter etter ledig tid mellom møter og frister"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de vrije tijd tussen vergaderingen en deadlines zoekt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy szukasz wolnego czasu między spotkaniami a terminami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você procura o tempo que sobra entre reuniões e prazos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ищете время, оставшееся между встречами и сроками"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du letar efter tiden som är kvar mellan möten och deadlines"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องหาเวลาว่างระหว่างประชุมและกำหนดส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantılarla son tarihler arasında kalan boş zamanı ararken"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tìm khoảng thời gian còn lại giữa các cuộc họp và hạn chót"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在会议和截止之间寻找剩余时间时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在會議和截止之間尋找剩餘時間時"
          }
        }
      }
    },
    "언제, 무엇을 하다가 그랬나요?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy se to stalo a co jste zrovna dělali?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår skete det, og hvad var du i gang med?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann ist es passiert, und was hast du gerade gemacht?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότε συνέβη και τι κάνατε εκείνη τη στιγμή;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did it happen, and what were you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo pasó y qué estabas haciendo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Milloin se tapahtui, ja mitä olit tekemässä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand est-ce arrivé, et que faisiez-vous ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan terjadinya, dan apa yang sedang Anda lakukan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è successo e cosa stavi facendo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ、何をしている時でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제, 무엇을 하다가 그랬나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når skjedde det, og hva holdt du på med?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer gebeurde het en wat was je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy to się stało i co wtedy robiłeś?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aconteceu e o que você estava fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда это случилось и что вы делали?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När hände det, och vad gjorde du då?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดขึ้นเมื่อไร ขณะทำอะไรอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman oldu ve o sırada ne yapıyordunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyện xảy ra khi nào, và lúc đó bạn đang làm gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么时候、在做什么时发生的？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼時候、在做什麼時發生的？"
          }
        }
      }
    },
    "예) 오늘 아침, 목록에서 항목을 저장하려던 중": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. dnes ráno při ukládání položky v seznamu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fx: I morges, da jeg gemte et element på listen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Heute Morgen, beim Speichern eines Eintrags in der Liste"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Σήμερα το πρωί, ενώ αποθήκευα ένα στοιχείο στη λίστα"
