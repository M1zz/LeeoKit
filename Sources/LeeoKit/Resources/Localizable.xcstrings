          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. z 20 zapisanych elementów zniknęła mniej więcej połowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: Dos 20 itens que eu tinha, sumiu mais ou menos a metade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например: из 20 сохранённых записей пропало около половины."
          }
        },
        "sv": {
          "stringUnit": {
