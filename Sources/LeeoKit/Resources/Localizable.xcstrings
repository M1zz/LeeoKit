          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad"
          }
        }
      }
    },
    "아이폰": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone"
          }
        }
      }
    },
    "아이폰에서 모은 문장이 iCloud 로 맥에 따라옵니다. 메뉴바 아이콘이나 전역 단축키로 어느 앱에서든 꺼내 붙여넣습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines you saved on iPhone follow you to the Mac over iCloud. Pull them up from the menu bar icon or a global hotkey in any app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang Anda kumpulkan di iPhone ikut ke Mac lewat iCloud. Ambil dari ikon bilah menu atau pintasan global di aplikasi mana pun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでためた文章がiCloudでMacにも届きます。メニューバーのアイコンかグローバルショートカットで、どのアプリでも取り出して貼り付けられます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразы, собранные на iPhone, приходят на Mac через iCloud. Достаньте их из значка в строке меню или по глобальному сочетанию клавиш в любом приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上攒下的句子会通过 iCloud 跟到 Mac。用菜单栏图标或全局快捷键，在任何应用里都能取出来粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上攢下的句子會透過 iCloud 跟到 Mac。用菜單欄圖標或全域快速鍵，在任何應用裡都能取出來貼上。"
          }
        }
      }
    },
    "아직 접수된 피드백이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No feedback received yet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada masukan yang diterima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ受信したフィードバックはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有收到反馈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有收到意見回饋"
          }
        }
      }
    },
    "알림 권한이 꺼져 있어요. iOS 설정 > %@ > 알림에서 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off. Please allow them in iOS Settings > %@ > Notifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっています。iOSの設定 > %@ > 通知で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知权限没打开。请在“iOS 设置 > %@ > 通知”里允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知權限沒開啟。請在「iOS 設定 > %@ > 通知」裡允許。"
          }
        }
      }
    },
    "애플워치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch"
          }
        }
      }
    },
    "약속한 시간보다 먼저 울리니, 기다리는 쪽이 아니라 먼저 연락하는 쪽이 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It rings before the promised hour, so you are the one who reaches out first instead of the one waiting."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia berbunyi sebelum waktu yang dijanjikan, jadi Andalah yang menghubungi lebih dulu, bukan yang menunggu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約束の時間より先に鳴るので、待つ側ではなく先に連絡する側になります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он звонит раньше обещанного часа, и первым выходит на связь уже не собеседник, а вы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在约定时间之前先响，于是你不是等着的那一方，而是先联系的那一方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會在約定時間之前先響，於是你不是等著的那一方，而是先聯繫的那一方。"
          }
        }
      }
    },
    "어떤 기능이 있으면 좋겠나요?\n예) 단축어를 폴더로 묶는 기능이 필요해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What feature would you like?\ne.g. I'd like to group snippets into folders."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "What feature would you like?\nExample: I need a way to group snippets into folders."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな機能があるといいですか？\n例）ショートカットをフォルダにまとめる機能が欲しいです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望有什么功能？\n例）希望能把短语按文件夹归类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望有什麼功能？\n例）希望能把短語按資料夾歸類。"
          }
        }
      }
    },
    "어떤 부분이 궁금하신가요?\n예) 클립보드 히스토리는 어떻게 보나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to know?\ne.g. How do I view clipboard history?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "What would you like to know?\nExample: How do I view my clipboard history?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの部分が気になりますか？\n例）クリップボード履歴はどこで見られますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想了解哪方面？\n例）剪贴板历史在哪里看？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你想瞭解哪方面？\n例）剪貼簿歷史在哪裡看？"
          }
        }
      }
    },
    "어떤 상황에서 문제가 발생했는지 알려주세요.\n예) 단축어를 저장할 때 앱이 종료됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us when the problem happens.\ne.g. The app quits when I save a snippet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe when the issue occurs.\nExample: The app closes when saving a snippet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのような状況で問題が発生したか教えてください。\n例）ショートカットを保存するとアプリが終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们问题是在什么情况下发生的。\n例）保存短语时 App 会闪退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請告訴我們問題是在什麼情況下發生的。\n例）儲存短語時 App 會閃退。"
          }
        }
      }
    },
    "어떤 점이 불편하셨나요? 어떻게 바뀌면 더 좋을지 알려주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was inconvenient? Let us know how it could be better."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな点が不便でしたか？どう変わればより良いか教えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪里让你觉得不方便？也告诉我们怎么改会更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪裡讓你覺得不方便？也告訴我們怎麼改會更好。"
          }
        }
      }
    },
    "언제 바빠지는지 미리 알고 싶은 사람": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who want to know in advance when things get busy"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang ingin tahu lebih dulu kapan waktunya akan padat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ忙しくなるのかを先に知っておきたい人"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто хочет заранее знать, когда станет плотно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想提前知道哪天会忙起来的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想提前知道哪天會忙起來的人"
          }
        }
      }
    },
    "여기서 아무것도 수집하지 않습니다. 눌러야만 App Store 가 열립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is collected here. The App Store opens only when you tap."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dikumpulkan di sini. App Store hanya terbuka bila Anda menekannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは何も集めません。押したときだけApp Storeが開きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не собирается. App Store откроется, только если нажать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不收集任何东西。只有你点了，App Store 才会打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡不收集任何東西。只有你點了，App Store 才會開啟。"
          }
        }
      }
    },
    "열 군데에 비슷한 서류를 넣어야 하는 하루.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day of sending near-identical documents to ten places."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu hari mengirim berkas serupa ke sepuluh tempat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じような書類を十か所に出す一日。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, когда почти одинаковые бумаги уходят в десять мест."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要往十个地方投递差不多材料的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要往十個地方投遞差不多材料的一天。"
          }
        }
      }
    },
    "오른쪽으로 밀면 완료 표시(이 기기에만 저장돼요), 왼쪽으로 밀면 삭제. 삭제는 CloudKit admin 역할에 쓰기 권한이 있어야 반영돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to mark as done (saved on this device only), swipe left to delete. Delete requires write permission on the CloudKit admin role."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke kanan untuk menandai selesai (disimpan hanya di perangkat ini), geser ke kiri untuk menghapus. Menghapus memerlukan izin tulis pada peran admin CloudKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右にスワイプで完了（この端末にのみ保存）、左にスワイプで削除。削除はCloudKit adminロールの書き込み権限が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑标为已处理（只存在这台设备上），左滑删除。删除需要 CloudKit admin 角色有写入权限才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑標為已處理（只存在這台裝置上），左滑刪除。刪除需要 CloudKit admin 角色有寫入權限才會生效。"
          }
        }
      }
    },
