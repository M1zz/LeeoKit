          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellan vilka enheter, och vad stämmer inte?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างเครื่องไหนบ้าง และอะไรที่ไม่ตรงกัน"
