    "자주 쓰는 문장을 키보드에서 바로 꺼낸다": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádky, které píšete pořád dokola, vytáhnete přímo z klávesnice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent de linjer, du skriver igen og igen, direkte fra tastaturet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol die Zeilen, die du immer wieder tippst, direkt über die Tastatur hervor"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγάλτε τις φράσεις που γράφετε ξανά και ξανά, κατευθείαν από το πληκτρολόγιο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull up the lines you type again and again, right from the keyboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca las frases que escribes una y otra vez, directamente desde el teclado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Usein kirjoittamasi rivit suoraan näppäimistöltä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites apparaître les phrases que vous tapez sans cesse, directement depuis le clavier"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang sering dipakai, langsung dari papan ketik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiama le frasi che scrivi di continuo, direttamente dalla tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う文章をキーボードからすぐ取り出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 문장을 키보드에서 바로 꺼낸다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent fram linjene du skriver om og om igjen, rett fra tastaturet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal de zinnen die je steeds opnieuw typt direct vanaf het toetsenbord tevoorschijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdania, które wpisujesz w kółko, prosto z klawiatury"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chame as frases que você digita toda hora, direto do teclado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто набираемые фразы, прямо с клавиатуры"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fram raderna du skriver om och om igen, direkt från tangentbordet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกประโยคที่ใช้บ่อยออกมาจากแป้นพิมพ์ได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar tekrar yazdığınız satırları doğrudan klavyeden çağırın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy ngay từ bàn phím những câu bạn gõ đi gõ lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常用的句子，直接从键盘取出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常用的句子，直接從鍵盤取出"
          }
        }
      }
    },
    "적어 둔 것을 잃지 않고, 약속한 시각을 넘기지 않습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neztratíte, co jste si poznamenali, a nepřetáhnete slíbenou hodinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du mister ikke det, du har skrevet ned, og du overskrider ikke det tidspunkt, du har lovet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verlierst nichts, was du notiert hast, und überschreitest keine zugesagte Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν χάνετε ό,τι σημειώσατε και δεν ξεπερνάτε την ώρα που υποσχεθήκατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not lose what you noted, and you do not pass the hour you promised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pierdes lo que anotaste y no te pasas de la hora que prometiste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanot eivät katoa, eikä sovittu kellonaika mene ohi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne perdez pas ce que vous avez noté, et vous ne dépassez pas l’heure promise."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sudah dicatat tidak hilang, dan waktu yang dijanjikan tidak terlewat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non perdi quello che hai annotato e non superi l’ora che hai promesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "控えたものを失わず、約束の時刻も過ぎません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어 둔 것을 잃지 않고, 약속한 시각을 넘기지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du mister ikke det du har notert, og du går ikke over tidspunktet du lovet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verliest niets van wat je hebt genoteerd en je gaat nooit over het afgesproken tijdstip heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie gubisz tego, co zanotowałeś, i nie przekraczasz obiecanej godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não perde o que anotou e não passa da hora que prometeu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанное не теряется, а обещанный час не проходит."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tappar inte bort det du har antecknat, och du missar inte tiden du har lovat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทำสิ่งที่จดไว้หาย และไม่เลยเวลาที่สัญญาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not aldığınızı kaybetmez, söz verdiğiniz saati de geçirmezsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mất những gì đã ghi, không trễ giờ đã hẹn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下的东西不会丢，约好的时间也不会过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記下的東西不會丟，約好的時間也不會過。"
          }
        }
      }
    },
    "전송에 실패했어요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání se nezdařilo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden fehlgeschlagen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή απέτυχε"
          }
        },
        "en": {
