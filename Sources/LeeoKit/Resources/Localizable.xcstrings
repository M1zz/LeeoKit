    "예) 적던 것이 그대로 남아 있어야 해요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. Rozepsaný text tam měl zůstat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fx: Det, jeg skrev, burde stadig være der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Mein Text hätte noch da sein sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Ό,τι έγραψα θα έπρεπε να είναι ακόμη εκεί."
