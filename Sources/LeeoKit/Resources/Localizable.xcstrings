    "%@를 즐겁게 쓰고 계신가요?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baví vás %@?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du glad for %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir %@?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σας αρέσει το %@;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you enjoying %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te está gustando %@?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko %@ ollut mieluisa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aimez utiliser %@ ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda menikmati %@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti piace usare %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を楽しくお使いいただけていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 즐겁게 쓰고 계신가요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liker du %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je %@ fijn om te gebruiken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy podoba Ci się %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está gostando do %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам нравится %@?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gillar du %@?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณชอบใช้ %@ ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasından memnun musunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thích dùng %@ không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 用得还开心吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 用得還開心嗎？"
          }
        }
      }
    },
    "5분이 비었는데 무엇부터 할지 모를 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se uvolní pět minut a nevíte, čím začít"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du får fem ledige minutter og ikke kan beslutte, hvad du skal starte på"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn fünf Minuten frei werden und du nicht weißt, womit du anfangen sollst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ελευθερώνονται πέντε λεπτά και δεν ξέρετε με τι να ξεκινήσετε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When five minutes open up and you cannot decide what to start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se abren cinco minutos y no sabes por dónde empezar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun viisi minuuttia vapautuu etkä tiedä, mistä aloittaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cinq minutes se libèrent et que vous ne savez pas par quoi commencer"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ada lima menit kosong tetapi bingung mulai dari mana"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si liberano cinque minuti e non sai da cosa cominciare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分空いたのに、何から始めるか決められないとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분이 비었는데 무엇부터 할지 모를 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du får fem ledige minutter og ikke vet hva du skal begynne med"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je vijf minuten over hebt en niet weet waar je moet beginnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy masz wolne pięć minut i nie wiesz, od czego zacząć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando surgem cinco minutos livres e você não sabe por onde começar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда освободились пять минут, а с чего начать, непонятно"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När fem minuter blir lediga och du inte vet vad du ska börja med"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีเวลาว่าง 5 นาทีแต่ไม่รู้จะเริ่มอะไรก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş dakikanız boşaldığında ama nereden başlayacağınızı bilemediğinizde"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có năm phút rảnh mà không biết bắt đầu từ đâu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空出五分钟，却不知道先做什么时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空出五分鐘，卻不知道先做什麼時"
          }
        }
      }
    },
