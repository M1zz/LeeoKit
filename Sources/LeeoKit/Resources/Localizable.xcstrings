    "다음 주에 약속을 하나 더 넣어도 되는지 가늠할 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když zvažujete, jestli se příští týden vejde ještě jedna schůzka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vurderer, om der er plads til én aftale mere i næste uge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du abschätzt, ob nächste Woche noch Platz für einen weiteren Termin ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κρίνετε αν η επόμενη εβδομάδα χωράει άλλο ένα ραντεβού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are judging whether next week has room for one more plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando calculas si la semana que viene tiene hueco para un plan más"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun mietit, mahtuuko ensi viikolle vielä yksi meno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous vous demandez si la semaine prochaine peut accueillir un rendez-vous de plus"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menimbang apakah pekan depan masih muat satu janji lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando valuti se la prossima settimana ha spazio per un altro impegno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "来週にもう一件入れても大丈夫か見極めたいとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 주에 약속을 하나 더 넣어도 되는지 가늠할 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vurderer om neste uke har plass til én avtale til"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je inschat of er volgende week nog ruimte is voor nog een afspraak"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy oceniasz, czy w przyszłym tygodniu zmieści się jeszcze jedno spotkanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você avalia se a próxima semana tem espaço para mais um compromisso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда прикидываете, влезет ли на следующей неделе ещё одна встреча"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du bedömer om nästa vecka har plats för ett åtagande till"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อกำลังดูว่าสัปดาห์หน้ายังเพิ่มนัดได้อีกไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek haftaya bir plan daha sığıp sığmayacağını tartarken"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn cân nhắc tuần sau còn chỗ cho thêm một cuộc hẹn không"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掂量下周还能不能再加一个约时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掂量下周還能不能再加一個約時"
          }
        }
      }
    },
