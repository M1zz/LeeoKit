    "앱에서 '선물 코드 입력'을 열고 코드를 넣으면 바로 Pro가 열려요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikaci otevřete „Zadat dárkový kód“ a zadejte kód. Pro se hned odemkne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn »Indløs gavekode« i appen, og indtast koden for at låse Pro op med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in der App „Geschenkcode eingeben“ und gib den Code ein, dann wird Pro sofort freigeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την «Εξαργύρωση κωδικού δώρου» στην εφαρμογή και βάλτε τον κωδικό για να ξεκλειδώσει αμέσως το Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open 'Redeem Gift Code' in the app and enter the code to unlock Pro right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre «Canjear código de regalo» en la app e introduce el código para desbloquear Pro al instante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa apissa ”Lunasta lahjakoodi” ja syötä koodi, niin Pro avautuu heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’app, ouvrez « Saisir un code cadeau » et entrez le code pour débloquer Pro immédiatement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka “Tukarkan Kode Hadiah” di app dan masukkan kodenya untuk langsung membuka Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri «Riscatta codice regalo» nell’app e inserisci il codice per sbloccare subito Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリで「ギフトコードを入力」を開いてコードを入れると、すぐにProが使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 '선물 코드 입력'을 열고 코드를 넣으면 바로 Pro가 열려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne «Løs inn gavekode» i appen og skriv inn koden for å låse opp Pro med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open 'Cadeaucode invoeren' in de app en vul de code in om Pro meteen te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz w aplikacji „Wpisz kod prezentu” i wpisz kod, a Pro od razu się odblokuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra “Resgatar código de presente” no app e digite o código para liberar o Pro na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте в приложении «Ввести код подарка» и введите код, и Pro откроется сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna ”Lös in presentkod” i appen och ange koden för att låsa upp Pro direkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด “ใส่รหัสของขวัญ” ในแอปแล้วใส่รหัส Pro จะปลดล็อกทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada “Hediye kodu gir” bölümünü açıp kodu girin, Pro hemen açılsın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở “Nhập mã quà tặng” trong ứng dụng và nhập mã để mở Pro ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 中打开“输入礼品码”并输入礼品码，即可立即解锁 Pro。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 中開啟「輸入禮物碼」並輸入代碼，就能立即解鎖 Pro。"
          }
        }
      }
    },
    "연결이 불안정해요. 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení je nestabilní. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen er ustabil. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung ist instabil. Bitte versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση είναι ασταθής. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is unstable. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión es inestable. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys on epävakaa. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est instable. Réessayez dans un instant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi tidak stabil. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è instabile. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が不安定です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 불안정해요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingen er ustabil. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding is instabiel. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie jest niestabilne. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão está instável. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь нестабильна. Попробуйте чуть позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen är instabil. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อไม่เสถียร โปรดลองใหม่อีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı dengesiz. Lütfen birazdan tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối không ổn định. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不稳定，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線不穩定，請稍後再試。"
          }
        }
      }
    },
    "이 선물은 확인할 수 없어요. 보낸 분께 문의해 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento dárek nelze ověřit. Obraťte se na odesílatele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaven kan ikke bekræftes. Kontakt afsenderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Geschenk kann nicht überprüft werden. Bitte wende dich an die Person, die es gesendet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η επαλήθευση αυτού του δώρου. Επικοινωνήστε με τον αποστολέα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This gift can't be verified. Please contact the sender."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede verificar este regalo. Contacta con quien te lo envió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahjaa ei voida vahvistaa. Ota yhteyttä lähettäjään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier ce cadeau. Contactez la personne qui l’a envoyé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadiah ini tidak dapat diverifikasi. Hubungi pengirimnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare questo regalo. Contatta chi te l’ha inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このギフトは確認できません。送った人にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선물은 확인할 수 없어요. 보낸 분께 문의해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaven kan ikke bekreftes. Kontakt avsenderen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit cadeau kan niet worden gecontroleerd. Neem contact op met de afzender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować tego prezentu. Skontaktuj się z nadawcą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar este presente. Fale com quem enviou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подарок. Свяжитесь с отправителем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenten kan inte verifieras. Kontakta den som skickade den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตรวจสอบของขวัญนี้ได้ โปรดติดต่อผู้ส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hediye doğrulanamıyor. Lütfen gönderen kişiyle iletişime geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
