    "아이폰에서 모은 문장이 iCloud 로 맥에 따라옵니다. 메뉴바 아이콘이나 전역 단축키로 어느 앱에서든 꺼내 붙여넣습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádky uložené v iPhonu vás přes iCloud následují na Mac. V jakékoli aplikaci je vyvoláte ikonou v řádku nabídek nebo globální klávesovou zkratkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linjer, du har gemt på iPhone, følger med til Mac'en via iCloud. Hent dem frem fra symbolet i menulinjen eller med en global tastaturgenvej i enhver app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen, die du auf dem iPhone gespeichert hast, folgen dir über iCloud auf den Mac. Hol sie in jeder App über das Menüleistensymbol oder ein globales Tastenkürzel hervor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φράσεις που αποθηκεύσατε στο iPhone σάς ακολουθούν στο Mac μέσω iCloud. Βγάλτε τις από το εικονίδιο της γραμμής μενού ή με καθολική συντόμευση σε οποιαδήποτε εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines you saved on iPhone follow you to the Mac over iCloud. Pull them up from the menu bar icon or a global hotkey in any app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frases que guardaste en el iPhone te siguen al Mac por iCloud. Sácalas desde el icono de la barra de menús o con un atajo global en cualquier app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonella tallentamasi rivit seuraavat iCloudin kautta Macille. Ota ne esiin valikkorivin kuvakkeesta tai yleisellä pikanäppäimellä missä tahansa apissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les phrases enregistrées sur l’iPhone vous suivent sur le Mac via iCloud. Faites-les apparaître depuis l’icône de la barre des menus ou un raccourci global, dans n’importe quelle app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang Anda kumpulkan di iPhone ikut ke Mac lewat iCloud. Ambil dari ikon bilah menu atau pintasan global di aplikasi mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe che hai salvato su iPhone ti seguono sul Mac tramite iCloud. Richiamale dall’icona nella barra dei menu o con una scorciatoia globale in qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでためた文章がiCloudでMacにも届きます。メニューバーのアイコンかグローバルショートカットで、どのアプリでも取り出して貼り付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이폰에서 모은 문장이 iCloud 로 맥에 따라옵니다. 메뉴바 아이콘이나 전역 단축키로 어느 앱에서든 꺼내 붙여넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekster du har lagret på iPhone, følger deg til Macen via iCloud. Hent dem fram i hvilken som helst app fra symbolet i menylinjen eller med en global hurtigtast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinnen die je op je iPhone hebt bewaard, volgen je via iCloud naar de Mac. Haal ze in elke app tevoorschijn via het menubalksymbool of een algemene sneltoets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdania zapisane w iPhonie trafiają przez iCloud na Maca. Wyciągasz je w dowolnej aplikacji z ikony na pasku menu albo globalnym skrótem klawiszowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As frases que você salvou no iPhone acompanham você até o Mac pelo iCloud. Chame-as pelo ícone na barra de menus ou por um atalho global, em qualquer app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фразы, собранные на iPhone, приходят на Mac через iCloud. Достаньте их из значка в строке меню или по глобальному сочетанию клавиш в любом приложении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rader du har sparat på iPhone följer med till Macen via iCloud. Ta fram dem i vilken app som helst med symbolen i menyraden eller ett globalt kortkommando."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประโยคที่เก็บไว้บน iPhone จะตามไปที่ Mac ผ่าน iCloud เรียกออกมาวางได้ในทุกแอปจากไอคอนแถบเมนูหรือปุ่มลัดส่วนกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da kaydettiğiniz satırlar iCloud ile Mac'inize gelir. Herhangi bir uygulamada menü çubuğu simgesinden ya da genel bir klavye kısayoluyla çağırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những câu bạn lưu trên iPhone theo bạn sang Mac qua iCloud. Lấy ra từ biểu tượng trên thanh menu hoặc phím tắt toàn cục trong mọi ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上攒下的句子会通过 iCloud 跟到 Mac。用菜单栏图标或全局快捷键，在任何应用里都能取出来粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上攢下的句子會透過 iCloud 跟到 Mac。用菜單欄圖標或全域快速鍵，在任何應用裡都能取出來貼上。"
          }
        }
      }
    },
    "아직 접수된 피드백이 없어요": {
      "localizations": {
