    "같은 목록을 나눠 쓰도록 함께 만든 앱입니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vznikly spolu, aby sdílely jeden seznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udviklet sammen til at dele den samme liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam entwickelt, um dieselbe Liste zu teilen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάχτηκαν μαζί για να μοιράζονται την ίδια λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built together to share the same list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creadas juntas para compartir la misma lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehty yhdessä jakamaan sama lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçues ensemble pour partager la même liste."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat bersama untuk berbagi daftar yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Create insieme per condividere lo stesso elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じリストを分け合って使うために一緒に作られたアプリです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 목록을 나눠 쓰도록 함께 만든 앱입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laget sammen for å dele den samme listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samen gemaakt om dezelfde lijst te delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbudowane razem, by korzystać z tej samej listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criados juntos para compartilhar a mesma lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделано вместе, чтобы делить один и тот же список."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggda tillsammans för att dela samma lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างมาด้วยกันเพื่อใช้รายการเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı listeyi paylaşmak için birlikte geliştirildi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được làm cùng nhau để dùng chung một danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为共用同一份清单而一同打造的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為共用同一份清單而一同打造的 App。"
          }
        }
      }
    },
