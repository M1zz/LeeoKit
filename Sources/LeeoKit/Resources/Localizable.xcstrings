    "어느 기기 사이에서, 무엇이 안 맞나요?": {
      "comment": "Sync prompt: which devices and what",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi kterými zařízeními a co nesedí?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellem hvilke enheder, og hvad passer ikke?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen welchen Geräten, und was stimmt nicht überein?"
          }
        },
        "el": {
