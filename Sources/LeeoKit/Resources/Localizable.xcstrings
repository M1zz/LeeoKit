    "이미 모든 기능을 쓰고 계신다면, 여기서 조금 더 응원할 수 있어요. 혼자 만드는 앱이라 한 번 한 번이 다음 업데이트를 만드는 힘이 돼요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud už používáte všechny funkce, můžete tu přispět trochu víc. Tuto aplikaci dělá jeden člověk, takže každý příspěvek se promění v další aktualizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du allerede bruger alle funktioner, kan du give lidt ekstra her. Én person laver denne app, så hvert bidrag bliver til næste opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du schon alle Funktionen nutzt, kannst du hier etwas mehr geben. Eine Person entwickelt diese App, jede Unterstützung fließt ins nächste Update."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν χρησιμοποιείς ήδη όλες τις λειτουργίες, μπορείς να στηρίξεις λίγο ακόμα εδώ. Την εφαρμογή τη φτιάχνει ένας άνθρωπος, οπότε κάθε στήριξη γίνεται η επόμενη ενημέρωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you already use every feature, you can give a little more here. One person builds this app, so every tip goes into the next update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya usas todas las funciones, aquí puedes apoyar un poco más. Una sola persona hace esta app, así que cada aporte se convierte en la próxima actualización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytät jo kaikkia ominaisuuksia, voit tukea täällä vähän enemmän. Sovellusta tekee yksi ihminen, joten jokainen tuki muuttuu seuraavaksi päivitykseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous utilisez déjà toutes les fonctionnalités, vous pouvez donner un peu plus ici. Une seule personne développe cette app, chaque soutien finance la prochaine mise à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda sudah memakai semua fitur, di sini Anda bisa mendukung sedikit lebih. App ini dibuat oleh satu orang, jadi setiap dukungan menjadi pembaruan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usi già tutte le funzioni, qui puoi dare un po' di più. Questa app la fa una persona sola, ogni contributo diventa il prossimo aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにすべての機能をお使いなら、ここでもう少し応援できます。ひとりで作っているアプリなので、一回一回が次のアップデートの力になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 모든 기능을 쓰고 계신다면, 여기서 조금 더 응원할 수 있어요. 혼자 만드는 앱이라 한 번 한 번이 다음 업데이트를 만드는 힘이 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du allerede bruker alle funksjonene, kan du gi litt ekstra her. Én person lager denne appen, så hvert bidrag blir neste oppdatering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je al alle functies, dan kun je hier wat extra steunen. Eén persoon maakt deze app, dus elke bijdrage gaat naar de volgende update."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli korzystasz już ze wszystkich funkcji, możesz tu wesprzeć trochę bardziej. Tę aplikację tworzy jedna osoba, więc każde wsparcie zamienia się w kolejną aktualizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você já usa todos os recursos, pode apoiar um pouco mais aqui. Uma só pessoa faz este app, então cada apoio vira a próxima atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы уже пользуетесь всеми функциями, здесь можно поддержать чуть больше. Приложение делает один человек, и каждая поддержка помогает выпустить следующее обновление."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du redan använder alla funktioner kan du ge lite extra här. En person gör den här appen, så varje bidrag blir nästa uppdatering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณใช้ทุกฟีเจอร์อยู่แล้ว ก็สนับสนุนเพิ่มอีกนิดได้ที่นี่ แอปนี้ทำโดยคนคนเดียว ทุกการสนับสนุนจะกลายเป็นอัปเดตถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm özellikleri zaten kullanıyorsanız burada biraz daha destek olabilirsiniz. Bu uygulamayı tek kişi geliştiriyor, her destek bir sonraki güncellemeye dönüşüyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đã dùng mọi tính năng, bạn có thể ủng hộ thêm một chút ở đây. Ứng dụng do một người làm, mỗi lần ủng hộ sẽ thành bản cập nhật tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你已经在用全部功能，可以在这里多支持一点。这个 App 由一个人开发，每一次支持都会化作下一次更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你已經在用全部功能，可以在這裡多支持一點。這個 App 由一個人開發，每一次支持都會化作下一次更新。"
          }
        }
      }
    },
    "고마워요! 큰 힘이 돼요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Děkuji! Moc to pomáhá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak! Det betyder meget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! Das bedeutet mir viel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστώ! Σημαίνει πολλά."
          }
        },
