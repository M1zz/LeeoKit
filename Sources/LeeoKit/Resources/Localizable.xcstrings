    "마감 직전에야 알아차려 곤란했던 사람": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die schon einmal eine Frist zu spät bemerkt haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who have been caught out by noticing a deadline too late"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien se ha visto en apuros por darse cuenta de un plazo demasiado tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui se sont déjà fait surprendre par une échéance remarquée trop tard"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang pernah repot karena baru sadar menjelang tenggat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi si è trovato in difficoltà accorgendosi di una scadenza troppo tardi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切り直前に気づいて困ったことがある人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 직전에야 알아차려 곤란했던 사람"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem já se complicou por perceber um prazo tarde demais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто уже попадал впросак, заметив срок слишком поздно"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่เคยลำบากเพราะเพิ่งรู้ตัวตอนใกล้กำหนดส่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người từng bối rối vì đến sát hạn chót mới nhận ra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾经临到截止才发现而手忙脚乱的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曾經臨到截止才發現而手忙腳亂的人"
          }
        }
      }
    },
    "마감이 있는 곳은 두번알림에 걸어 둡니다. 30분 전과 5분 전에 한 번 더 울립니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles mit einer Frist kommt in Rereminder. Es klingelt noch einmal dreißig Minuten und fünf Minuten vorher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anywhere with a deadline goes into Rereminder. It rings again thirty minutes before, and five minutes before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que tiene plazo va a Rereminder. Vuelve a sonar treinta minutos antes y cinco minutos antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui a une échéance va dans Rereminder. Il sonne à nouveau trente minutes avant, puis cinq minutes avant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang punya tenggat dititipkan ke Rereminder. Ia berbunyi lagi tiga puluh menit dan lima menit sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che ha una scadenza va in Rereminder. Suona di nuovo trenta minuti prima e cinque minuti prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りのあるところはRereminderに登録します。30分前と5分前にもう一度鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감이 있는 곳은 두번알림에 걸어 둡니다. 30분 전과 5분 전에 한 번 더 울립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que tem prazo vai para o Rereminder. Ele toca de novo trinta minutos antes e cinco minutos antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, у чего есть срок, уходит в Rereminder. Он звонит ещё раз за тридцать минут и за пять."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่มีกำหนดส่งให้ตั้งไว้ใน Rereminder จะดังอีกครั้งก่อน 30 นาทีและก่อน 5 นาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc nào có hạn chót thì đặt vào Rereminder. Nó reo thêm lần nữa trước ba mươi phút và trước năm phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止的地方交给 Rereminder。提前三十分钟和五分钟各响一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止的地方交給 Rereminder。提前三十分鐘和五分鐘各響一次。"
          }
        }
      }
    },
