            "value": "Khi cần lại thứ vừa sao chép lúc nãy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚复制过的内容，过一会儿又要用的时候"
          }
        },
        "zh-Hant": {
