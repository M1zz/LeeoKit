    "마감 직전에야 알아차려 곤란했던 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, které už zaskočil termín, jehož si všimli příliš pozdě"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der er blevet overrumplet af at opdage en deadline for sent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die schon einmal eine Frist zu spät bemerkt haben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι έχουν βρεθεί σε δύσκολη θέση επειδή πρόσεξαν μια προθεσμία πολύ αργά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who have been caught out by noticing a deadline too late"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien se ha visto en apuros por darse cuenta de un plazo demasiado tarde"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka ovat huomanneet määräajan liian myöhään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui se sont déjà fait surprendre par une échéance remarquée trop tard"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang pernah repot karena baru sadar menjelang tenggat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi si è trovato in difficoltà accorgendosi di una scadenza troppo tardi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切り直前に気づいて困ったことがある人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 직전에야 알아차려 곤란했던 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som har blitt tatt på senga av å oppdage en frist for sent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die al eens in de problemen kwamen omdat ze een deadline te laat zagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które zbyt późno zauważyły zbliżający się termin"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem já se complicou por perceber um prazo tarde demais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто уже попадал впросак, заметив срок слишком поздно"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som har råkat illa ut för att en deadline upptäcktes för sent"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่เคยลำบากเพราะเพิ่งรู้ตัวตอนใกล้กำหนดส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir son tarihi çok geç fark edip zor durumda kalmış olanlar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người từng bối rối vì đến sát hạn chót mới nhận ra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾经临到截止才发现而手忙脚乱的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曾經臨到截止才發現而手忙腳亂的人"
          }
        }
      }
    },
    "마감이 있는 곳은 두번알림에 걸어 둡니다. 30분 전과 5분 전에 한 번 더 울립니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechno s termínem jde do Rereminderu. Zazvoní ještě třicet minut a pět minut předem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt med en deadline kommer i Rereminder. Den ringer igen tredive minutter før og fem minutter før."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles mit einer Frist kommt in Rereminder. Es klingelt noch einmal dreißig Minuten und fünf Minuten vorher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι έχει προθεσμία μπαίνει στο Rereminder. Χτυπά ξανά τριάντα λεπτά πριν και πέντε λεπτά πριν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anywhere with a deadline goes into Rereminder. It rings again thirty minutes before, and five minutes before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que tiene plazo va a Rereminder. Vuelve a sonar treinta minutos antes y cinco minutos antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki, millä on määräaika, menee Rereminderiin. Se soi uudelleen puoli tuntia ja viisi minuuttia ennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui a une échéance va dans Rereminder. Il sonne à nouveau trente minutes avant, puis cinq minutes avant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang punya tenggat dititipkan ke Rereminder. Ia berbunyi lagi tiga puluh menit dan lima menit sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che ha una scadenza va in Rereminder. Suona di nuovo trenta minuti prima e cinque minuti prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りのあるところはRereminderに登録します。30分前と5分前にもう一度鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감이 있는 곳은 두번알림에 걸어 둡니다. 30분 전과 5분 전에 한 번 더 울립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt med en frist legges i Rereminder. Den ringer igjen tretti minutter før og fem minutter før."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles met een deadline gaat in Rereminder. Hij gaat nog een keer af, dertig minuten en vijf minuten van tevoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co ma termin, trafia do Rereminder. Dzwoni jeszcze raz trzydzieści minut i pięć minut wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que tem prazo vai para o Rereminder. Ele toca de novo trinta minutos antes e cinco minutos antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, у чего есть срок, уходит в Rereminder. Он звонит ещё раз за тридцать минут и за пять."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som har en deadline läggs in i Rereminder. Den ringer igen trettio minuter före och fem minuter före."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่มีกำหนดส่งให้ตั้งไว้ใน Rereminder จะดังอีกครั้งก่อน 30 นาทีและก่อน 5 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tarihi olan her şey Rereminder'a girer. Otuz dakika önce ve beş dakika önce bir kez daha çalar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc nào có hạn chót thì đặt vào Rereminder. Nó reo thêm lần nữa trước ba mươi phút và trước năm phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止的地方交给 Rereminder。提前三十分钟和五分钟各响一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有截止的地方交給 Rereminder。提前三十分鐘和五分鐘各響一次。"
          }
        }
      }
    },
