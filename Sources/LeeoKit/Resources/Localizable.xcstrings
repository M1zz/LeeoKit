    "의견을 들려주시면 더 좋은 앱으로 만들 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zpětná vazba nám pomáhá aplikaci zlepšovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din feedback hjælper os med at gøre appen bedre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Feedback hilft uns, die App besser zu machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σχόλιά σας μας βοηθούν να κάνουμε την εφαρμογή καλύτερη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps us make the app better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comentarios nos ayudan a mejorar la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautteesi auttaa meitä tekemään apista paremman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos commentaires nous aident à améliorer l’app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukan Anda membantu kami menyempurnakan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo feedback ci aiuta a migliorare l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見をいただけると、より良いアプリにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 들려주시면 더 좋은 앱으로 만들 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakemeldingen din hjelper oss med å gjøre appen bedre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met je feedback kunnen we de app beter maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja opinia pomoże nam ulepszyć aplikację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu feedback nos ajuda a melhorar o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш отзыв поможет сделать приложение лучше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din feedback hjälper oss att göra appen bättre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นของคุณช่วยให้เราพัฒนาแอปให้ดีขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildiriminiz uygulamayı daha iyi hâle getirmemize yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góp ý của bạn giúp chúng tôi làm ứng dụng tốt hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的想法告诉我们，这个 App 会变得更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的想法告訴我們，這個 App 會變得更好。"
          }
        }
      }
    },
    "이 기기에서는 설치할 수 없습니다. 스토어 페이지만 열립니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tohoto zařízení ji nelze nainstalovat. Otevře se jen stránka v obchodě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke installeres på denne enhed. Kun butikssiden åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät kann sie nicht installiert werden. Es öffnet sich nur die Store-Seite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορεί να εγκατασταθεί σε αυτήν τη συσκευή. Ανοίγει μόνο η σελίδα στο Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It cannot be installed on this device. Only the store page opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede instalar en este dispositivo. Solo se abre la página de la tienda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Appia ei voi asentaa tähän laitteeseen. Vain kaupan sivu avautuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de l’installer sur cet appareil. Seule la page de l’App Store s’ouvre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa dipasang di perangkat ini. Hanya halaman toko yang terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può essere installata su questo dispositivo. Si apre solo la pagina dello store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にはインストールできません。ストアのページだけが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 설치할 수 없습니다. 스토어 페이지만 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke installeres på denne enheten. Bare butikksiden åpnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt hem niet op dit apparaat installeren. Alleen de Store-pagina wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można jej zainstalować na tym urządzeniu. Otworzy się tylko strona w sklepie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível instalar neste dispositivo. Só a página da loja será aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве установить нельзя. Откроется только страница в магазине."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan inte installeras på den här enheten. Bara butikssidan öppnas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งในอุปกรณ์นี้ไม่ได้ จะเปิดเฉพาะหน้า Store เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıta yüklenemez. Yalnızca mağaza sayfası açılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cài đặt trên thiết bị này. Chỉ mở trang cửa hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备装不了。只会打开商店页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置裝不了。只會開啟商店頁面。"
          }
        }
      }
