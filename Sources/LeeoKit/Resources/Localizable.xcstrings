            "state": "needs_review",
            "value": "Type"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせの種類"
          }
        }
      }
    },
    "버그 신고": {
      "localizations": {
        "en": {
          "stringUnit": {
