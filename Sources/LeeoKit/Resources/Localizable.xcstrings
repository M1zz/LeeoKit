    "그 화면을 그대로 찍어 주세요. 번역이 어색하다면 어떻게 고치면 자연스러운지도 적어 주세요. 그대로 반영할게요.": {
      "comment": "Attachment how-to: broken screen",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořiďte snímek té obrazovky tak, jak je. Pokud překlad zní nepřirozeně, napište, jak by to znělo lépe. Opravíme to podle vás."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et skærmbillede af skærmen, som den er. Hvis oversættelsen lyder underlig, så skriv gerne, hvordan det burde stå. Vi retter det præcis sådan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache einfach ein Bildschirmfoto davon. Wenn eine Übersetzung seltsam klingt, schreib uns, wie es natürlicher wäre. Wir übernehmen das gern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε στιγμιότυπο της οθόνης όπως είναι. Αν η μετάφραση ακούγεται αφύσικη, γράψτε μας πώς θα ήταν πιο σωστό. Θα το διορθώσουμε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a screenshot of that screen as is. If a translation sounds off, let us know how it would read naturally, and we'll use your wording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de esa pantalla tal cual. Si una traducción suena rara, escríbenos cómo quedaría más natural. La aplicaremos tal cual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota kuvakaappaus näkymästä sellaisenaan. Jos käännös kuulostaa oudolta, kirjoita myös, miten se olisi luontevampi. Korjaamme sen juuri niin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites simplement une capture de cet écran. Si une traduction sonne mal, indiquez-nous comment la rendre plus naturelle. Nous l'appliquerons telle quelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil gambar layar itu apa adanya. Jika terjemahannya janggal, tuliskan juga versi yang lebih alami. Akan kami terapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai uno screenshot di quella schermata così com'è. Se una traduzione suona strana, scrivici come renderla più naturale. La useremo così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その画面をそのまま撮ってください。翻訳が不自然な場合は、どう直すと自然になるかも書いてください。そのまま反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 화면을 그대로 찍어 주세요. 번역이 어색하다면 어떻게 고치면 자연스러운지도 적어 주세요. 그대로 반영할게요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta et skjermbilde av skjermen slik den er. Hvis oversettelsen høres rar ut, skriv gjerne hvordan det burde stå. Vi endrer det akkurat slik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een schermafbeelding van dat scherm zoals het is. Is de vertaling vreemd, schrijf dan ook op hoe het natuurlijker klinkt. We nemen het zo over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób zrzut tego ekranu tak, jak wygląda. Jeśli tłumaczenie brzmi nienaturalnie, napisz, jak byłoby lepiej. Poprawimy to."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura dessa tela do jeito que está. Se a tradução estiver estranha, escreva como ficaria mais natural. Vamos usar sua sugestão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте снимок этого экрана как есть. Если перевод звучит неестественно, напишите, как было бы правильнее. Мы так и исправим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta en skärmavbild av skärmen som den är. Om översättningen låter konstig, skriv gärna hur det borde stå. Vi ändrar det precis så."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพหน้าจอนั้นมาได้เลย ถ้าคำแปลฟังดูแปลก ช่วยบอกด้วยว่าควรแก้อย่างไรให้เป็นธรรมชาติ เราจะนำไปใช้ตามนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O ekranın olduğu gibi görüntüsünü alın. Çeviri doğal durmuyorsa nasıl daha doğal olacağını da yazın. Aynen düzelteceğiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chụp nguyên màn hình đó. Nếu bản dịch nghe không tự nhiên, hãy ghi thêm cách sửa cho tự nhiên, chúng tôi sẽ cập nhật đúng như vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请直接截下那个画面。如果是翻译不通顺，也请写下怎么改更自然，我们会照着修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請直接截下那個畫面。如果是翻譯不通順，也請寫下怎麼改比較自然，我們會照著修改。"
          }
        }
      }
    },
    "앱을 지우고 다시 깔기 전에 먼저 보내 주세요. 지우면 이 기기에만 있던 데이터가 함께 사라져 되살릴 수 없어요.": {
      "comment": "Bug category caution: do not reinstall",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlášení odešlete dřív, než aplikaci smažete a znovu nainstalujete. Smazáním nenávratně zmizí data uložená jen v tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send dette, før du sletter og geninstallerer appen. Hvis du sletter den, forsvinder data, der kun findes på denne enhed, og de kan ikke gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte sende uns das, bevor du die App löschst und neu installierst. Beim Löschen gehen Daten, die nur auf diesem Gerät waren, unwiderruflich verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε την αναφορά πριν διαγράψετε και εγκαταστήσετε ξανά την εφαρμογή. Με τη διαγραφή, τα δεδομένα που υπάρχουν μόνο σε αυτή τη συσκευή χάνονται οριστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please send this before deleting and reinstalling the app. Deleting it also erases any data that was only on this device, and it can't be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanos esto antes de borrar y reinstalar la app. Si la borras, los datos que solo estaban en este dispositivo se perderán para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä tämä ennen kuin poistat sovelluksen ja asennat sen uudelleen. Poistaminen hävittää vain tällä laitteella olevat tiedot, eikä niitä voi palauttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-nous ceci avant de supprimer et réinstaller l'app. En la supprimant, les données présentes uniquement sur cet appareil seront perdues définitivement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim laporan ini sebelum menghapus dan memasang ulang app. Jika dihapus, data yang hanya ada di perangkat ini ikut hilang dan tidak bisa dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviacelo prima di eliminare e reinstallare l'app. Eliminandola, i dati presenti solo su questo dispositivo andranno persi per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを削除して入れ直す前に、まず送信してください。削除すると、この端末にしかなかったデータも一緒に消え、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 지우고 다시 깔기 전에 먼저 보내 주세요. 지우면 이 기기에만 있던 데이터가 함께 사라져 되살릴 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send dette før du sletter og installerer appen på nytt. Hvis du sletter den, forsvinner data som bare finnes på denne enheten, og de kan ikke gjenopprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur dit eerst, voordat je de app verwijdert en opnieuw installeert. Bij verwijderen gaan gegevens die alleen op dit toestel staan definitief verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij zgłoszenie, zanim usuniesz i ponownie zainstalujesz aplikację. Po usunięciu dane zapisane tylko na tym urządzeniu znikną bezpowrotnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie isto antes de apagar e reinstalar o app. Ao apagar, os dados que estavam só neste aparelho somem e não dá para recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте отчёт до того, как удалять и переустанавливать приложение. При удалении данные, хранившиеся только на этом устройстве, пропадут без возможности восстановления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka det här innan du raderar och installerar om appen. Om du raderar den försvinner data som bara finns på den här enheten, och den går inte att få tillbaka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดส่งรายงานนี้ก่อนลบแล้วติดตั้งแอปใหม่ เพราะถ้าลบแอป ข้อมูลที่มีอยู่แค่ในเครื่องนี้จะหายไปด้วยและกู้คืนไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı silip yeniden yüklemeden önce lütfen bunu gönderin. Silerseniz yalnızca bu cihazda olan veriler de kaybolur ve geri getirilemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy gửi báo cáo trước khi xóa và cài lại ứng dụng. Nếu xóa, dữ liệu chỉ có trên thiết bị này cũng sẽ mất theo và không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在删除并重新安装 App 之前先提交。一旦删除，只存在这台设备上的数据也会一起消失，无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在刪除並重新安裝 App 之前先送出。一旦刪除，只存在這台裝置上的資料也會一起消失，無法復原。"
          }
        }
      }
    },
    "구입할 때 쓴 Apple 계정으로 로그인해 있는지 먼저 봐 주세요. 결제는 그 계정에 묶여 있어요.": {
      "comment": "Bug category caution: same Apple account",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív zkontrolujte, že jste přihlášeni ke stejnému Apple účtu, ze kterého jste nakupovali. Nákupy jsou vázané na tento účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek først, at du er logget ind med den Apple-konto, du brugte ved købet. Købet er knyttet til den konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe zuerst, ob du mit dem Apple Account angemeldet bist, mit dem du gekauft hast. Käufe sind an diesen Account gebunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε πρώτα ότι έχετε συνδεθεί με τον ίδιο λογαριασμό Apple που χρησιμοποιήσατε για την αγορά. Οι αγορές συνδέονται με αυτόν τον λογαριασμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, check that you're signed in with the Apple Account you used to buy it. Purchases are tied to that account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero comprueba que hayas iniciado sesión con la cuenta de Apple con la que compraste. Las compras están vinculadas a esa cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista ensin, että olet kirjautunut sillä Apple-tilillä, jolla teit ostoksen. Ostos on sidottu siihen tiliin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez d'abord que vous êtes connecté avec le compte Apple utilisé pour l'achat. Les achats sont liés à ce compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan dulu Anda masuk dengan Akun Apple yang dipakai saat membeli. Pembelian terikat pada akun tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per prima cosa verifica di aver effettuato l'accesso con l'account Apple usato per l'acquisto. Gli acquisti sono legati a quell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、購入時に使ったApple Accountでサインインしているか確認してください。購入はそのアカウントに紐づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입할 때 쓴 Apple 계정으로 로그인해 있는지 먼저 봐 주세요. 결제는 그 계정에 묶여 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk først at du er logget på med Apple-kontoen du brukte da du kjøpte. Kjøpet er knyttet til den kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer eerst of je bent ingelogd met het Apple Account waarmee je de aankoop deed. De aankoop hoort bij dat account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw sprawdź, czy jesteś zalogowany na to samo konto Apple, na którym dokonano zakupu. Zakupy są przypisane do tego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro confira se você entrou com a Conta Apple usada na compra. As compras ficam vinculadas a essa conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала проверьте, что вы вошли в тот же Apple Account, с которого совершали покупку. Покупки привязаны к этой учётной записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera först att du är inloggad med det Apple-konto du köpte med. Köpet är kopplat till det kontot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดตรวจสอบก่อนว่าลงชื่อเข้าด้วยบัญชี Apple ที่ใช้ตอนซื้อ เพราะการซื้อผูกอยู่กับบัญชีนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce satın alırken kullandığınız Apple Hesabı ile giriş yapıp yapmadığınızı kontrol edin. Satın alımlar o hesaba bağlıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên, hãy kiểm tra bạn đã đăng nhập bằng Tài khoản Apple dùng lúc mua chưa. Giao dịch mua được gắn với tài khoản đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认登录的是购买时使用的 Apple 账户。购买项目是绑定在该账户上的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認登入的是購買時使用的 Apple 帳號。購買項目是綁定在該帳號上的。"
          }
        }
      }
    },
    "언제부터 그랬나요? (선택)": {
