    "탭하면 개발자에게 바로 전송됩니다": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um es direkt an den Entwickler zu senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to send directly to the developer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para enviarlo directamente al desarrollador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour envoyer directement au développeur"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mengirim langsung ke pengembang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per inviarlo direttamente allo sviluppatore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると開発者に直接送信されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 개발자에게 바로 전송됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para enviar direto ao desenvolvedor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы отправить разработчику напрямую"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อส่งถึงผู้พัฒนาโดยตรง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để gửi thẳng cho nhà phát triển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下就直接发给开发者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下就直接發給開發者"
          }
        }
      }
    },
    "폰과 맥을 오가며 같은 문장을 쓰는 사람": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die dieselben Zeilen auf iPhone und Mac verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who use the same lines across phone and Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien usa las mismas frases en el teléfono y en el Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui utilisent les mêmes phrases sur le téléphone et le Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang memakai kalimat yang sama di ponsel dan di Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi usa le stesse frasi tra telefono e Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとMacを行き来しながら同じ文章を使う人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰과 맥을 오가며 같은 문장을 쓰는 사람"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem usa as mesmas frases no celular e no Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто пользуется одними фразами и на телефоне, и на Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ใช้ประโยคเดียวกันทั้งบนโทรศัพท์และ Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng cùng những câu trên cả điện thoại và Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机和 Mac 之间来回、用同一批句子的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機和 Mac 之間來回、用同一批句子的人"
          }
        }
      }
    },
    "폰에서 모은 것을 맥에서 쓰고, 폰에서 쪼갠 것을 맥에서 짭니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf dem iPhone gesammelt hast, nutzt du auf dem Mac, und was du auf dem iPhone zerlegt hast, planst du auf dem Mac ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you gathered on the phone gets used on the Mac, and what you split on the phone gets laid out on the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que reuniste en el teléfono se usa en el Mac, y lo que dividiste en el teléfono se organiza en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez rassemblé sur le téléphone sert sur le Mac, et ce que vous avez découpé sur le téléphone s’organise sur le Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dikumpulkan di ponsel dipakai di Mac, yang dipecah di ponsel ditata di Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che raccogli sul telefono lo usi sul Mac, e quello che suddividi sul telefono lo organizzi sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでためたものをMacで使い、iPhoneで分けたものをMacで組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 모은 것을 맥에서 쓰고, 폰에서 쪼갠 것을 맥에서 짭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você juntou no celular é usado no Mac, e o que você dividiu no celular é organizado no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собранное на телефоне идёт в дело на Mac, а разбитое на телефоне раскладывается на Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่เก็บบนโทรศัพท์นำไปใช้บน Mac และสิ่งที่แบ่งบนโทรศัพท์นำไปจัดบน Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì gom trên điện thoại được dùng trên Mac, những gì chia trên điện thoại được sắp xếp trên Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上攒的在 Mac 上用，手机上拆的在 Mac 上排。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上攢的在 Mac 上用，手機上拆的在 Mac 上排。"
          }
        }
      }
    },
    "폰에서 저장한 것이 그대로 있으니 다시 옮겨 적을 일이 없습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du auf dem iPhone gespeichert hast, ist schon da, also musst du nichts zweimal tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you saved on the phone is already there, so nothing has to be typed twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que guardaste en el teléfono ya está ahí, así que no hay que escribir nada dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez enregistré sur le téléphone est déjà là : rien à retaper."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang tersimpan di ponsel sudah ada di sana, jadi tak perlu disalin ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che hai salvato sul telefono è già lì, quindi non devi riscrivere nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで保存したものがそのままあるので、書き写す手間がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰에서 저장한 것이 그대로 있으니 다시 옮겨 적을 일이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você salvou no celular já está lá, então nada precisa ser digitado duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённое на телефоне уже здесь, переписывать заново нечего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่บันทึกบนโทรศัพท์อยู่ครบ จึงไม่ต้องพิมพ์ซ้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì đã lưu trên điện thoại vẫn còn nguyên, nên không phải chép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上存的东西原样都在，不必再抄一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上存的東西原樣都在，不必再抄一遍。"
          }
        }
      }
    },
