    "답장을 보내지 못했어요. 답장 레코드 타입이 Production 에 배포됐는지 확인하세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď se nepodařilo odeslat. Zkontrolujte, že je typ záznamu pro odpovědi nasazený do Production."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kunne ikke sendes. Tjek, at posttypen for svar er implementeret i Production."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort konnte nicht gesendet werden. Prüfe, ob der Antwort-Datensatztyp in Production bereitgestellt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποστολή της απάντησης. Ελέγξτε ότι ο τύπος εγγραφής απάντησης έχει αναπτυχθεί στο Production."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send the reply. Check that the reply record type is deployed to Production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar la respuesta. Comprueba que el tipo de registro de respuesta esté desplegado en Production."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastausta ei voitu lähettää. Tarkista, että vastauksen tietuetyyppi on otettu käyttöön Productionissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer la réponse. Vérifiez que le type d'enregistrement de réponse est déployé en Production."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan gagal dikirim. Pastikan tipe rekaman balasan sudah di-deploy ke Production."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare la risposta. Verifica che il tipo di record della risposta sia distribuito in Production."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信を送れませんでした。返信のレコードタイプが Production にデプロイされているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장을 보내지 못했어요. 답장 레코드 타입이 Production 에 배포됐는지 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende svaret. Sjekk at posttypen for svar er distribuert til Production."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan antwoord niet versturen. Controleer of het recordtype voor antwoorden naar Production is uitgerold."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wysłać odpowiedzi. Sprawdź, czy typ rekordu odpowiedzi został wdrożony w środowisku Production."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar a resposta. Verifique se o tipo de registro de resposta foi implantado em Production."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить ответ. Проверьте, что тип записи ответа развёрнут в Production."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att skicka svaret. Kontrollera att posttypen för svar har driftsatts i Production."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งการตอบกลับไม่สำเร็จ ตรวจสอบว่าได้ deploy ประเภทเรคคอร์ดการตอบกลับไปที่ Production แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt gönderilemedi. Yanıt kayıt türünün Production ortamına dağıtıldığını kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gửi phản hồi. Hãy kiểm tra loại bản ghi phản hồi đã được triển khai lên Production chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复发送失败。请确认回复记录类型已部署到 Production。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆傳送失敗。請確認回覆記錄類型已部署到 Production。"
          }
        }
      }
    },
    "바꾸고 싶은 화면을 찍어 붙여 주시면 어디를 말씀하시는지 바로 알 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přiložte snímek obrazovky, kterou byste chtěli změnit, a hned uvidíme, co máte na mysli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedhæft et skærmbillede af den skærm, du gerne vil have ændret, så vi kan se præcis, hvad du mener."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänge einen Screenshot des Bildschirms an, den du ändern möchtest, dann sehen wir sofort, was du meinst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισυνάψτε ένα στιγμιότυπο της οθόνης που θέλετε να αλλάξει, ώστε να δούμε ακριβώς τι εννοείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a screenshot of the screen you'd like changed so we can see exactly what you mean."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta una captura de la pantalla que quieres cambiar y sabremos al instante a qué te refieres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä kuvakaappaus näkymästä, jota haluaisit muuttaa, niin näemme heti, mitä tarkoitat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez une capture de l’écran à modifier pour que nous voyions tout de suite de quoi vous parlez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan tangkapan layar yang ingin diubah agar kami langsung tahu maksud Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega uno screenshot della schermata da cambiare e capiremo subito a cosa ti riferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変えてほしい画面のスクリーンショットを添えていただくと、どこのことかすぐにわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꾸고 싶은 화면을 찍어 붙여 주시면 어디를 말씀하시는지 바로 알 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg ved et skjermbilde av skjermen du vil endre, så ser vi med en gang hva du mener."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een screenshot toe van het scherm dat je anders wilt, dan zien we meteen wat je bedoelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz zrzut ekranu, który chcesz zmienić, a od razu zobaczymy, o co Ci chodzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe uma captura da tela que você quer mudar e saberemos na hora do que está falando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложите снимок экрана, который хотите изменить, и мы сразу поймём, о чём речь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifoga en skärmbild av skärmen du vill ändra, så ser vi direkt vad du menar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบภาพหน้าจอที่อยากให้เปลี่ยน เพื่อให้เราเห็นได้ทันทีว่าหมายถึงตรงไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirilmesini istediğiniz ekranın görüntüsünü ekleyin; neyi kastettiğinizi hemen görelim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đính kèm ảnh màn hình bạn muốn thay đổi để chúng tôi hiểu ngay bạn đang nói về chỗ nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上想要修改的界面截图，我们就能立刻明白您指的是哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上想要修改的畫面截圖，我們就能立刻明白您指的是哪裡。"
          }
        }
      }
    },
