    "시험 코드라 Pro는 열리지 않아요. 같은 코드를 다시 넣으면 이미 받은 선물로 나와야 맞아요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to testovací kód, takže se Pro neodemkne. Když stejný kód zadáte znovu, mělo by se ukázat, že dárek už byl uplatněn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en testkode, så Pro låses ikke op. Indtaster du samme kode igen, skal der stå, at gaven allerede er indløst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Testcode, Pro wird also nicht freigeschaltet. Gibst du denselben Code noch einmal ein, sollte das Geschenk als bereits eingelöst gelten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι δοκιμαστικός κωδικός, οπότε το Pro δεν ξεκλειδώνει. Αν βάλετε ξανά τον ίδιο κωδικό, πρέπει να εμφανιστεί ότι το δώρο έχει ήδη εξαργυρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a test code, so Pro stays locked. Enter the same code again and it should say the gift was already redeemed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un código de prueba, así que Pro no se desbloquea. Si vuelves a ingresar el mismo código, debería decir que el regalo ya se canjeó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on testikoodi, joten Pro ei avaudu. Jos syötät saman koodin uudelleen, lahjan pitäisi näkyä jo lunastettuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un code de test, Pro n’est donc pas débloqué. Si vous saisissez à nouveau le même code, le cadeau doit apparaître comme déjà utilisé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini kode uji coba, jadi Pro tidak terbuka. Jika kode yang sama dimasukkan lagi, seharusnya muncul bahwa hadiah sudah ditukarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un codice di prova, quindi Pro non si sblocca. Se inserisci di nuovo lo stesso codice, dovrebbe risultare già riscattato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストコードなので Pro は開きません。同じコードをもう一度入れると、受け取り済みと表示されれば正常です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시험 코드라 Pro는 열리지 않아요. 같은 코드를 다시 넣으면 이미 받은 선물로 나와야 맞아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en testkode, så Pro låses ikke opp. Skriver du inn samme kode igjen, skal det stå at gaven allerede er løst inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een testcode, dus Pro wordt niet ontgrendeld. Voer je dezelfde code opnieuw in, dan hoort te staan dat het cadeau al is ingewisseld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To kod testowy, więc Pro się nie odblokuje. Po ponownym wpisaniu tego samego kodu powinien pojawić się komunikat, że prezent został już odebrany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um código de teste, então o Pro não é liberado. Se você digitar o mesmo código de novo, deve aparecer que o presente já foi resgatado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это тестовый код, Pro не откроется. Если ввести тот же код ещё раз, должно появиться, что подарок уже получен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en testkod, så Pro låses inte upp. Anger du samma kod igen ska det stå att presenten redan har lösts in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เป็นรหัสทดสอบ จึงไม่ปลดล็อก Pro ถ้าใส่รหัสเดิมอีกครั้ง ควรขึ้นว่ารับของขวัญไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir test kodu, Pro açılmaz. Aynı kodu tekrar girersen hediyenin zaten alındığı yazmalı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mã thử nghiệm nên Pro không được mở. Nhập lại cùng mã đó thì phải báo quà đã được nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是测试代码，不会开通 Pro。再次输入同一个代码时，应显示礼物已被领取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是測試代碼，不會開通 Pro。再次輸入同一個代碼時，應顯示禮物已被領取。"
          }
        }
      }
    },
