          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksu onnistui. Luomme lahjakoodin, kun yhteys palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est effectué. Le code cadeau sera créé dès que la connexion sera rétablie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran berhasil. Kode hadiah akan dibuat begitu kamu kembali online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento è andato a buon fine. Creeremo il codice regalo appena tornerai online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いは完了しています。接続が戻ったらギフトコードを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 됐어요. 연결되면 선물 코드를 만들어 드릴게요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen er fullført. Vi lager gavekoden når du er tilkoblet igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling is gelukt. Zodra je weer online bent, maken we de cadeaucode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność przeszła. Utworzymy kod prezentu, gdy połączenie wróci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento foi feito. Vamos criar o código de presente assim que você voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата прошла. Код подарка будет создан, когда появится связь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalningen är klar. Vi skapar presentkoden när du är ansluten igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชำระเงินเรียบร้อยแล้ว เราจะสร้างรหัสของขวัญเมื่อเชื่อมต่อได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme tamamlandı. Bağlantı gelince hediye kodunu oluşturacağız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thanh toán xong. Chúng tôi sẽ tạo mã quà tặng khi có kết nối trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已付款成功。联网后会为你生成礼品码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已付款成功。連上網路後會為你產生禮物碼。"
          }
        }
      }
    },
    "결제는 보내는 분이 하고, Pro는 받는 분이 써요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platíte vy, Pro dostane obdarovaný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du betaler, og modtageren får Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bezahlst, die andere Person bekommt Pro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εσείς πληρώνετε και ο παραλήπτης παίρνει το Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pay, and they get Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú pagas y la otra persona disfruta de Pro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä maksat, ja saaja saa Pron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez, et c’est l’autre personne qui profite de Pro."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu yang bayar, penerima yang memakai Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghi tu, e Pro lo usa chi lo riceve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いは贈る人、Proを使うのは受け取る人です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 보내는 분이 하고, Pro는 받는 분이 써요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du betaler, og mottakeren får Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij betaalt, de ander krijgt Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty płacisz, a Pro dostaje ktoś inny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você paga, e a outra pessoa usa o Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платите вы, а Pro получает другой человек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du betalar, och mottagaren får Pro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นคนจ่าย ผู้รับได้ใช้ Pro"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödemeyi siz yaparsınız, Pro'yu alıcı kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thanh toán, người nhận dùng Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你付款，对方使用 Pro。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由你付款，對方使用 Pro。"
          }
        }
      }
    },
    "결제를 마치지 못했어요. 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup se nepodařilo dokončit. Zkuste to později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet kunne ikke gennemføres. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Bitte versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά δεν ολοκληρώθηκε. Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn't be completed. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra. Inténtalo de nuevo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu viedä loppuun. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas pu aboutir. Réessayez plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian tidak dapat diselesaikan. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’acquisto. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제를 마치지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet kunne ikke fullføres. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop kon niet worden voltooid. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć zakupu. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a compra. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить покупку. Попробуйте позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet kunde inte slutföras. Försök igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการซื้อไม่สำเร็จ โปรดลองใหม่ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlanamadı. Lütfen daha sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tất giao dịch. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成购买，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成購買，請稍後再試。"
          }
        }
      }
    },
    "메시지로 코드와 앱 링크를 보내 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlete kód a odkaz na aplikaci ve zprávě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send koden og linket til appen i en besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende den Code und den App-Link per Nachricht."
          }
        },
        "el": {
