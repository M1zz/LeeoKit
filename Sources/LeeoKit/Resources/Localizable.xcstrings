    "보낸 사람의 앱 설정 > 보낸 의견에 그대로 보여요. 이메일이 없어도 닿아요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílatel ji uvidí beze změny ve své aplikaci v Nastavení > Odeslaná zpětná vazba. Dorazí i bez e-mailu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises uændret i afsenderens app under Indstillinger > Sendt feedback. Når frem, selv uden e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint unverändert in der App des Absenders unter Einstellungen > Gesendetes Feedback. Kommt auch ohne E-Mail an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται όπως είναι στην εφαρμογή του αποστολέα, στις Ρυθμίσεις > Απεσταλμένα σχόλια. Φτάνει ακόμη και χωρίς email."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown as-is in the sender's app under Settings > Sent Feedback. It reaches them even without an email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra tal cual en la app del remitente, en Ajustes > Comentarios enviados. Llega aunque no haya correo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy sellaisenaan lähettäjän apissa kohdassa Asetukset > Lähetetty palaute. Tavoittaa hänet ilman sähköpostiakin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’affiche tel quel dans l’app de l’expéditeur, sous Réglages > Avis envoyés. Arrive même sans e-mail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan apa adanya di aplikasi pengirim pada Pengaturan > Masukan Terkirim. Tetap sampai meski tanpa email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare così com'è nell'app del mittente in Impostazioni > Feedback inviati. Arriva anche senza email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者のアプリの 設定 > 送ったご意見 にそのまま表示されます。メールがなくても届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 사람의 앱 설정 > 보낸 의견에 그대로 보여요. 이메일이 없어도 닿아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises uendret i avsenderens app under Innstillinger > Sendte tilbakemeldinger. Kommer fram selv uten e-post."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt ongewijzigd getoond in de app van de afzender onder Instellingen > Verstuurde feedback. Komt ook aan zonder e-mailadres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczna bez zmian w aplikacji nadawcy w Ustawieniach > Wysłane opinie. Dociera nawet bez adresu e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece como está no app do remetente em Ajustes > Feedback enviado. Chega mesmo sem e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается как есть в приложении отправителя: Настройки > Отправленные отзывы. Дойдёт даже без e-mail."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas oförändrat i avsändarens app under Inställningar > Skickad feedback. Når fram även utan e-postadress."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตามนี้ในแอปของผู้ส่ง ที่ การตั้งค่า > ความคิดเห็นที่ส่งแล้ว ส่งถึงได้แม้ไม่มีอีเมล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderenin uygulamasında Ayarlar > Gönderilen Geri Bildirimler bölümünde olduğu gibi görünür. E-posta olmasa da ulaşır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị nguyên văn trong ứng dụng của người gửi tại Cài đặt > Góp ý đã gửi. Vẫn đến được người gửi dù không có email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
