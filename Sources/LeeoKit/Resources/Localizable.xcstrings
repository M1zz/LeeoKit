    "사용자가 의견을 남겼어요. 인박스에서 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A user left feedback. Check it in your inbox."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang pengguna meninggalkan masukan. Periksa di kotak masuk Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーからご意見が届きました。受信箱でご確認ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有用户留言了。到收件箱看看吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有使用者留言了。到收件匣看看吧。"
          }
        }
      }
    },
    "삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        }
      }
    },
    "상대가 확인해 주기로 한 시각은 두번알림에 겁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time the other side promised to confirm goes into Rereminder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu yang dijanjikan pihak lain untuk mengonfirmasi dititipkan ke Rereminder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が確認すると約束した時刻はRereminderに預けます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Час, к которому вторая сторона обещала ответить, уходит в Rereminder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方答应确认的时间点，交给 Rereminder。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方答應確認的時間點，交給 Rereminder。"
          }
        }
      }
    },
    "새 피드백 알림": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Feedback Alerts"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi Masukan Baru"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新着フィードバック通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新反馈提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新意見回饋提醒"
          }
        }
      }
    },
    "새 피드백이 도착했어요 📬": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New feedback arrived 📬"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukan baru tiba 📬"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいフィードバックが届きました 📬"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新反馈了 📬"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有新意見回饋了 📬"
          }
        }
      }
    },
    "새 피드백이 접수되면 이 기기로 푸시 알림이 와요. CloudKit admin 역할의 read 권한 설정 후에 동작해요.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a push notification on this device when new feedback arrives. Works after the CloudKit admin role's read permission is set up."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan notifikasi push di perangkat ini saat masukan baru tiba. Berfungsi setelah izin baca peran admin CloudKit disiapkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいフィードバックが届くとこのデバイスにプッシュ通知が届きます。CloudKit adminロールのread権限設定後に動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新反馈时会给这台设备发推送通知。需要先设置好 CloudKit admin 角色的 read 权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有新意見回饋時會給這台裝置發推送通知。需要先設定好 CloudKit admin 角色的 read 權限。"
          }
        }
      }
    },
    "서류가 오가는 오후": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An afternoon of paperwork"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sore yang penuh berkas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類が行き交う午後"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День бумаг"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件来回的下午"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案來回的下午"
          }
        }
      }
    },
    "서버에서 완전히 삭제되며 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be permanently deleted from the server and can't be undone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akan dihapus permanen dari server dan tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから完全に削除され、元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从服务器上彻底删除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會從服務器上徹底刪除，無法復原。"
          }
        }
      }
    },
    "손을 키보드에서 떼지 않고 붙여넣고 싶을 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you would rather not take your hands off the keyboard"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda tidak ingin melepas tangan dari papan ketik"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードから手を離さずに貼り付けたいとき"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда не хочется убирать руки с клавиатуры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不想把手从键盘上移开就完成粘贴时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不想把手從鍵盤上移開就完成貼上時"
          }
        }
      }
    },
    "시간을 재며 일하는 사람": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who work against the clock"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang bekerja sambil menghitung waktu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を計りながら働く人"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто работает по часам"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掐着时间工作的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掐著時間工作的人"
          }
        }
      }
    },
    "아쉬운 점이 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something could be better"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang bisa diperbaiki"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になる点があります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有点不满意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有點不滿意"
          }
        }
      }
    },
    "아이패드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
