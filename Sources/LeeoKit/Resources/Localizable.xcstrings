    "더 하실 말씀이 있으면 적어 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište cokoli dalšího, co nám chcete sdělit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv gerne, hvis der er mere, du vil fortælle os."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib gern alles dazu, was du uns noch sagen möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ό,τι άλλο θέλετε να μας πείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add anything else you would like to tell us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cualquier otra cosa que quieras contarnos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita, jos haluat kertoa meille vielä jotain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez tout ce que vous aimeriez nous dire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis apa saja yang masih ingin Anda sampaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualsiasi altra cosa vuoi dirci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに伝えたいことがあれば書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 하실 말씀이 있으면 적어 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv gjerne til oss om det er noe mer du vil fortelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf gerust alles op wat je ons nog wilt vertellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli chcesz nam coś jeszcze przekazać, napisz tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acrescente o que mais quiser nos contar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите, если хотите добавить что-то ещё."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv gärna allt annat du vill berätta för oss."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีอะไรอยากบอกเพิ่ม เขียนไว้ได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize söylemek istediğiniz başka bir şey varsa yazın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghi lại nếu bạn còn điều gì muốn nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果还有想说的，请写在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果還有想說的，請寫在這裡。"
          }
        }
      }
    },
