    "아직 접수된 피드백이 없어요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No feedback received yet"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada masukan yang diterima"
          }
        },
        "ja" : {
