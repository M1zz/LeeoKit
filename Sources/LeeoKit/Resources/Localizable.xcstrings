    "자주 쓰는 문장을 키보드에서 바로 꺼낸다": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol die Zeilen, die du immer wieder tippst, direkt über die Tastatur hervor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull up the lines you type again and again, right from the keyboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca las frases que escribes una y otra vez, directamente desde el teclado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites apparaître les phrases que vous tapez sans cesse, directement depuis le clavier"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang sering dipakai, langsung dari papan ketik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiama le frasi che scrivi di continuo, direttamente dalla tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う文章をキーボードからすぐ取り出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 문장을 키보드에서 바로 꺼낸다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
