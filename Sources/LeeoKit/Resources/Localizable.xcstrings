    "구매를 확인하지 못했어요. 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup se nepodařilo ověřit. Zkuste to prosím za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet kunne ikke bekræftes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht bestätigt werden. Bitte versuch es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση της αγοράς. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify the purchase. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar la compra. Vuelve a intentarlo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu vahvistaa. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier l’achat. Réessayez dans un instant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian tidak dapat diverifikasi. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’acquisto. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 확인하지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekrefte kjøpet. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de aankoop niet verifiëren. Probeer het zo meteen opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zakupu. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a compra. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить покупку. Попробуйте ещё раз чуть позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att verifiera köpet. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการซื้อไม่สำเร็จ โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma doğrulanamadı. Lütfen biraz sonra yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh giao dịch mua. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证此次购买，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證此次購買，請稍後再試。"
          }
        }
      }
    },
    "구매가 승인 대기 중이에요. 승인되면 자동으로 반영됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na schválení. Po schválení se projeví automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb venter på godkendelse. Det træder automatisk i kraft, når det er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Er wird automatisch wirksam, sobald er genehmigt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σας αναμένει έγκριση. Θα ισχύσει αυτόματα μόλις εγκριθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is waiting for approval. It'll apply automatically once approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Se aplicará automáticamente cuando se apruebe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostosi odottaa hyväksyntää. Se tulee voimaan automaattisesti, kun se on hyväksytty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d’approbation. Il s’appliquera automatiquement une fois approuvé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian Anda menunggu persetujuan. Akan otomatis diterapkan setelah disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Verrà applicato automaticamente una volta approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されると自動的に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 승인 대기 중이에요. 승인되면 자동으로 반영됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet venter på godkjenning. Det trer i kraft automatisk når det er godkjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wacht op goedkeuring. Hij wordt automatisch verwerkt zodra hij is goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup czeka na zatwierdzenie. Zostanie uwzględniony automatycznie po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. Ela será aplicada automaticamente assim que for aprovada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения. Она применится автоматически после подтверждения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande. Det träder i kraft automatiskt när det har godkänts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อกำลังรอการอนุมัติ จะมีผลโดยอัตโนมัติเมื่อได้รับอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işleminiz onay bekliyor. Onaylandığında otomatik olarak uygulanacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đang chờ phê duyệt. Sẽ tự động áp dụng khi được phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准，批准后会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買正在等待核准，核准後會自動生效。"
          }
        }
      }
    },
