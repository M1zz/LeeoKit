    "겹칠수록 진해지는 한 주, 지금 집을 수 있는 일": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Týden, který sytí tam, kde se věci překrývají, a ta jedna věc, do které se můžete pustit hned"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En uge, der bliver tættere, hvor den overlapper, og den ene ting, du kan tage fat på nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Woche, die sich dort verdichtet, wo sie sich überschneidet, und die eine Sache, die du jetzt anpacken kannst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια εβδομάδα που πυκνώνει όπου επικαλύπτεται, και αυτό που μπορείτε να πιάσετε τώρα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A week that deepens where it overlaps, and the one thing you can pick up now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana que se oscurece donde se solapa, y lo único que puedes hacer ahora"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viikko, joka tummuu siellä, missä menot kasautuvat, ja se yksi asia, jonka voit tehdä nyt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine qui s’intensifie là où elle se chevauche, et la seule chose à saisir maintenant"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepekan yang makin pekat saat jadwal bertumpuk, dan satu hal yang bisa dikerjakan sekarang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana che si fa più intensa dove si sovrappone, e l’unica cosa che puoi fare adesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重なるほど濃くなる一週間と、今すぐ手をつけられること"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겹칠수록 진해지는 한 주, 지금 집을 수 있는 일"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En uke som blir tydeligere der den overlapper, og den ene tingen du kan ta tak i nå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een week die voller kleurt waar hij overlapt, en het ene ding dat je nu kunt oppakken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tydzień, który gęstnieje tam, gdzie sprawy się nakładają, i ta jedna rzecz, którą możesz zrobić teraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semana que fica mais intensa onde se sobrepõe, e a única coisa que você pode pegar agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неделя, что темнеет там, где дела накладываются, и одно дело, за которое можно взяться сейчас"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En vecka som blir tätare där den överlappar, och den enda sak du kan ta tag i nu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัปดาห์ที่เข้มข้นขึ้นตรงที่ทับซ้อน และงานที่หยิบทำได้ตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çakıştıkça koyulaşan bir hafta ve şu an ele alabileceğiniz tek iş"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tuần đậm dần ở những chỗ chồng lên nhau, và một việc bạn có thể làm ngay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越重叠越浓的一周，和现在就能动手的那件事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "越重疊越濃的一周，和現在就能動手的那件事"
          }
        }
      }
    },
    "계약이나 이사처럼 번호와 주소를 여러 번 적어 내는 날.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den, kdy znovu a znovu vypisujete čísla a adresy, třeba při stěhování nebo podpisu smlouvy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag, hvor du skriver numre og adresser igen og igen, når du flytter eller skriver under på en kontrakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag, an dem du immer wieder Nummern und Adressen aufschreibst, beim Umzug oder bei einem Vertragsabschluss."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μέρα που γράφετε ξανά και ξανά αριθμούς και διευθύνσεις, σε μια μετακόμιση ή ένα συμβόλαιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day of writing out numbers and addresses again and again, moving house or signing a contract."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día de escribir números y direcciones una y otra vez: una mudanza o la firma de un contrato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivä, jona kirjoitat numeroita ja osoitteita yhä uudelleen, kun muutat tai teet sopimusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée à recopier encore et encore des numéros et des adresses, pour un déménagement ou un contrat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari saat nomor dan alamat ditulis berulang kali, seperti kontrak atau pindah rumah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una giornata passata a scrivere numeri e indirizzi più e più volte, tra un trasloco e la firma di un contratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "契約や引っ越しのように、番号と住所を何度も書き出す日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계약이나 이사처럼 번호와 주소를 여러 번 적어 내는 날."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag der du skriver ned numre og adresser igjen og igjen, når du flytter eller signerer en kontrakt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag waarop je steeds weer nummers en adressen invult, bij een verhuizing of een nieuw contract."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień, w którym raz po raz wpisujesz numery i adresy: przeprowadzka albo podpisywanie umowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia de escrever números e endereços várias vezes, como numa mudança ou na assinatura de um contrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, когда номера и адреса выписываешь снова и снова: договор, переезд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag då du skriver nummer och adresser om och om igen, när du flyttar eller skriver på ett avtal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ต้องกรอกหมายเลขและที่อยู่ซ้ำหลายครั้ง เช่น ทำสัญญาหรือย้ายบ้าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınırken ya da sözleşme imzalarken numaraları ve adresleri tekrar tekrar yazdığınız bir gün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày phải viết đi viết lại số và địa chỉ, như khi ký hợp đồng hay chuyển nhà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签约或搬家这种要反复写号码和地址的日子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽約或搬家這種要反復寫號碼和地址的日子。"
          }
        }
      }
    },
    "계좌번호, 주소, 인사말처럼 매번 다시 치는 문장을 모아 두고 어느 앱에서든 키보드에서 바로 붙여넣습니다. 복사한 것은 스스로 갈래를 나눠 쌓입니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si řádky, které pokaždé píšete znovu – čísla účtů, adresy, pozdravy – a vkládejte je přímo z klávesnice v jakékoli aplikaci. Co zkopírujete, se samo roztřídí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saml de linjer, du skriver hver gang – kontonumre, adresser, hilsner – og indsæt dem direkte fra tastaturet i enhver app. Det, du kopierer, bliver sorteret af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle die Zeilen, die du jedes Mal neu tippst, Kontonummern, Adressen, Grußformeln, und füge sie in jeder App direkt über die Tastatur ein. Was du kopierst, wird von selbst sortiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τις φράσεις που πληκτρολογείτε κάθε φορά, αριθμούς λογαριασμού, διευθύνσεις, χαιρετισμούς, και επικολλήστε τις κατευθείαν από το πληκτρολόγιο σε οποιαδήποτε εφαρμογή. Ό,τι αντιγράφετε ταξινομείται μόνο του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the lines you retype every time, bank numbers, addresses, greetings, and paste them straight from the keyboard in any app. Whatever you copy is sorted on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las frases que vuelves a escribir cada vez (números de cuenta, direcciones, saludos) y pégalas directamente desde el teclado en cualquier app. Lo que copias se clasifica solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoa talteen rivit, jotka kirjoitat aina uudelleen, kuten tilinumerot, osoitteet ja tervehdykset, ja liitä ne suoraan näppäimistöltä missä tahansa apissa. Kopioimasi tekstit lajittuvat itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les phrases que vous retapez à chaque fois, numéros de compte, adresses, formules de politesse, et collez-les directement depuis le clavier dans n’importe quelle app. Tout ce que vous copiez se range tout seul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kalimat yang selalu Anda ketik ulang, nomor rekening, alamat, sapaan, lalu tempelkan langsung dari papan ketik di aplikasi mana pun. Apa pun yang disalin tersusun sendiri menurut jenisnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni le righe che riscrivi ogni volta, coordinate bancarie, indirizzi, saluti, e incollale direttamente dalla tastiera in qualsiasi app. Tutto ciò che copi si ordina da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座番号、住所、あいさつ文など、毎回打ち直す文章をまとめておき、どのアプリでもキーボードからそのまま貼り付けられます。コピーしたものは自動で種類ごとに整理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌번호, 주소, 인사말처럼 매번 다시 치는 문장을 모아 두고 어느 앱에서든 키보드에서 바로 붙여넣습니다. 복사한 것은 스스로 갈래를 나눠 쌓입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samle linjene du skriver på nytt hver gang, kontonumre, adresser, hilsener, og lim dem inn rett fra tastaturet i hvilken som helst app. Det du kopierer, sorteres av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de zinnen die je steeds opnieuw typt, zoals rekeningnummers, adressen en begroetingen, en plak ze in elke app direct vanaf het toetsenbord. Wat je kopieert, wordt vanzelf gesorteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbieraj zdania, które za każdym razem wpisujesz od nowa: numery kont, adresy, powitania. Wklejaj je prosto z klawiatury w dowolnej aplikacji. To, co skopiujesz, samo trafia do właściwych grup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde as frases que você redigita toda vez, como dados bancários, endereços e saudações, e cole direto do teclado em qualquer app. O que você copia é organizado sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите фразы, которые набираете снова и снова: номера счетов, адреса, приветствия, и вставляйте их с клавиатуры в любом приложении. Скопированное само раскладывается по видам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samla raderna du skriver om varje gång, kontonummer, adresser, hälsningsfraser, och klistra in dem direkt från tangentbordet i vilken app som helst. Det du kopierar sorteras av sig självt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บประโยคที่ต้องพิมพ์ซ้ำทุกครั้ง เช่น เลขบัญชี ที่อยู่ คำทักทาย แล้ววางจากแป้นพิมพ์ได้ทันทีในทุกแอป สิ่งที่คัดลอกจะถูกจัดหมวดหมู่ให้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seferinde yeniden yazdığınız satırları (hesap numaraları, adresler, selamlaşmalar) bir yerde toplayın ve her uygulamada doğrudan klavyeden yapıştırın. Kopyaladıklarınız kendiliğinden sınıflandırılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu những câu bạn gõ lại mỗi lần như số tài khoản, địa chỉ, lời chào, rồi dán ngay từ bàn phím trong mọi ứng dụng. Những gì bạn sao chép sẽ tự được phân loại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把账号、地址、问候语这些每次都要重打的句子存起来，在任何应用里都能直接从键盘粘贴。复制过的内容会自己分好类堆在那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把帳號、地址、問候語這些每次都要重打的句子存起來，在任何應用裡都能直接從鍵盤貼上。複製過的內容會自己分好類堆在那裡。"
          }
        }
      }
    },
    "계좌번호나 주소를 매번 찾아 헤매는 사람": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé, kteří pokaždé hledají číslo účtu nebo adresu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, der leder efter et kontonummer eller en adresse hver eneste gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die jedes Mal nach einer Kontonummer oder Adresse suchen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι ψάχνουν κάθε φορά έναν αριθμό λογαριασμού ή μια διεύθυνση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who hunt for a bank number or an address every single time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien busca un número de cuenta o una dirección cada vez"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisille, jotka etsivät tilinumeroa tai osoitetta joka kerta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui cherchent un numéro de compte ou une adresse à chaque fois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang setiap kali mencari nomor rekening atau alamat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi va a cercare ogni volta le coordinate bancarie o un indirizzo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座番号や住所を毎回探し回っている人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌번호나 주소를 매번 찾아 헤매는 사람"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk som leter etter et kontonummer eller en adresse hver eneste gang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die elke keer weer naar een rekeningnummer of adres zoeken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które za każdym razem szukają numeru konta albo adresu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem procura dados bancários ou um endereço toda santa vez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто каждый раз ищет номер счёта или адрес"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som letar efter ett kontonummer eller en adress varenda gång"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ต้องค้นหาเลขบัญชีหรือที่อยู่ทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seferinde bir hesap numarası ya da adres arayanlar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người lần nào cũng phải đi tìm số tài khoản hay địa chỉ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都要翻找账号或地址的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都要翻找帳號或地址的人"
          }
        }
      }
    },
    "권한 오류라면 CloudKit Dashboard에서 admin 역할에 read 권한과 아래 사용자 ID를 등록했는지 확인하세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jde o chybu oprávnění, zkontrolujte, že role admin v CloudKit Dashboard má oprávnění ke čtení a obsahuje vaše uživatelské ID níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det er en tilladelsesfejl, så tjek, at admin-rollen i CloudKit Dashboard har læseadgang og indeholder dit bruger-id nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls es ein Berechtigungsfehler ist, prüfe, ob die Admin-Rolle in CloudKit Dashboard Leserechte hat und deine unten stehende Benutzer-ID enthält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν πρόκειται για σφάλμα δικαιωμάτων, ελέγξτε ότι ο ρόλος admin στο CloudKit Dashboard έχει δικαίωμα ανάγνωσης και περιλαμβάνει το παρακάτω ID χρήστη σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is a permission error, check that the admin role in CloudKit Dashboard has read permission and includes your user ID below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es un error de permisos, comprueba que el rol admin en CloudKit Dashboard tenga permiso de lectura e incluya tu ID de usuario de abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos kyse on käyttöoikeusvirheestä, tarkista CloudKit Dashboardista, että admin-roolilla on lukuoikeus ja että alla oleva käyttäjätunnuksesi on lisätty siihen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il s’agit d’une erreur d’autorisation, vérifiez que le rôle admin dans CloudKit Dashboard a le droit de lecture et inclut votre identifiant utilisateur ci-dessous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ini kesalahan izin, pastikan peran admin di CloudKit Dashboard memiliki izin baca dan menyertakan ID pengguna Anda di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si tratta di un errore di permessi, controlla che il ruolo admin in CloudKit Dashboard abbia il permesso di lettura e includa il tuo ID utente qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限エラーの場合は、CloudKit Dashboardでadminロールにread権限と以下のユーザーIDが登録されているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 오류라면 CloudKit Dashboard에서 admin 역할에 read 권한과 아래 사용자 ID를 등록했는지 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis dette er en tillatelsesfeil, sjekk at admin-rollen i CloudKit Dashboard har lesetilgang og inneholder bruker-ID-en din nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het een toestemmingsfout is, controleer dan of de admin-rol in CloudKit Dashboard leesrechten heeft en je gebruikers-ID hieronder bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to błąd uprawnień, sprawdź, czy rola admin w CloudKit Dashboard ma uprawnienie do odczytu i zawiera Twój identyfikator użytkownika podany poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se for um erro de permissão, confira se a função admin no CloudKit Dashboard tem permissão de leitura e inclui o seu ID de usuário abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это ошибка доступа, проверьте в CloudKit Dashboard, что у роли admin есть право read и добавлен ваш ID пользователя ниже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det är ett behörighetsfel, kontrollera att admin-rollen i CloudKit Dashboard har läsbehörighet och innehåller ditt användar-ID nedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเป็นข้อผิดพลาดด้านสิทธิ์ ให้ตรวจสอบว่าบทบาท admin ใน CloudKit Dashboard มีสิทธิ์ read และมี ID ผู้ใช้ด้านล่างแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir izin hatasıysa CloudKit Dashboard'daki admin rolünün okuma iznine sahip olduğunu ve aşağıdaki kullanıcı kimliğinizi içerdiğini kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu đây là lỗi quyền, hãy kiểm tra vai trò admin trong CloudKit Dashboard đã có quyền read và đã thêm ID người dùng bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是权限错误，请确认 CloudKit Dashboard 里 admin 角色有 read 权限，并且包含下面这个用户 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是權限錯誤，請確認 CloudKit Dashboard 裡 admin 角色有 read 權限，並且包含下面這個使用者 ID。"
          }
        }
      }
    },
