    "같은 목록을 나눠 쓰도록 함께 만든 앱입니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vznikly spolu, aby sdílely jeden seznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udviklet sammen til at dele den samme liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam entwickelt, um dieselbe Liste zu teilen."
          }
        },
        "el": {
