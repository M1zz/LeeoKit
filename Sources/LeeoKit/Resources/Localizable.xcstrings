    "환불은 결제한 분의 Apple 계정으로만 받을 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze se vracejí jen na účet Apple, ze kterého se platilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusioner går kun til den Apple-konto, der betalte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstattungen gehen nur an den Apple Account, der bezahlt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιστροφή χρημάτων γίνεται μόνο στον λογαριασμό Apple που πλήρωσε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refunds go only to the Apple Account that paid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los reembolsos solo van a la cuenta de Apple que pagó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvitykset maksetaan vain Apple-tilille, jolla maksettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le remboursement n’est versé qu’au compte Apple qui a payé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengembalian dana hanya ke Akun Apple yang membayar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rimborsi vanno solo all’Account Apple che ha pagato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金は支払ったAppleアカウントにのみ行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불은 결제한 분의 Apple 계정으로만 받을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusjoner går bare til Apple-kontoen som betalte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugbetalingen gaan alleen naar het Apple Account dat heeft betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot trafia tylko na konto Apple, z którego zapłacono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reembolso vai apenas para a Conta Apple que pagou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги возвращаются только на тот Аккаунт Apple, с которого платили."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återbetalningar går bara till det Apple-konto som betalade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เงินคืนจะเข้าบัญชี Apple ที่ชำระเงินเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İadeler yalnızca ödemeyi yapan Apple Hesabına yapılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền hoàn chỉ về Tài khoản Apple đã thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款只会退回付款的 Apple 账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款只會退回付款的 Apple 帳號。"
          }
        }
      }
    },
