    "사용자가 의견을 남겼어요. 인박스에서 확인해 보세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel zanechal zpětnou vazbu. Podívejte se do schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bruger har sendt feedback. Se den i indbakken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat Feedback hinterlassen. Sieh im Posteingang nach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας χρήστης άφησε σχόλιο. Δείτε το στα εισερχόμενα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A user left feedback. Check it in your inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un usuario ha dejado un comentario. Míralo en tu bandeja de entrada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku jätti palautetta. Katso se saapuneista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilisateur a laissé un commentaire. Consultez-le dans votre boîte de réception."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang pengguna meninggalkan masukan. Periksa di kotak masuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utente ha lasciato un feedback. Controllalo nella tua casella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーからご意見が届きました。受信箱でご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 의견을 남겼어요. 인박스에서 확인해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen har sendt en tilbakemelding. Sjekk innboksen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand heeft feedback achtergelaten. Bekijk het in je inbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś zostawił opinię. Sprawdź w skrzynce odbiorczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um usuário deixou um feedback. Confira na sua caixa de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователь оставил отзыв. Посмотрите его во входящих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon har lämnat feedback. Titta i inkorgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผู้ใช้ส่งความคิดเห็นมา ตรวจสอบได้ในกล่องข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kullanıcı geri bildirim bıraktı. Gelen kutunuzda görüntüleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người dùng đã gửi góp ý. Hãy xem trong hộp thư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有用户留言了。到收件箱看看吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有使用者留言了。到收件匣看看吧。"
          }
        }
      }
    },
