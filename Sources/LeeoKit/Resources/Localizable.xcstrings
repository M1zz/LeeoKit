            "value": "当时你在做什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當時你在做什麼？"
          }
        }
      }
    },
    "예) 밖에서 급하게 하나를 찾아야 했을 때요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. Když jsem venku potřeboval rychle něco najít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fx: Da jeg var ude og hurtigt skulle finde et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Als ich unterwegs schnell einen finden musste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Όταν έπρεπε να βρω ένα βιαστικά ενώ ήμουν έξω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. When I had to find one in a hurry while out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P. ej.: Cuando tuve que encontrar uno deprisa estando fuera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. kun piti löytää jokin kiireessä liikkeellä ollessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : quand je devais en retrouver un en vitesse, à l’extérieur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. Saat di luar dan harus cepat menemukan satu item."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Quando dovevo trovarne uno in fretta mentre ero fuori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）外出先で急いで一つ探さないといけなかった時です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 밖에서 급하게 하나를 찾아야 했을 때요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Da jeg måtte finne ett i en fart mens jeg var ute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. Toen ik onderweg snel iets moest vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. gdy byłem poza domem i musiałem szybko coś znaleźć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: Quando precisei encontrar um com pressa, fora de casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: когда срочно искал одну запись на ходу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. När jag snabbt behövde hitta något när jag var ute."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น ตอนอยู่ข้างนอกแล้วต้องรีบหารายการหนึ่ง"
