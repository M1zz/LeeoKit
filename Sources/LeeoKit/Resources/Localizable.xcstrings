            "value": "ไม่มีความคิดเห็นค้างอยู่ เสร็จหมดแล้ว 🎉"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin geri bildirim yok. Hepsi tamamlandı 🎉"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có góp ý nào đang chờ. Đã xong hết 🎉"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待处理的反馈，全都处理完了 🎉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有待處理的意見回饋，全都處理完了 🎉"
          }
        }
      }
    },
    "회사 이름만 바뀌는 자기소개는 클립키보드 템플릿으로 한 번만 만들어 두고 키보드에서 꺼냅니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průvodní dopis, ve kterém se mění jen název firmy, si jednou uložíte jako šablonu v ClipKeyboard a pak ho vytáhnete z klávesnice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præsentationen, hvor kun firmanavnet skifter, bliver én gang til en skabelon i ClipKeyboard og kommer derefter frem fra tastaturet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorstellung, in der sich nur der Firmenname ändert, wird einmal zur ClipKeyboard-Vorlage und kommt dann aus der Tastatur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αυτοπαρουσίαση όπου αλλάζει μόνο το όνομα της εταιρείας γίνεται μία φορά πρότυπο στο ClipKeyboard και μετά βγαίνει από το πληκτρολόγιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The introduction where only the company name changes becomes a ClipKeyboard template once, then comes out of the keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presentación en la que solo cambia el nombre de la empresa se convierte una vez en una plantilla de ClipKeyboard y luego sale del teclado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittelyteksti, jossa vain yrityksen nimi vaihtuu, tehdään kerran ClipKeyboard-malliksi ja otetaan sitten näppäimistöltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La présentation dont seul le nom de l’entreprise change devient une fois pour toutes un modèle ClipKeyboard, puis sort du clavier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkenalan diri yang hanya berubah nama perusahaannya dibuat sekali sebagai templat ClipKeyboard, lalu diambil dari papan ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La presentazione in cui cambia solo il nome dell’azienda diventa una volta per tutte un modello di ClipKeyboard, e poi esce dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社名だけが変わる自己紹介は、ClipKeyboardのテンプレートに一度だけ作ってキーボードから取り出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회사 이름만 바뀌는 자기소개는 클립키보드 템플릿으로 한 번만 만들어 두고 키보드에서 꺼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentasjonen der bare firmanavnet endres, blir én gang til en ClipKeyboard-mal og hentes deretter fram fra tastaturet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De introductie waarin alleen de bedrijfsnaam verandert, maak je één keer als ClipKeyboard-sjabloon en haal je daarna uit het toetsenbord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst o sobie, w którym zmienia się tylko nazwa firmy, raz zapisujesz jako szablon w ClipKeyboard i potem wyciągasz go z klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A apresentação em que só muda o nome da empresa vira um modelo do ClipKeyboard uma única vez e depois sai direto do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассказ о себе, где меняется только название компании, один раз становится шаблоном ClipKeyboard и потом достаётся с клавиатуры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentationen där bara företagsnamnet ändras görs en gång till en mall i ClipKeyboard och hämtas sedan från tangentbordet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติแนะนำตัวที่เปลี่ยนแค่ชื่อบริษัท สร้างเป็นเทมเพลตใน ClipKeyboard ครั้งเดียว แล้วเรียกจากแป้นพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca şirket adının değiştiği tanıtım metni bir kez ClipKeyboard şablonu olur, sonra klavyeden gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần giới thiệu bản thân chỉ đổi tên công ty được tạo một lần thành mẫu ClipKeyboard, rồi lấy ra từ bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有公司名不同的自我介绍，用剪贴键盘的模板做一次，之后从键盘取出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有公司名不同的自我介紹，用剪貼鍵盤的範本做一次，之後從鍵盤取出。"
          }
        }
      }
    },
