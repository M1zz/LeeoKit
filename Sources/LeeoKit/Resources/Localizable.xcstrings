    "맥에서 메일을 쓰다 폰에 저장해 둔 문구가 필요할 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když na Macu píšete e-mail a potřebujete řádek uložený v telefonu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skriver en mail på Mac'en og har brug for en linje, der er gemt på din iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du auf dem Mac eine Mail schreibst und eine Zeile brauchst, die auf deinem iPhone gespeichert ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν γράφετε email στο Mac και χρειάζεστε μια φράση αποθηκευμένη στο iPhone σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are writing mail on the Mac and need a line saved on your phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando escribes un correo en el Mac y necesitas una frase guardada en el teléfono"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kirjoitat sähköpostia Macilla ja tarvitset iPhoneen tallennettua riviä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous écrivez un e-mail sur le Mac et avez besoin d’une phrase enregistrée sur votre téléphone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menulis surel di Mac dan butuh kalimat yang tersimpan di ponsel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando scrivi una mail sul Mac e ti serve una frase salvata sul telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでメールを書いていて、iPhoneに保存した文章が必要になったとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맥에서 메일을 쓰다 폰에 저장해 둔 문구가 필요할 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skriver e-post på Macen og trenger en tekst du har lagret på iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je op de Mac een mail schrijft en een zin nodig hebt die op je iPhone staat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy piszesz e-mail na Macu i potrzebujesz zdania zapisanego w iPhonie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você está escrevendo um e-mail no Mac e precisa de uma frase salva no celular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда пишете письмо на Mac, а нужная фраза сохранена на телефоне"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du skriver mejl på Macen och behöver en rad som är sparad på din iPhone"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเขียนเมลบน Mac แล้วต้องใช้ข้อความที่บันทึกไว้ในโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te e-posta yazarken iPhone'unuzda kayıtlı bir satıra ihtiyaç duyduğunuzda"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đang viết mail trên Mac và cần câu đã lưu trên điện thoại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上写邮件，却需要存在手机里的那句话时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上寫郵件，卻需要存在手機裡的那句話時"
          }
        }
      }
    },
    "맥을 켜고 오늘 할 일을 앉히는 삼십 분.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Třicet minut, kdy zapnete Mac a rozvrhnete dnešní práci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den halve time, hvor du tænder Mac'en og lægger dagens arbejde på plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die dreißig Minuten, in denen du den Mac einschaltest und die Arbeit des Tages einplanst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τριάντα λεπτά που ανοίγετε το Mac και τοποθετείτε τη δουλειά της ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thirty minutes where you switch on the Mac and seat today's work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los treinta minutos en los que enciendes el Mac y colocas el trabajo del día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoli tuntia, jonka aikana käynnistät Macin ja asetat päivän työt paikoilleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trente minutes où vous allumez le Mac et posez le travail du jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga puluh menit untuk menyalakan Mac dan menata pekerjaan hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trenta minuti in cui accendi il Mac e metti in ordine il lavoro di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macを立ち上げ、今日の仕事を並べる三十分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맥을 켜고 오늘 할 일을 앉히는 삼십 분."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den halvtimen der du slår på Macen og legger inn dagens arbeid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het halfuur waarin je de Mac aanzet en het werk van vandaag inplant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te trzydzieści minut, kiedy włączasz Maca i rozkładasz dzisiejszą pracę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os trinta minutos em que você liga o Mac e encaixa o trabalho do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полчаса, за которые вы включаете Mac и рассаживаете сегодняшние дела."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De trettio minuterna då du startar Macen och lägger in dagens arbete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามสิบนาทีที่เปิด Mac แล้ววางงานของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'i açıp günün işlerini yerleştirdiğiniz otuz dakika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba mươi phút bật Mac lên và sắp xếp việc hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Mac、把今天的活儿安排好的三十分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Mac、把今天的活兒安排好的三十分鐘。"
          }
        }
      }
    },
    "메뉴바에서 한 번, 맥에서도 같은 문장": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno kliknutí v řádku nabídek, stejné řádky i na Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét klik i menulinjen, de samme linjer på din Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick in der Menüleiste, dieselben Zeilen auf deinem Mac"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κλικ στη γραμμή μενού, οι ίδιες φράσεις και στο Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One click in the menu bar, the same lines on your Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic en la barra de menús, las mismas frases en tu Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi klikkaus valikkorivillä, samat rivit Macillakin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic dans la barre des menus, les mêmes phrases sur votre Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali klik di bilah menu, kalimat yang sama di Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic nella barra dei menu, le stesse righe sul Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーからひと押し、Macでも同じ文章"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바에서 한 번, 맥에서도 같은 문장"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett klikk i menylinjen, de samme linjene på Macen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén klik in de menubalk, dezelfde zinnen op je Mac"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno kliknięcie na pasku menu, te same zdania na Macu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique na barra de menus, as mesmas frases no seu Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие в строке меню, те же фразы на Mac"
