        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의와 마감 사이에 남은 시간을 찾을 때"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você procura o tempo que sobra entre reuniões e prazos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ищете время, оставшееся между встречами и сроками"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องหาเวลาว่างระหว่างประชุมและกำหนดส่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
