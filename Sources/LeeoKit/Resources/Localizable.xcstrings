    "한 번 사면 이 개발자의 모든 앱이 Plus · Pro 평생으로 열려요. 앞으로 나올 앱과 기능도 따로 사지 않아요.": {
      "comment": "Forever pass: what it unlocks",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupte jednou a ve všech aplikacích tohoto vývojáře budete mít Plus · Pro navždy. Budoucí aplikace a funkce jsou v ceně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb én gang, og alle denne udviklers apps låses op med Plus · Pro for livet. Kommende apps og funktioner er også med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal kaufen und alle Apps dieses Entwicklers sind für immer mit Plus · Pro freigeschaltet. Künftige Apps und Funktionen sind auch dabei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγοράστε μία φορά και όλες οι εφαρμογές αυτού του δημιουργού ξεκλειδώνουν Plus · Pro για πάντα. Οι μελλοντικές εφαρμογές και λειτουργίες περιλαμβάνονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy once and every app from this developer unlocks Plus · Pro for life. Future apps and features are included too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra una vez y todas las apps de este desarrollador se desbloquean con Plus · Pro para siempre. Las apps y funciones futuras también están incluidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osta kerran, niin Plus · Pro avautuu pysyvästi kaikkiin tämän kehittäjän sovelluksiin. Myös tulevat sovellukset ja ominaisuudet sisältyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat et toutes les apps de ce développeur passent en Plus · Pro à vie. Les futures apps et fonctions sont incluses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli sekali, semua aplikasi dari developer ini terbuka Plus · Pro selamanya. Aplikasi dan fitur mendatang juga sudah termasuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compri una volta e tutte le app di questo sviluppatore si sbloccano con Plus · Pro a vita. Anche app e funzioni future sono incluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度買えば、この開発者のすべてのアプリで Plus · Pro がずっと使えます。これから出るアプリや機能も追加購入は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 사면 이 개발자의 모든 앱이 Plus · Pro 평생으로 열려요. 앞으로 나올 앱과 기능도 따로 사지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp én gang, så låses alle apper fra denne utvikleren opp med Plus · Pro for alltid. Fremtidige apper og funksjoner er også med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer kopen en alle apps van deze ontwikkelaar zijn voor altijd ontgrendeld met Plus · Pro. Toekomstige apps en functies horen er ook bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kup raz, a wszystkie aplikacje tego twórcy odblokują Plus · Pro na zawsze. Przyszłe aplikacje i funkcje też są w cenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compre uma vez e todos os apps deste desenvolvedor ficam com Plus · Pro para sempre. Apps e recursos futuros também estão incluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Купите один раз, и во всех приложениях этого разработчика навсегда откроются Plus · Pro. Будущие приложения и функции тоже входят."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp en gång så låses alla appar från den här utvecklaren upp med Plus · Pro för alltid. Kommande appar och funktioner ingår också."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว ทุกแอปของนักพัฒนารายนี้จะปลดล็อก Plus · Pro ตลอดชีพ แอปและฟีเจอร์ที่จะออกในอนาคตก็ไม่ต้องซื้อแยก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez alın, bu geliştiricinin tüm uygulamalarında Plus · Pro ömür boyu açılsın. Gelecek uygulamalar ve özellikler de dahil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần, mọi ứng dụng của nhà phát triển này đều mở Plus · Pro trọn đời. Ứng dụng và tính năng sau này cũng không cần mua thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "买一次，这位开发者的所有 App 都永久解锁 Plus · Pro。以后推出的 App 和功能也无需另购。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "買一次，這位開發者的所有 App 都永久解鎖 Plus · Pro。之後推出的 App 和功能也不用另外購買。"
          }
        }
      }
    },
    "한 시간을 지켜 두는 법": {
