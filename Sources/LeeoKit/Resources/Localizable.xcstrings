    "CloudKit Dashboard의 admin 역할에 이 ID를 추가하면 앱에서 모든 피드백을 읽을 수 있어요. 탭하면 복사됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diese ID in CloudKit Dashboard zur Admin-Rolle hinzu, um in der App alle Feedbacks lesen zu können. Tippen zum Kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this ID to the admin role in CloudKit Dashboard to read all feedback in the app. Tap to copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade este ID al rol admin en CloudKit Dashboard para leer todos los comentarios en la app. Toca para copiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cet identifiant au rôle admin dans CloudKit Dashboard pour lire tous les commentaires dans l’app. Touchez pour copier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan ID ini ke peran admin di CloudKit Dashboard untuk membaca semua masukan di aplikasi. Ketuk untuk menyalin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo ID al ruolo admin in CloudKit Dashboard per leggere tutti i feedback nell’app. Tocca per copiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit DashboardのadminロールにこのIDを追加すると、アプリで全てのフィードバックを読めます。タップでコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit Dashboard의 admin 역할에 이 ID를 추가하면 앱에서 모든 피드백을 읽을 수 있어요. 탭하면 복사됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este ID à função admin no CloudKit Dashboard para ler todo o feedback no app. Toque para copiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте этот ID в роль admin в CloudKit Dashboard, чтобы читать все отзывы в приложении. Нажмите, чтобы скопировать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม ID นี้ในบทบาท admin ของ CloudKit Dashboard เพื่ออ่านความคิดเห็นทั้งหมดในแอป แตะเพื่อคัดลอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ID này vào vai trò admin trong CloudKit Dashboard để đọc mọi góp ý trong ứng dụng. Chạm để sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个 ID 加到 CloudKit Dashboard 的 admin 角色里，就能在 App 内读取所有反馈。点按即可复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這個 ID 加到 CloudKit Dashboard 的 admin 角色裡，就能在 App 內讀取所有意見回饋。點一下即可複製。"
          }
        }
      }
    },
    "Mail 앱이 설정되어 있지 않습니다. mailto: 링크로 다른 메일 앱을 열겠습니까?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail ist nicht eingerichtet. Möchtest du über einen mailto:-Link eine andere Mail-App öffnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail is not configured. Would you like to open another mail app via mailto: link?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no está configurado. ¿Quieres abrir otra app de correo mediante un enlace mailto:?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’est pas configuré. Voulez-vous ouvrir une autre app de messagerie via un lien mailto: ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mail is not configured. Would you like to open another mail app via mailto: link?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail non è configurata. Vuoi aprire un’altra app di posta tramite un link mailto:?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアプリが設定されていません。mailto:リンクで別のメールアプリを開きますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail 앱이 설정되어 있지 않습니다. mailto: 링크로 다른 메일 앱을 열겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mail não está configurado. Quer abrir outro app de e-mail pelo link mailto:?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «Почта» не настроено. Открыть другое почтовое приложение по ссылке mailto:?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งค่าแอป Mail ต้องการเปิดแอปเมลอื่นผ่านลิงก์ mailto: ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng Mail chưa được thiết lập. Bạn có muốn mở ứng dụng mail khác qua liên kết mailto: không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有设置“邮件”App。要通过 mailto: 链接打开其他邮件 App 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有設定「郵件」App。要透過 mailto: 連結開啟其他郵件 App 嗎？"
          }
        }
      }
    },
    "iCloud에 로그인되어 있지 않아요": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht bei iCloud angemeldet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not signed in to iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión en iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes pas connecté à iCloud"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum masuk ke iCloud"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai effettuato l’accesso a iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインしていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인되어 있지 않아요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está conectado ao iCloud"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в iCloud не выполнен"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้ลงชื่อเข้าใช้ iCloud"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa đăng nhập iCloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有登录 iCloud"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有登入 iCloud"
          }
        }
      }
    },
    "같은 iCloud 를 쓰는 두 앱은 같은 할 일을 봅니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Apps mit derselben iCloud sehen dieselben Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two apps on the same iCloud see the same tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos apps con el mismo iCloud ven las mismas tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux apps sur le même iCloud voient les mêmes tâches."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua aplikasi pada iCloud yang sama melihat tugas yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due app sullo stesso iCloud vedono le stesse attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じiCloudを使う二つのアプリは、同じやることを見ています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 iCloud 를 쓰는 두 앱은 같은 할 일을 봅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois apps no mesmo iCloud veem as mesmas tarefas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два приложения на одном iCloud видят одни и те же дела."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองแอปที่ใช้ iCloud เดียวกันจะเห็นงานเดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ứng dụng dùng chung iCloud sẽ thấy cùng danh sách việc cần làm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用同一个 iCloud 的两个应用，看到的是同一批待办。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用同一個 iCloud 的兩個應用，看到的是同一批待辦。"
          }
        }
      }
    },
    "같은 답장을 하루에도 몇 번씩 보내는 사람": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen, die dieselbe Antwort mehrmals am Tag verschicken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who send the same reply several times a day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien envía la misma respuesta varias veces al día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles et ceux qui envoient la même réponse plusieurs fois par jour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang mengirim balasan yang sama beberapa kali sehari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi manda la stessa risposta più volte al giorno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ返信を一日に何度も送る人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 답장을 하루에도 몇 번씩 보내는 사람"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem envia a mesma resposta várias vezes por dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем, кто по нескольку раз в день отправляет один и тот же ответ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ส่งข้อความตอบกลับเดิมๆ หลายครั้งต่อวัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người gửi cùng một câu trả lời nhiều lần mỗi ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天要发好几次相同回复的人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一天要發好幾次相同回覆的人"
          }
        }
      }
    },
    "같은 문장을 다시 쓰지 않고, 마감을 놓치지 않습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tippst dieselben Zeilen nie wieder ab und verpasst keine Frist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You never retype the same lines, and you never miss the deadline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vuelves a escribir las mismas frases y nunca se te pasa un plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne retapez plus les mêmes phrases, et vous ne manquez plus l’échéance."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang sama tak perlu ditulis ulang, dan tenggat tidak terlewat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riscrivi mai le stesse righe e non perdi mai una scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ文章を書き直さず、締め切りも逃しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 문장을 다시 쓰지 않고, 마감을 놓치지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você nunca redigita as mesmas frases e nunca perde o prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одни и те же фразы не приходится писать заново, а срок не проходит мимо."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องพิมพ์ประโยคเดิมซ้ำ และไม่พลาดกำหนดส่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải gõ lại cùng một câu, không lỡ hạn chót."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的句子不用再写一遍，截止也不会错过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同樣的句子不用再寫一遍，截止也不會錯過。"
          }
        }
      }
    },
    "같은 사람이 만든 앱들입니다. 겹치는 자리가 있어서, 붙여 두면 하루가 이어집니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind Apps vom selben Entwickler. Sie überschneiden sich an manchen Stellen, und nebeneinander genutzt tragen sie dich durch den Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are apps by the same maker. They overlap in places, so keeping them side by side lets a day carry through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son apps del mismo creador. Se solapan en algunos puntos, así que tenerlas juntas hace que el día fluya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces apps sont du même créateur. Elles se recoupent par endroits : en les gardant côte à côte, votre journée s’enchaîne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini aplikasi buatan orang yang sama. Ada bagian yang bertumpang tindih, jadi bila disandingkan, satu hari jadi tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono app dello stesso autore. Si sovrappongono in alcuni punti, quindi tenerle una accanto all’altra fa scorrere la giornata senza interruzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ作者が作ったアプリです。重なる部分があるので、並べておくと一日がつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 사람이 만든 앱들입니다. 겹치는 자리가 있어서, 붙여 두면 하루가 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São apps do mesmo criador. Eles se complementam em alguns pontos, então usá-los lado a lado deixa o dia fluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложения одного автора. У них есть общие места, и если держать их рядом, день не рвётся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเหล่านี้สร้างโดยผู้พัฒนาคนเดียวกัน มีส่วนที่ทับซ้อนกัน ใช้คู่กันแล้ววันของคุณจะต่อเนื่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là các ứng dụng của cùng một nhà phát triển. Chúng giao nhau ở nhiều chỗ, nên dùng cạnh nhau giúp cả ngày liền mạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "都是同一个人做的应用。彼此有重叠的地方，放在一起，一天就接得上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "都是同一個人做的應用。彼此有重疊的地方，放在一起，一天就接得上。"
          }
        }
      }
    },
    "개선 제안": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbesserungsvorschlag"
