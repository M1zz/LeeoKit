    "결제는 App Store 계정으로 청구됩니다. 구독은 언제든지 App Store 설정에서 관리·해지할 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba bude naúčtována na váš účet App Store. Předplatné můžete kdykoli spravovat nebo zrušit v nastavení App Storu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen opkræves via din App Store-konto. Du kan til enhver tid administrere eller opsige et abonnement i indstillingerne for App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird deinem App-Store-Account belastet. Du kannst ein Abo jederzeit in den App-Store-Einstellungen verwalten oder kündigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληρωμή χρεώνεται στον λογαριασμό σας στο App Store. Μπορείτε να διαχειριστείτε ή να ακυρώσετε μια συνδρομή ανά πάσα στιγμή στις ρυθμίσεις του App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your App Store account. You can manage or cancel a subscription anytime in App Store settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se cargará a tu cuenta del App Store. Puedes gestionar o cancelar la suscripción cuando quieras en los ajustes del App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksu veloitetaan App Store ‑tililtäsi. Voit hallita tilausta tai perua sen milloin tahansa App Storen asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité sur votre compte App Store. Vous pouvez gérer ou résilier un abonnement à tout moment dans les réglages de l’App Store."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran ditagihkan ke akun App Store Anda. Anda dapat mengelola atau membatalkan langganan kapan saja di pengaturan App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo account App Store. Puoi gestire o annullare un abbonamento in qualsiasi momento nelle impostazioni dell’App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いはApp Storeアカウントに請求されます。サブスクリプションはApp Storeの設定からいつでも管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 App Store 계정으로 청구됩니다. 구독은 언제든지 App Store 설정에서 관리·해지할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen belastes App Store-kontoen din. Du kan når som helst administrere eller avslutte et abonnement i App Store-innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling wordt in rekening gebracht via je App Store-account. Je kunt een abonnement altijd beheren of opzeggen in de App Store-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność zostanie pobrana z Twojego konta App Store. Subskrypcją możesz w każdej chwili zarządzać lub ją anulować w ustawieniach App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado na sua conta da App Store. Você pode gerenciar ou cancelar a assinatura a qualquer momento nos ajustes da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с вашей учётной записи App Store. Подпиской можно управлять или отменить её в любое время в настройках App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalningen debiteras ditt App Store-konto. Du kan när som helst hantera eller avsluta en prenumeration i inställningarna för App Store."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การชำระเงินจะเรียกเก็บจากบัญชี App Store ของคุณ คุณจัดการหรือยกเลิกการสมัครสมาชิกได้ทุกเมื่อในการตั้งค่า App Store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme App Store hesabınızdan tahsil edilir. Aboneliğinizi istediğiniz zaman App Store ayarlarından yönetebilir veya iptal edebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản thanh toán sẽ được tính vào tài khoản App Store của bạn. Bạn có thể quản lý hoặc hủy gói đăng ký bất cứ lúc nào trong cài đặt App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用将从你的 App Store 账户扣除。你可以随时在 App Store 设置中管理或取消订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "費用將向你的 App Store 帳號收取。你可以隨時在 App Store 設定中管理或取消訂閱。"
          }
        }
      }
    },
