          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Milloin ja millä laitteella ostit sen? (valinnainen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand et sur quel appareil avez-vous acheté ? (facultatif)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan dan di perangkat mana Anda membelinya? (opsional)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando e su quale dispositivo l'hai acquistato? (facoltativo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ、どの端末で購入しましたか？（任意）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제, 어느 기기에서 샀나요? (선택)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når og på hvilken enhet kjøpte du det? (valgfritt)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer en op welk toestel heb je het gekocht? (optioneel)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy i na jakim urządzeniu kupiłeś? (opcjonalnie)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando e em qual aparelho você comprou? (opcional)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда и на каком устройстве вы купили? (необязательно)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När och på vilken enhet köpte du det? (valfritt)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อเมื่อไหร่ และซื้อจากเครื่องไหน (ไม่บังคับ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman ve hangi cihazda satın aldınız? (isteğe bağlı)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mua khi nào, trên thiết bị nào? (không bắt buộc)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么时候、在哪台设备上购买的？（可选）"
