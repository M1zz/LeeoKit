    "두번알림으로 한 시간을 재고, 끝나기 10분 전에 마무리 신호를 받습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder odměří hodinu a deset minut před koncem vám dá znamení, abyste začali uzavírat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder tager tid på timen og giver dig signal til at runde af ti minutter før slut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder misst die Stunde und gibt dir zehn Minuten vor dem Ende das Signal zum Abschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Rereminder μετράει την ώρα και σας δίνει σήμα να ολοκληρώσετε δέκα λεπτά πριν από το τέλος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder times the hour and signals you to wrap up ten minutes before it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder cronometra la hora y te avisa para ir cerrando diez minutos antes del final."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder ajastaa tunnin ja antaa lopettelumerkin kymmenen minuuttia ennen loppua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder chronomètre l’heure et vous signale de conclure dix minutes avant la fin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder menghitung satu jam dan memberi aba-aba merapikan sepuluh menit sebelum habis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder cronometra l’ora e ti segnala di chiudere dieci minuti prima della fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminderで一時間を計り、終わる10分前に仕上げの合図を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두번알림으로 한 시간을 재고, 끝나기 10분 전에 마무리 신호를 받습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder tar tiden på timen og gir deg signal om å runde av ti minutter før den er over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder houdt het uur bij en geeft je tien minuten voor het einde een seintje om af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder odmierza godzinę i dziesięć minut przed końcem daje znak, żeby kończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rereminder cronometra a hora e avisa você para encerrar dez minutos antes do fim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder отмеряет час и за десять минут до конца подаёт знак закругляться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder tar tid på timmen och ger dig en signal att runda av tio minuter innan den är slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder จับเวลาหนึ่งชั่วโมง และส่งสัญญาณให้ปิดงานก่อนหมดเวลา 10 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder bir saati ölçer ve bitimine on dakika kala toparlanma sinyali verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereminder đo một tiếng và báo bạn kết thúc mười phút trước khi hết giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Rereminder 计一个小时，结束前十分钟收到收尾的信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Rereminder 計一個小時，結束前十分鐘收到收尾的信號。"
          }
        }
      }
    },
    "떼어 둔 시간이 조각으로 부서지지 않습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhrazená hodina se nerozpadne na kousky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den time, du har sat af, bliver ikke slået i stykker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stunde, die du dir freigehalten hast, zerfällt nicht in Stücke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ώρα που δεσμεύσατε δεν σπάει σε κομμάτια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hour you set aside does not break into pieces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora que reservaste no se rompe en pedazos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varaamasi tunti ei hajoa palasiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure que vous avez réservée ne se morcelle pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu yang sudah disisihkan tidak pecah menjadi kepingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora che hai riservato non si spezza in frammenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空けておいた時間が、細切れに壊れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떼어 둔 시간이 조각으로 부서지지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Timen du har satt av, går ikke i stykker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uur dat je hebt vrijgehouden, valt niet in stukjes uiteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarezerwowana godzina nie rozpada się na kawałki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora que você reservou não se desfaz em pedaços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложенный час не рассыпается на куски."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmen du har avsatt splittras inte i bitar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาที่กันไว้จะไม่แตกเป็นชิ้นเล็กๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayırdığınız saat parçalara bölünmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng thời gian bạn dành riêng không bị vỡ vụn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留出的时间不会被敲成碎片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留出的時間不會被敲成碎片。"
          }
        }
      }
    },
