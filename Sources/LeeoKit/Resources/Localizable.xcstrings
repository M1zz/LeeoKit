    "%1$@ Pro를 선물로 보내요.\n앱에서 '선물 코드 입력'을 열고 이 코드를 넣어 주세요: %2$@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posílám ti dárkem %1$@ Pro.\nV aplikaci otevři „Zadat dárkový kód“ a zadej tento kód: %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg giver dig %1$@ Pro i gave.\nÅbn »Indløs gavekode« i appen, og indtast denne kode: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schenke dir %1$@ Pro.\nÖffne in der App „Geschenkcode eingeben“ und gib diesen Code ein: %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σου κάνω δώρο το %1$@ Pro.\nΆνοιξε την «Εξαργύρωση κωδικού δώρου» στην εφαρμογή και βάλε αυτόν τον κωδικό: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending you %1$@ Pro as a gift.\nOpen 'Redeem Gift Code' in the app and enter this code: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te regalo %1$@ Pro.\nAbre «Canjear código de regalo» en la app e introduce este código: %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Annan sinulle %1$@ Pron lahjaksi.\nAvaa apissa ”Lunasta lahjakoodi” ja syötä tämä koodi: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je t’offre %1$@ Pro.\nDans l’app, ouvre « Saisir un code cadeau » et entre ce code : %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku kasih hadiah %1$@ Pro untukmu.\nBuka “Tukarkan Kode Hadiah” di app dan masukkan kode ini: %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti regalo %1$@ Pro.\nApri «Riscatta codice regalo» nell’app e inserisci questo codice: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Proをプレゼントします。\nアプリで「ギフトコードを入力」を開いて、このコードを入れてください：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Pro를 선물로 보내요.\n앱에서 '선물 코드 입력'을 열고 이 코드를 넣어 주세요: %2$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg gir deg %1$@ Pro i gave.\nÅpne «Løs inn gavekode» i appen og skriv inn denne koden: %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik geef je %1$@ Pro cadeau.\nOpen 'Cadeaucode invoeren' in de app en vul deze code in: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daję Ci w prezencie %1$@ Pro.\nOtwórz w aplikacji „Wpisz kod prezentu” i wpisz ten kod: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou te dando %1$@ Pro de presente.\nAbra “Resgatar código de presente” no app e digite este código: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дарю тебе %1$@ Pro.\nОткрой в приложении «Ввести код подарка» и введи этот код: %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag ger dig %1$@ Pro i present.\nÖppna ”Lös in presentkod” i appen och ange den här koden: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอมอบ %1$@ Pro เป็นของขวัญให้นะ\nเปิด “ใส่รหัสของขวัญ” ในแอป แล้วใส่รหัสนี้: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana %1$@ Pro hediye ediyorum.\nUygulamada “Hediye kodu gir” bölümünü aç ve bu kodu yaz: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình tặng bạn %1$@ Pro.\nMở “Nhập mã quà tặng” trong ứng dụng và nhập mã này: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送你一份 %1$@ Pro 礼物。\n请在 App 中打开“输入礼品码”，输入这个码：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "送你一份 %1$@ Pro 禮物。\n請在 App 中開啟「輸入禮物碼」，輸入這組代碼：%2$@"
          }
        }
      }
    },
    "Apple 계정으로 결제하면 선물 코드가 만들어져요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplaťte svým účtem Apple a vytvoří se dárkový kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal med din Apple-konto, så oprettes der en gavekode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezahle mit deinem Apple Account, dann wird ein Geschenkcode erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληρώστε με τον λογαριασμό σας Apple και δημιουργείται κωδικός δώρου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay with your Apple Account and a gift code is created."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga con tu cuenta de Apple y se creará un código de regalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksa Apple-tililläsi, niin lahjakoodi luodaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez avec votre compte Apple : un code cadeau est créé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar dengan Akun Apple, lalu kode hadiah akan dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga con il tuo Account Apple e verrà creato un codice regalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleアカウントで支払うと、ギフトコードが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정으로 결제하면 선물 코드가 만들어져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal med Apple-kontoen din, så lages det en gavekode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal met je Apple Account, dan wordt er een cadeaucode gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłać kontem Apple, a utworzymy kod prezentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague com sua Conta Apple e um código de presente será criado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплатите с Аккаунта Apple, и будет создан код подарка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betala med ditt Apple-konto så skapas en presentkod."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชำระเงินด้วยบัญชี Apple แล้วระบบจะสร้างรหัสของขวัญให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınızla ödeyin, bir hediye kodu oluşturulsun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán bằng Tài khoản Apple, mã quà tặng sẽ được tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple 账户付款后，就会生成礼品码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple 帳號付款後，就會產生禮物碼。"
          }
        }
      }
    },
    "iCloud에 로그인해야 선물을 주고받을 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste mohli darovat a přijímat dárky, přihlaste se k iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på iCloud for at give og modtage gaver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei iCloud an, um Geschenke zu senden oder zu empfangen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στο iCloud για να στέλνετε και να λαμβάνετε δώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to send or receive gifts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para enviar o recibir regalos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu iCloudiin, niin voit antaa ja vastaanottaa lahjoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud pour offrir ou recevoir des cadeaux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke iCloud untuk mengirim dan menerima hadiah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a iCloud per inviare o ricevere regali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギフトを送ったり受け取ったりするには、iCloudにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인해야 선물을 주고받을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på iCloud for å gi og motta gaver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij iCloud om cadeaus te geven of te ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do iCloud, aby dawać i odbierać prezenty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no iCloud para enviar ou receber presentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в iCloud, чтобы дарить и получать подарки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på iCloud för att ge och ta emot presenter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ iCloud เพื่อส่งและรับของขวัญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hediye gönderip almak için iCloud'a giriş yapın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập iCloud để tặng và nhận quà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 iCloud 才能赠送和领取礼物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 iCloud 才能送出和領取禮物。"
          }
        }
      }
    },
