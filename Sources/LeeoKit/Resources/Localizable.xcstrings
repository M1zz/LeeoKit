    "예) 목록을 내릴 때마다 1초쯤 멈칫해요.": {
      "comment": "Slow prompt placeholder: where and how long",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. při každém posouvání seznamu se asi na vteřinu zasekne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Det hakker i cirka et sekund, hver gang jeg scroller i listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Beim Scrollen in der Liste hängt es jedes Mal etwa eine Sekunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Π.χ. Κάθε φορά που κάνω κύλιση στη λίστα, κολλάει για περίπου ένα δευτερόλεπτο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. The list stutters for about a second every time I scroll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej.: Cada vez que deslizo la lista se traba como un segundo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. Luetteloa vierittäessä se jumittaa joka kerta noin sekunnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : Chaque fois que je fais défiler la liste, ça bloque environ une seconde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis. Setiap kali menggulir daftar, tersendat sekitar 1 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Es.: Ogni volta che scorro l'elenco si blocca per circa un secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）リストをスクロールするたびに1秒ほど止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 목록을 내릴 때마다 1초쯤 멈칫해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Det stopper opp i omtrent ett sekund hver gang jeg blar i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. Bij het scrollen door de lijst hapert het elke keer ongeveer een seconde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. przy każdym przewijaniu listy zacina się na około sekundę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: Toda vez que rolo a lista, trava por cerca de um segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например: при прокрутке списка каждый раз подвисает примерно на секунду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. Det hackar i ungefär en sekund varje gång jag scrollar i listan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น เลื่อนรายการลงทีไรค้างไปประมาณ 1 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. Listeyi her kaydırdığımda yaklaşık bir saniye takılıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VD: Mỗi lần cuộn danh sách là khựng khoảng 1 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
