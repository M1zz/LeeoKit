    "보내는 분과 받는 분 모두 iCloud에 로그인되어 있어야 해요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vy i obdarovaný musíte být přihlášeni k iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Både du og modtageren skal være logget ind på iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du und die andere Person müsst bei iCloud angemeldet sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και εσείς και ο παραλήπτης πρέπει να είστε συνδεδεμένοι στο iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both you and the recipient need to be signed in to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien envía y quien recibe deben tener la sesión iniciada en iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekä sinun että saajan täytyy olla kirjautuneena iCloudiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous et la personne qui reçoit le cadeau devez être connectés à iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengirim dan penerima harus masuk ke iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sia chi invia sia chi riceve deve aver eseguito l’accesso a iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "贈る人も受け取る人も、iCloudにサインインしている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내는 분과 받는 분 모두 iCloud에 로그인되어 있어야 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Både du og mottakeren må være logget på iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zowel jij als de ontvanger moeten bij iCloud zijn ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarówno Ty, jak i odbiorca musicie być zalogowani do iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem envia e quem recebe precisam ter sessão iniciada no iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И вы, и получатель должны войти в iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Både du och mottagaren måste vara inloggade på iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งผู้ส่งและผู้รับต้องลงชื่อเข้าใช้ iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem sizin hem de alıcının iCloud'a giriş yapmış olması gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả người tặng và người nhận đều cần đăng nhập iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "赠送方和领取方都需要登录 iCloud。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "送禮的人和收禮的人都需要登入 iCloud。"
          }
        }
      }
    },
