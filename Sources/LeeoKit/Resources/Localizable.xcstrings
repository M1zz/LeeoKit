    "밖에서는 폰으로 할 일을 단계로 쪼갭니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out and about, you split tasks into steps on the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat di luar, tugas dipecah menjadi langkah di ponsel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外ではiPhoneでやることを段階に分けます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На улице вы разбиваете дела на шаги на телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在外面用手机把待办拆成步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在外面用手機把待辦拆成步驟。"
          }
        }
