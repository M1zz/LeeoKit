            "value": "Feedback sent!\nThank you for your input 🙏"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feedback sent!\nThank you for your valuable input 🙏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
