    "네, 좋아요 👍": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano, líbí se mi 👍"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, jeg kan lide den 👍"
          }
