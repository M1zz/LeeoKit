    "회사 이름만 바뀌는 자기소개는 클립키보드 템플릿으로 한 번만 만들어 두고 키보드에서 꺼냅니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorstellung, in der sich nur der Firmenname ändert, wird einmal zur ClipKeyboard-Vorlage und kommt dann aus der Tastatur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The introduction where only the company name changes becomes a ClipKeyboard template once, then comes out of the keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presentación en la que solo cambia el nombre de la empresa se convierte una vez en una plantilla de ClipKeyboard y luego sale del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La présentation dont seul le nom de l’entreprise change devient une fois pour toutes un modèle ClipKeyboard, puis sort du clavier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkenalan diri yang hanya berubah nama perusahaannya dibuat sekali sebagai templat ClipKeyboard, lalu diambil dari papan ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La presentazione in cui cambia solo il nome dell’azienda diventa una volta per tutte un modello di ClipKeyboard, e poi esce dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社名だけが変わる自己紹介は、ClipKeyboardのテンプレートに一度だけ作ってキーボードから取り出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회사 이름만 바뀌는 자기소개는 클립키보드 템플릿으로 한 번만 만들어 두고 키보드에서 꺼냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A apresentação em que só muda o nome da empresa vira um modelo do ClipKeyboard uma única vez e depois sai direto do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассказ о себе, где меняется только название компании, один раз становится шаблоном ClipKeyboard и потом достаётся с клавиатуры."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติแนะนำตัวที่เปลี่ยนแค่ชื่อบริษัท สร้างเป็นเทมเพลตใน ClipKeyboard ครั้งเดียว แล้วเรียกจากแป้นพิมพ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần giới thiệu bản thân chỉ đổi tên công ty được tạo một lần thành mẫu ClipKeyboard, rồi lấy ra từ bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有公司名不同的自我介绍，用剪贴键盘的模板做一次，之后从键盘取出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有公司名不同的自我介紹，用剪貼鍵盤的範本做一次，之後從鍵盤取出。"
          }
        }
      }
    },
