    "욕망의 무지개가 '지원서 넣기'를 단계로 쪼갭니다. 자기소개를 붙여넣는 일은 5분 조각으로 남습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire rozloží odeslání žádosti na kroky. Vložení průvodního textu zůstane pětiminutovým kouskem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire deler det at sende en ansøgning op i trin. At indsætte din præsentation forbliver et stykke på fem minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire zerlegt das Verschicken einer Bewerbung in Schritte. Das Einfügen deiner Vorstellung bleibt ein Fünf-Minuten-Stück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Rainbow of Desire χωρίζει την αποστολή μιας αίτησης σε βήματα. Η επικόλληση της αυτοπαρουσίασής σας μένει ένα κομμάτι πέντε λεπτών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire splits sending an application into steps. Pasting your introduction stays a five minute piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire divide el envío de una solicitud en pasos. Pegar tu presentación queda como una pieza de cinco minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire pilkkoo hakemuksen lähettämisen vaiheiksi. Esittelytekstin liittäminen jää viiden minuutin palaseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire découpe l’envoi d’une candidature en étapes. Coller votre présentation reste une tâche de cinq minutes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire memecah pengiriman lamaran menjadi langkah-langkah. Menempelkan perkenalan diri tetap menjadi kepingan lima menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire suddivide l’invio di una candidatura in passaggi. Incollare la tua presentazione resta un frammento da cinque minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desireが応募書類を出す作業を段階に分けます。自己紹介を貼り付けるところは5分の小片として残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "욕망의 무지개가 '지원서 넣기'를 단계로 쪼갭니다. 자기소개를 붙여넣는 일은 5분 조각으로 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire deler opp det å sende en søknad i trinn. Å lime inn presentasjonen din forblir en bit på fem minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire deelt het versturen van een sollicitatie op in stappen. Je introductie plakken blijft een stukje van vijf minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire dzieli wysyłanie zgłoszenia na kroki. Wklejenie tekstu o sobie zostaje pięciominutowym kawałkiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rainbow of Desire divide o envio de uma candidatura em passos. Colar sua apresentação continua sendo um pedaço de cinco minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire разбивает подачу заявки на шаги. Вставить рассказ о себе остаётся кусочком на пять минут."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire delar upp att skicka en ansökan i steg. Att klistra in din presentation förblir en femminutersbit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire แบ่งการส่งใบสมัครเป็นขั้นตอน การวางประวัติแนะนำตัวจะเหลือเป็นชิ้นงาน 5 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire, başvuru göndermeyi adımlara böler. Kendinizi tanıttığınız metni yapıştırmak beş dakikalık bir parça olarak kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire chia việc gửi đơn ứng tuyển thành các bước. Việc dán phần giới thiệu bản thân chỉ là một mảnh năm phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欲望彩虹把投申请拆成步骤。粘贴自我介绍这一步，仍然是五分钟的碎片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "欲望彩虹把投申請拆成步驟。貼上自我介紹這一步，仍然是五分鐘的碎片。"
          }
        }
      }
    },
    "욕망의 무지개가 이 일은 조각이 아니라 덩어리라고 먼저 말해 줍니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire vám hned na začátku řekne, že tohle je blok, ne kousek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire fortæller dig på forhånd, at det her er en blok og ikke et stykke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire sagt dir gleich vorab, dass das hier ein Block ist und kein Stück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Rainbow of Desire σάς λέει από πριν ότι αυτό είναι μπλοκ, όχι κομμάτι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire tells you up front that this one is a block, not a piece."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire te avisa de antemano de que esto es un bloque, no una pieza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire kertoo heti alussa, että tämä on kokonaisuus eikä palanen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire vous dit d’emblée que cette tâche est un bloc, pas un morceau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire lebih dulu memberi tahu bahwa ini bongkahan, bukan kepingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire ti dice subito che questo è un blocco, non un frammento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desireが、これは小片ではなく塊だと先に教えてくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "욕망의 무지개가 이 일은 조각이 아니라 덩어리라고 먼저 말해 줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire sier fra med en gang at dette er en blokk, ikke en bit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire vertelt je meteen dat dit een blok is en geen stukje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire od razu mówi, że to zadanie jest blokiem, a nie kawałkiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rainbow of Desire avisa logo de cara que isto é um bloco, não um pedaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire сразу говорит, что это блок, а не кусочек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire säger direkt att det här är ett block och inte en bit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
