    "구매를 확인하지 못했어요. 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht bestätigt werden. Bitte versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify the purchase. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar la compra. Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier l’achat. Réessayez dans un instant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian tidak dapat diverifikasi. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’acquisto. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 확인하지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a compra. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить покупку. Попробуйте ещё раз чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการซื้อไม่สำเร็จ โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh giao dịch mua. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证此次购买，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證此次購買，請稍後再試。"
          }
        }
      }
    },
    "구매가 승인 대기 중이에요. 승인되면 자동으로 반영됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Er wird automatisch wirksam, sobald er genehmigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is waiting for approval. It'll apply automatically once approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Se aplicará automáticamente cuando se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d’approbation. Il s’appliquera automatiquement une fois approuvé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian Anda menunggu persetujuan. Akan otomatis diterapkan setelah disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Verrà applicato automaticamente una volta approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されると自動的に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 승인 대기 중이에요. 승인되면 자동으로 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. Ela será aplicada automaticamente assim que for aprovada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения. Она применится автоматически после подтверждения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อกำลังรอการอนุมัติ จะมีผลโดยอัตโนมัติเมื่อได้รับอนุมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đang chờ phê duyệt. Sẽ tự động áp dụng khi được phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准，批准后会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買正在等待核准，核准後會自動生效。"
          }
        }
      }
    },
