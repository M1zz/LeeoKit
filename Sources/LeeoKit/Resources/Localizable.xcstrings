    "예) 만들어 둔 것 20개 중 절반쯤 없어졌어요.": {
      "comment": "Data loss prompt placeholder: what and how much",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. z 20 uložených položek zmizela zhruba polovina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Omkring halvdelen af de 20 ting, jeg havde lavet, er væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Von meinen 20 Einträgen ist etwa die Hälfte weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Π.χ. Από τα 20 που είχα φτιάξει, χάθηκαν περίπου τα μισά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. About half of the 20 items I'd made are gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej.: De los 20 que tenía, falta más o menos la mitad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. Noin puolet tekemistäni 20 kohteesta on kadonnut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : Sur mes 20 éléments, environ la moitié a disparu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
