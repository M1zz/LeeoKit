    "밖에서는 폰으로 할 일을 단계로 쪼갭니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Venku si úkoly rozložíte na kroky v telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du er ude, deler du opgaver op i trin på iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs zerlegst du Aufgaben auf dem iPhone in Schritte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτός σπιτιού, χωρίζετε τις εργασίες σε βήματα στο iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out and about, you split tasks into steps on the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de casa, divides las tareas en pasos en el teléfono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkeellä ollessasi pilkot tehtävät vaiheiksi iPhonella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En déplacement, vous découpez les tâches en étapes sur le téléphone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat di luar, tugas dipecah menjadi langkah di ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori casa, suddividi le attività in passaggi sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外ではiPhoneでやることを段階に分けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밖에서는 폰으로 할 일을 단계로 쪼갭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ute deler du opp oppgaver i trinn på iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderweg deel je taken op je iPhone op in stappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W drodze dzielisz zadania na kroki w telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora de casa, você divide as tarefas em passos no celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На улице вы разбиваете дела на шаги на телефоне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ute på stan delar du upp uppgifter i steg på din iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่ออยู่ข้างนอก แบ่งงานเป็นขั้นตอนบนโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışarıdayken görevleri iPhone'da adımlara bölersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ra ngoài, bạn chia việc thành các bước trên điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在外面用手机把待办拆成步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在外面用手機把待辦拆成步驟。"
          }
        }
      }
    },
