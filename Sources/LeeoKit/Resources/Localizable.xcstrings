    "피드백을 보냈습니다!\n소중한 의견 감사합니다 🙏": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpětná vazba odeslána!\nDěkujeme za váš názor 🙏"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback sendt!\nTak for dit input 🙏"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback gesendet!\nDanke für deine Rückmeldung 🙏"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σχόλιο στάλθηκε!\nΕυχαριστούμε για τη γνώμη σας 🙏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback sent!\nThank you for your input 🙏"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Comentario enviado!\nGracias por tu opinión 🙏"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaute lähetetty!\nKiitos palautteestasi 🙏"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commentaire envoyé !\nMerci pour votre retour 🙏"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feedback sent!\nThank you for your valuable input 🙏"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback inviato!\nGrazie per il tuo contributo 🙏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを送信しました！\n貴重なご意見ありがとうございます 🙏"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백을 보냈습니다!\n소중한 의견 감사합니다 🙏"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakemeldingen er sendt!\nTakk for innspillet ditt 🙏"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback verstuurd!\nBedankt voor je reactie 🙏"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opinia wysłana!\nDziękujemy za Twoją wiadomość 🙏"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback enviado!\nObrigado pela sua contribuição 🙏"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв отправлен!\nСпасибо за ваше мнение 🙏"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback skickad!\nTack för din synpunkt 🙏"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นแล้ว\nขอบคุณสำหรับความคิดเห็น 🙏"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirim gönderildi!\nKatkınız için teşekkürler 🙏"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi góp ý!\nCảm ơn ý kiến quý báu của bạn 🙏"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
