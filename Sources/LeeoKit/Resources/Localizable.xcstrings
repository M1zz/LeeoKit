    "발표나 시험처럼 남은 시간을 배분해야 할 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když si musíte rozvrhnout zbývající čas, třeba při přednášce nebo zkoušce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skal fordele den tid, der er tilbage, fx til et oplæg eller en eksamen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die verbleibende Zeit einteilen musst, etwa bei einem Vortrag oder einer Prüfung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν πρέπει να μοιράσετε τον χρόνο που απομένει, όπως σε μια ομιλία ή μια εξέταση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you have to budget the time left, like a talk or an exam"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tienes que repartir el tiempo que queda, como en una charla o un examen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun jäljellä oleva aika pitää jakaa, kuten esitelmässä tai kokeessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous devez répartir le temps restant, comme pour un exposé ou un examen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat harus membagi sisa waktu, seperti presentasi atau ujian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando devi distribuire il tempo rimasto, come in una presentazione o un esame"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発表や試験のように、残り時間を配分するとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발표나 시험처럼 남은 시간을 배분해야 할 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du må fordele tiden som er igjen, som ved et foredrag eller en eksamen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de resterende tijd moet verdelen, zoals bij een presentatie of een examen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy musisz rozłożyć pozostały czas, na przykład podczas wystąpienia albo egzaminu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você precisa distribuir o tempo que resta, como numa apresentação ou numa prova"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда нужно распределить оставшееся время: доклад, экзамен"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du måste fördela den tid som är kvar, som vid en presentation eller ett prov"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องแบ่งเวลาที่เหลือ เช่น การนำเสนอหรือการสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sunum ya da sınav gibi kalan süreyi bölüştürmeniz gerektiğinde"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi phải chia thời gian còn lại, như buổi thuyết trình hay kỳ thi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演讲或考试这类需要分配剩余时间的场合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "演講或考試這類需要分配剩餘時間的場合"
          }
        }
      }
    },
