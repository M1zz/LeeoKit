    "상대가 확인해 주기로 한 시각은 두번알림에 겁니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas, kdy se má druhá strana ozvat, si nastavíte v Rereminderu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tidspunkt, hvor den anden part lovede at vende tilbage, kommer i Rereminder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeit, zu der sich die andere Seite melden wollte, kommt in Rereminder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την ώρα που η άλλη πλευρά υποσχέθηκε να επιβεβαιώσει τη βάζετε στο Rereminder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time the other side promised to confirm goes into Rereminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora a la que la otra parte prometió confirmar va a Rereminder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellonaika, jolloin toisen osapuolen piti vahvistaa, menee Rereminderiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure à laquelle l’autre partie a promis de confirmer va dans Rereminder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu yang dijanjikan pihak lain untuk mengonfirmasi dititipkan ke Rereminder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora in cui l’altra parte ha promesso di confermare va in Rereminder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が確認すると約束した時刻はRereminderに預けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대가 확인해 주기로 한 시각은 두번알림에 겁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidspunktet den andre parten lovet å bekrefte, legges inn i Rereminder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tijdstip waarop de ander zou bevestigen, zet je in Rereminder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina, o której druga strona obiecała dać znać, trafia do Rereminder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário em que a outra pessoa prometeu confirmar vai para o Rereminder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Час, к которому вторая сторона обещала ответить, уходит в Rereminder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiden då den andra parten lovade att höra av sig läggs in i Rereminder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาที่อีกฝ่ายสัญญาว่าจะยืนยัน ให้ตั้งไว้ใน Rereminder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşı tarafın onay vereceğini söylediği saat Rereminder'a girer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm bên kia hứa xác nhận thì đặt vào Rereminder."
          }
        },
