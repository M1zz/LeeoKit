    "무지개 공방에서 오늘 요일 칸에 할 일을 끌어다 놓습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rainbow Craft ziehst du die heutigen Aufgaben in die Spalte des Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In 무지개 공방 you drag today's tasks into the column for the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Rainbow Craft arrastras las tareas de hoy a la columna del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Rainbow Craft, vous faites glisser les tâches du jour dans la colonne de ce jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di 무지개 공방, tugas hari ini diseret ke kolom harinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Rainbow Craft trascini le attività di oggi nella colonna del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "무지개 공방で、今日の曜日の列にやることをドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무지개 공방에서 오늘 요일 칸에 할 일을 끌어다 놓습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Rainbow Craft, você arrasta as tarefas de hoje para a coluna do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В 무지개 공방 вы перетаскиваете дела в колонку сегодняшнего дня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Rainbow Craft ลากงานของวันนี้ไปวางในช่องของวันนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Rainbow Craft, bạn kéo việc hôm nay vào cột của ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 무지개 공방 里，把今天要做的事拖进当天那一列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 무지개 공방 裡，把今天要做的事拖進當天那一列。"
          }
        }
      }
    },
    "문의 답변, 지원서, 예약 확인처럼 문장이 반복되는 일": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Support-Antworten, Bewerbungen, Buchungsbestätigungen: Arbeit, bei der sich dieselben Zeilen wiederholen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support replies, applications, booking confirmations: work where the same lines repeat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultas de clientes, solicitudes, confirmaciones de reserva: trabajo en el que se repiten las mismas frases"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponses au support, candidatures, confirmations de réservation : un travail où les mêmes phrases reviennent"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan pertanyaan, lamaran, konfirmasi pemesanan: pekerjaan dengan kalimat yang berulang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposte all’assistenza, candidature, conferme di prenotazione: lavori in cui le stesse righe si ripetono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問い合わせ対応、応募書類、予約確認など、同じ文章が繰り返される仕事"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문의 답변, 지원서, 예약 확인처럼 문장이 반복되는 일"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas de suporte, candidaturas, confirmações de reserva: trabalhos em que as mesmas frases se repetem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы на обращения, заявки, подтверждения брони: работа, где фразы повторяются"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ประโยคซ้ำกันบ่อย เช่น ตอบคำถาม ใบสมัคร ยืนยันการจอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời câu hỏi, đơn ứng tuyển, xác nhận đặt chỗ: những việc lặp lại cùng câu chữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客服回复、投递申请、预订确认这类句子不断重复的事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "客服回覆、投遞申請、預訂確認這類句子不斷重複的事"
