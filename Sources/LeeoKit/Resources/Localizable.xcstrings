            "state": "translated",
            "value": "Например: каждый раз. Перезагрузка устройства не помогает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. Varje gång. Samma sak efter att jag startat om enheten."
