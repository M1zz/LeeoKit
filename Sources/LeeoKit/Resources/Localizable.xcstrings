    "기능은 그대로, 앱을 더 다듬는 데 쓰여요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikaci se nic nemění, pomůže to ji dál vylepšovat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet ændres i appen, det hjælper med at gøre den bedre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App bleibt gleich, es hilft beim Weiterentwickeln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν αλλάζει στην εφαρμογή, βοηθά να γίνει ακόμα καλύτερη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes in the app, it helps polish it further"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada en la app, ayuda a pulirla más"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus pysyy samana, tuki auttaa hiomaan sitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change dans l'app, cela aide à la peaufiner"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur tetap sama, dipakai untuk menyempurnakan app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non cambia, aiuta a migliorarla ancora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能はそのまま、アプリをさらに磨くために使われます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능은 그대로, 앱을 더 다듬는 데 쓰여요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting endres i appen, det hjelper til å gjøre den bedre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verandert niets in de app, het helpt om hem verder te verbeteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcje się nie zmieniają, to pomaga dalej dopracowywać aplikację"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda no app, ajuda a deixá-lo ainda melhor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции не меняются, деньги идут на доработку приложения"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget ändras i appen, det hjälper till att förbättra den"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์เหมือนเดิม ใช้เพื่อปรับแอปให้ดียิ่งขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada hiçbir şey değişmez, daha da iyileştirmeye yarar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng giữ nguyên, dùng để hoàn thiện ứng dụng hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能不变，用来把 App 做得更好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "功能不變，用來把 App 做得更好"
          }
        }
      }
    },
    "한 번만 결제돼요. 구독이 아니고, 열리는 기능도 없어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorázová platba. Není to předplatné a nic neodemyká."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En engangsbetaling. Ikke et abonnement, og den låser ikke noget op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einmalige Zahlung. Kein Abo, und es schaltet nichts frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφάπαξ πληρωμή. Δεν είναι συνδρομή και δεν ξεκλειδώνει τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time payment. Not a subscription, and it unlocks nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un pago único. No es una suscripción y no desbloquea nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertamaksu. Ei tilaus, eikä se avaa mitään ominaisuuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement unique. Ce n'est pas un abonnement et cela ne débloque rien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran sekali saja. Bukan langganan, dan tidak membuka fitur apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pagamento unico. Non è un abbonamento e non sblocca nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回だけのお支払いです。サブスクリプションではなく、機能も追加されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 결제돼요. 구독이 아니고, 열리는 기능도 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En engangsbetaling. Ikke et abonnement, og den låser ikke opp noe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eenmalige betaling. Geen abonnement en het ontgrendelt niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa płatność. To nie subskrypcja i niczego nie odblokowuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um pagamento único. Não é assinatura e não libera nenhum recurso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовый платёж. Это не подписка, и никаких функций он не открывает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En engångsbetalning. Ingen prenumeration, och den låser inte upp något."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชำระครั้งเดียว ไม่ใช่การสมัครสมาชิก และไม่ได้ปลดล็อกฟีเจอร์ใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik bir ödemedir. Abonelik değildir ve hiçbir özelliği açmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thanh toán một lần. Không phải gói đăng ký và không mở thêm tính năng nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只付一次。不是订阅，也不会解锁任何功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只付一次。不是訂閱，也不會解鎖任何功能。"
          }
        }
      }
    },
