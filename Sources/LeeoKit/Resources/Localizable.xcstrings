    "CloudKit Dashboard의 admin 역할에 이 ID를 추가하면 앱에서 모든 피드백을 읽을 수 있어요. 탭하면 복사됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte toto ID do role admin v CloudKit Dashboard a budete moct v aplikaci číst veškerou zpětnou vazbu. Klepnutím ho zkopírujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Føj dette id til admin-rollen i CloudKit Dashboard for at læse al feedback i appen. Tryk for at kopiere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diese ID in CloudKit Dashboard zur Admin-Rolle hinzu, um in der App alle Feedbacks lesen zu können. Tippen zum Kopieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε αυτό το ID στον ρόλο admin στο CloudKit Dashboard για να διαβάζετε όλα τα σχόλια στην εφαρμογή. Πατήστε για αντιγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this ID to the admin role in CloudKit Dashboard to read all feedback in the app. Tap to copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade este ID al rol admin en CloudKit Dashboard para leer todos los comentarios en la app. Toca para copiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä tunnus CloudKit Dashboardin admin-rooliin, niin voit lukea kaiken palautteen apissa. Kopioi napauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cet identifiant au rôle admin dans CloudKit Dashboard pour lire tous les commentaires dans l’app. Touchez pour copier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan ID ini ke peran admin di CloudKit Dashboard untuk membaca semua masukan di aplikasi. Ketuk untuk menyalin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo ID al ruolo admin in CloudKit Dashboard per leggere tutti i feedback nell’app. Tocca per copiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit DashboardのadminロールにこのIDを追加すると、アプリで全てのフィードバックを読めます。タップでコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit Dashboard의 admin 역할에 이 ID를 추가하면 앱에서 모든 피드백을 읽을 수 있어요. 탭하면 복사됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til denne ID-en i admin-rollen i CloudKit Dashboard for å lese alle tilbakemeldinger i appen. Trykk for å kopiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg deze ID in CloudKit Dashboard toe aan de admin-rol om alle feedback in de app te kunnen lezen. Tik om te kopiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj ten identyfikator do roli admin w CloudKit Dashboard, aby czytać w aplikacji wszystkie opinie. Stuknij, aby skopiować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este ID à função admin no CloudKit Dashboard para ler todo o feedback no app. Toque para copiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте этот ID в роль admin в CloudKit Dashboard, чтобы читать все отзывы в приложении. Нажмите, чтобы скопировать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till detta ID i admin-rollen i CloudKit Dashboard för att kunna läsa all feedback i appen. Tryck för att kopiera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม ID นี้ในบทบาท admin ของ CloudKit Dashboard เพื่ออ่านความคิดเห็นทั้งหมดในแอป แตะเพื่อคัดลอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada tüm geri bildirimleri okumak için bu kimliği CloudKit Dashboard'daki admin rolüne ekleyin. Kopyalamak için dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ID này vào vai trò admin trong CloudKit Dashboard để đọc mọi góp ý trong ứng dụng. Chạm để sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个 ID 加到 CloudKit Dashboard 的 admin 角色里，就能在 App 内读取所有反馈。点按即可复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這個 ID 加到 CloudKit Dashboard 的 admin 角色裡，就能在 App 內讀取所有意見回饋。點一下即可複製。"
          }
        }
      }
    },
    "Mail 앱이 설정되어 있지 않습니다. mailto: 링크로 다른 메일 앱을 열겠습니까?": {
      "localizations": {
