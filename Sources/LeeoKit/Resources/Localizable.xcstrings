    "지금 만들고 있는 것과 다음에 만들 것이에요. 순서와 시기는 바뀔 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na čem pracujeme teď a co bude dál. Pořadí a termíny se mohou změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, vi laver nu, og det, der kommer bagefter. Rækkefølge og tidspunkt kan ændre sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woran wir gerade arbeiten und was als Nächstes kommt. Reihenfolge und Zeitpunkt können sich ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι φτιάχνουμε τώρα και τι ακολουθεί. Η σειρά και ο χρόνος μπορεί να αλλάξουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we're building now and what's next. Order and timing may change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que estamos haciendo ahora y lo que sigue. El orden y las fechas pueden cambiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä teemme nyt ja mitä seuraavaksi. Järjestys ja aikataulu voivat muuttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que nous faisons maintenant et ce qui suit. L'ordre et les dates peuvent changer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sedang kami buat dan yang berikutnya. Urutan dan waktunya bisa berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò a cui stiamo lavorando ora e cosa viene dopo. Ordine e tempi possono cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま作っているものと、次に作るものです。順番や時期は変わることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 만들고 있는 것과 다음에 만들 것이에요. 순서와 시기는 바뀔 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vi lager nå og det som kommer etterpå. Rekkefølge og tid kan endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar we nu aan werken en wat er volgt. Volgorde en timing kunnen veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad czym pracujemy teraz i co dalej. Kolejność i terminy mogą się zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que estamos fazendo agora e o que vem depois. A ordem e as datas podem mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что мы делаем сейчас и что дальше. Порядок и сроки могут измениться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vi gör nu och det som kommer härnäst. Ordning och tid kan ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่กำลังทำอยู่และสิ่งที่จะทำต่อไป ลำดับและเวลาอาจเปลี่ยนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an yaptıklarımız ve sıradakiler. Sıra ve zaman değişebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì đang làm và sẽ làm tiếp. Thứ tự và thời gian có thể thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是正在做的和接下来要做的。顺序和时间可能会变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡是正在做的和接下來要做的。順序和時間可能會變。"
          }
        }
      }
    },
