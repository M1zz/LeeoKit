    "알림 권한이 꺼져 있어요. iOS 설정 > %@ > 알림에서 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind ausgeschaltet. Bitte erlaube sie in den iOS-Einstellungen > %@ > Mitteilungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off. Please allow them in iOS Settings > %@ > Notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permítelas en Ajustes de iOS > %@ > Notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorisez-les dans Réglages iOS > %@ > Notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Consentile in Impostazioni di iOS > %@ > Notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっています。iOSの設定 > %@ > 通知で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 꺼져 있어요. iOS 설정 > %@ > 알림에서 허용해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Permita em Ajustes do iOS > %@ > Notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены. Разрешите их в Настройках iOS > %@ > Уведомления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดอยู่ โปรดอนุญาตใน การตั้งค่า iOS > %@ > การแจ้งเตือน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt. Hãy cho phép trong Cài đặt iOS > %@ > Thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知权限没打开。请在“iOS 设置 > %@ > 通知”里允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知權限沒開啟。請在「iOS 設定 > %@ > 通知」裡允許。"
          }
        }
      }
    },
