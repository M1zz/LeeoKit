            "value": "Màn hình ngay trước khi đứng hoặc thoát"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡住或闪退前的画面"
          }
        },
        "zh-Hant": {
