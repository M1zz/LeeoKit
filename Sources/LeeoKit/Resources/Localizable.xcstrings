    "화면 한 장이 글보다 빠릅니다. 스크린샷을 붙여 주시면 훨씬 정확하게 고칠 수 있어요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Screenshot sagt mehr als ein Absatz. Wenn du einen anhängst, können wir es viel genauer beheben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One screenshot says more than a paragraph. Attaching one helps us fix it accurately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una captura dice más que un párrafo. Si adjuntas una, podremos arreglarlo con más precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture d’écran en dit plus qu’un paragraphe. En joindre une nous aide à corriger précisément."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "One screenshot says more than a paragraph. Attaching one helps us fix it accurately."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno screenshot dice più di un paragrafo. Allegarne uno ci aiuta a risolvere il problema con precisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一枚の画面が文章より早く伝わります。スクリーンショットを添えていただくと、より正確に直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 한 장이 글보다 빠릅니다. 스크린샷을 붙여 주시면 훨씬 정확하게 고칠 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma captura de tela diz mais do que um parágrafo. Anexar uma nos ajuda a corrigir com precisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один скриншот скажет больше, чем абзац. С ним мы исправим точнее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอเดียวบอกได้มากกว่าข้อความ การแนบภาพช่วยให้เราแก้ไขได้แม่นยำขึ้นมาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ảnh màn hình nói được nhiều hơn một đoạn văn. Đính kèm ảnh giúp chúng tôi sửa chính xác hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张截图比一段文字更快说明问题。附上截图能帮我们更准确地修复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一張截圖比一段文字更快說明問題。附上截圖能幫我們更準確地修復。"
          }
        }
      }
    },
