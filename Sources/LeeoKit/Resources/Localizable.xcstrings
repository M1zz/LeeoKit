        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "욕망의 무지개 lebih dulu memberi tahu bahwa ini bongkahan, bukan kepingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainbow of Desire ti dice subito che questo è un blocco, non un frammento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "욕망의 무지개が、これは小片ではなく塊だと先に教えてくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "욕망의 무지개가 이 일은 조각이 아니라 덩어리라고 먼저 말해 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rainbow of Desire avisa logo de cara que isto é um bloco, não um pedaço."
