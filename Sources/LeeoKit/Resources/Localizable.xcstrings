    "예) 일과 집에서 쓰는 것이 섞여서, 필요한 쪽만 보고 싶어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. Mám smíchané pracovní a domácí položky a chci vidět jen jednu skupinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fx: Ting til arbejde og hjem er blandet sammen, og jeg vil kun se den ene del."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Einträge für Arbeit und Zuhause sind gemischt, und ich möchte nur eine Seite sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Τα στοιχεία της δουλειάς και του σπιτιού είναι ανακατεμένα και θέλω να βλέπω μόνο τη μία πλευρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Work and home items are mixed, and I want to see only one side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P. ej.: Las cosas del trabajo y de casa están mezcladas y quiero ver solo una parte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. työ- ja kotikohteet ovat sekaisin, ja haluaisin nähdä vain toiset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : mes éléments perso et pro sont mélangés, j’aimerais n’en voir qu’une partie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. Item kantor dan rumah tercampur, dan saya ingin melihat salah satunya saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Gli elementi di lavoro e di casa sono mescolati e vorrei vederne solo una parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）仕事用と家用が混ざるので、必要な方だけ見たいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 일과 집에서 쓰는 것이 섞여서, 필요한 쪽만 보고 싶어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Ting fra jobb og hjemme er blandet, og jeg vil bare se den ene delen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. Werk en thuis staan door elkaar en ik wil maar één kant zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. sprawy z pracy i z domu są wymieszane, a chcę widzieć tylko jedne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: Itens do trabalho e de casa ficam misturados, e quero ver só um dos lados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: рабочее и домашнее смешано, хочу видеть только нужное."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. Saker för jobbet och hemmet är blandade, och jag vill bara se det ena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น รายการเรื่องงานกับเรื่องบ้านปนกัน อยากดูเฉพาะฝั่งที่ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. İş ve ev öğeleri karışık; yalnızca birini görmek istiyorum."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví dụ: Mục cho công việc và ở nhà bị lẫn lộn, tôi chỉ muốn xem một bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例）工作和家里的内容混在一起，我只想看需要的那一类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例）工作和家裡的內容混在一起，我只想看需要的那一類。"
          }
        }
      }
    },
    "어떤 점이 불편하셨나요?": {
