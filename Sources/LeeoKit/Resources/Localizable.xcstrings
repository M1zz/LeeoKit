          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто набираемые фразы, прямо с клавиатуры"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกประโยคที่ใช้บ่อยออกมาจากแป้นพิมพ์ได้ทันที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy ngay từ bàn phím những câu bạn gõ đi gõ lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
