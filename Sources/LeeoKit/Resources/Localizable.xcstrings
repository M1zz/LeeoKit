    "받은 코드를 넣으면 Pro가 바로 열려요. 받은 메시지를 통째로 붙여넣어도 돼요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte kód, který jste dostali, a Pro se hned odemkne. Můžete vložit i celou zprávu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast den kode, du har fået, så låses Pro op med det samme. Du kan også indsætte hele beskeden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den erhaltenen Code ein, und Pro wird sofort freigeschaltet. Du kannst auch die ganze Nachricht einfügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλτε τον κωδικό που λάβατε και το Pro ξεκλειδώνει αμέσως. Μπορείτε να επικολλήσετε και ολόκληρο το μήνυμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code you received to unlock Pro right away. You can paste the whole message, too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código que recibiste y Pro se desbloqueará al instante. También puedes pegar el mensaje entero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä saamasi koodi, niin Pro avautuu heti. Voit myös liittää koko viestin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code reçu pour débloquer Pro immédiatement. Vous pouvez aussi coller le message entier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode yang kamu terima untuk langsung membuka Pro. Kamu juga bisa menempelkan seluruh pesannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice ricevuto e Pro si sblocca subito. Puoi anche incollare l’intero messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取ったコードを入力すると、すぐにProが使えます。メッセージをまるごと貼り付けてもOKです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 코드를 넣으면 Pro가 바로 열려요. 받은 메시지를 통째로 붙여넣어도 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn koden du har fått, så låses Pro opp med en gang. Du kan også lime inn hele meldingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul de ontvangen code in en Pro wordt meteen ontgrendeld. Je kunt ook het hele bericht plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz otrzymany kod, a Pro od razu się odblokuje. Możesz też wkleić całą wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código recebido para liberar o Pro na hora. Você também pode colar a mensagem inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите полученный код, и Pro откроется сразу. Можно вставить сообщение целиком."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange koden du fått så låses Pro upp direkt. Du kan också klistra in hela meddelandet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่รหัสที่ได้รับเพื่อปลดล็อก Pro ทันที จะวางข้อความทั้งหมดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldığınız kodu girin, Pro hemen açılsın. Mesajın tamamını da yapıştırabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã bạn nhận được để mở Pro ngay. Bạn cũng có thể dán nguyên tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入收到的礼品码，即可立即解锁 Pro。也可以直接粘贴整条信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入收到的禮物碼，就能立即解鎖 Pro。也可以直接貼上整則訊息。"
          }
        }
      }
    },
