    "서버에서 완전히 삭제되며 되돌릴 수 없어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo se smaže ze serveru a nepůjde to vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den slettes permanent fra serveren og kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird endgültig vom Server gelöscht und kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα διαγραφεί οριστικά από τον διακομιστή και δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be permanently deleted from the server and can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará definitivamente del servidor y no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poistetaan pysyvästi palvelimelta, eikä toimintoa voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera définitivement supprimé du serveur. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akan dihapus permanen dari server dan tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eliminato definitivamente dal server e non potrà essere ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから完全に削除され、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 완전히 삭제되며 되돌릴 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den slettes permanent fra serveren og kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt definitief van de server verwijderd en kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie trwale usunięta z serwera. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será apagado definitivamente do servidor e não poderá ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв будет удалён с сервера навсегда. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den raderas permanent från servern och kan inte återställas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะถูกลบออกจากเซิร์ฟเวอร์อย่างถาวรและเลิกทำไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudan kalıcı olarak silinecek ve geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góp ý sẽ bị xóa vĩnh viễn khỏi máy chủ và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从服务器上彻底删除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會從服務器上徹底刪除，無法復原。"
          }
        }
      }
    },
    "손을 키보드에서 떼지 않고 붙여넣고 싶을 때": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když nechcete sundat ruce z klávesnice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du helst ikke vil tage hænderne fra tastaturet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Hände lieber nicht von der Tastatur nehmen willst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δεν θέλετε να πάρετε τα χέρια από το πληκτρολόγιο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you would rather not take your hands off the keyboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando prefieres no quitar las manos del teclado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et halua irrottaa käsiäsi näppäimistöltä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous préférez ne pas lâcher le clavier"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda tidak ingin melepas tangan dari papan ketik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando preferisci non staccare le mani dalla tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードから手を離さずに貼り付けたいとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 키보드에서 떼지 않고 붙여넣고 싶을 때"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du helst ikke vil ta hendene bort fra tastaturet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je handen liever niet van het toetsenbord haalt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wolisz nie odrywać rąk od klawiatury"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você prefere não tirar as mãos do teclado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда не хочется убирать руки с клавиатуры"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du helst inte vill ta händerna från tangentbordet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องการวางโดยไม่ละมือจากแป้นพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellerinizi klavyeden ayırmak istemediğinizde"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn muốn dán mà không rời tay khỏi bàn phím"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不想把手从键盘上移开就完成粘贴时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不想把手從鍵盤上移開就完成貼上時"
          }
        }
      }
    },
