    "같은 iCloud 계정이면 다른 기기에서도 이전 구매 복원으로 다시 열려요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se stejným účtem iCloud ho „Obnovit nákupy“ odemkne i na dalších zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med den samme iCloud-konto låser »Gendan køb« det også op på dine andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit demselben iCloud-Account wird Pro über „Käufe wiederherstellen“ auch auf deinen anderen Geräten freigeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με τον ίδιο λογαριασμό iCloud, η «Επαναφορά αγορών» το ξεκλειδώνει και στις άλλες συσκευές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the same iCloud account, Restore Purchases unlocks it on your other devices too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la misma cuenta de iCloud, «Restaurar compras» también lo desbloquea en tus otros dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samalla iCloud-tilillä ”Palauta ostot” avaa sen myös muilla laitteillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le même compte iCloud, « Restaurer les achats » le débloque aussi sur vos autres appareils."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan akun iCloud yang sama, “Pulihkan Pembelian” juga membukanya di perangkat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con lo stesso account iCloud, «Ripristina acquisti» lo sblocca anche sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じiCloudアカウントなら、ほかのデバイスでも「購入を復元」で使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 iCloud 계정이면 다른 기기에서도 이전 구매 복원으로 다시 열려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med samme iCloud-konto låser «Gjenopprett kjøp» det også opp på de andre enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met hetzelfde iCloud-account ontgrendel je het via 'Herstel aankopen' ook op je andere apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym samym koncie iCloud „Odtwórz zakupy” odblokuje go też na innych urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a mesma conta do iCloud, “Restaurar compras” também libera nos seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С тем же аккаунтом iCloud Pro откроется и на других устройствах через «Восстановить покупки»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med samma iCloud-konto låser ”Återställ köp” upp det på dina andra enheter också."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากใช้บัญชี iCloud เดียวกัน กด “กู้คืนการซื้อ” บนอุปกรณ์อื่นเพื่อปลดล็อกได้เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı iCloud hesabıyla “Satın alınanları geri yükle” diğer cihazlarınızda da kilidi açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng tài khoản iCloud, “Khôi phục giao dịch mua” cũng mở khóa trên các thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一个 iCloud 账户时，在其他设备上点“恢复购买”也能解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一個 iCloud 帳號時，在其他裝置上點「回復購買項目」也能解鎖。"
          }
        }
      }
    },
    "결제가 승인 대기 중이에요. 승인되면 선물 코드가 만들어져요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na schválení. Dárkový kód se vytvoří po schválení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet venter på godkendelse. Gavekoden oprettes, når det er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung. Danach wird der Geschenkcode erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά περιμένει έγκριση. Ο κωδικός δώρου θα δημιουργηθεί μόλις εγκριθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is awaiting approval. The gift code will be created once it's approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está pendiente de aprobación. El código de regalo se creará cuando se apruebe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osto odottaa hyväksyntää. Lahjakoodi luodaan, kun osto on hyväksytty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat est en attente d’approbation. Le code cadeau sera créé une fois l’achat approuvé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian menunggu persetujuan. Kode hadiah dibuat setelah disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è in attesa di approvazione. Il codice regalo verrà creato dopo l’approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されるとギフトコードが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제가 승인 대기 중이에요. 승인되면 선물 코드가 만들어져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet venter på godkjenning. Gavekoden lages når det er godkjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop wacht op goedkeuring. Daarna wordt de cadeaucode gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup czeka na zatwierdzenie. Kod prezentu powstanie po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação. O código de presente será criado quando for aprovada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения. Код подарка появится после одобрения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet väntar på godkännande. Presentkoden skapas när det har godkänts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อกำลังรอการอนุมัติ ระบบจะสร้างรหัสของขวัญเมื่ออนุมัติแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onay bekliyor. Onaylanınca hediye kodu oluşturulur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đang chờ phê duyệt. Mã quà tặng sẽ được tạo sau khi được duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准。批准后就会生成礼品码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買正在等待核准。核准後就會產生禮物碼。"
          }
        }
      }
    },
    "결제는 됐어요. 연결되면 선물 코드를 만들어 드릴게요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba proběhla. Dárkový kód vytvoříme, jakmile budete znovu online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen er gennemført. Vi opretter gavekoden, når du er online igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung ist erfolgt. Sobald du online bist, erstellen wir den Geschenkcode."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληρωμή ολοκληρώθηκε. Θα δημιουργήσουμε τον κωδικό δώρου μόλις συνδεθείτε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment complete. We'll create your gift code once you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
