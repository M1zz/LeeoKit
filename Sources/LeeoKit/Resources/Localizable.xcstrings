    "불편하신 점이나 제안 사항을 자유롭게 적어주세요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidně popište svůj problém nebo návrh"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv gerne dit problem eller dit forslag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreib gern dein Problem oder deinen Vorschlag"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
