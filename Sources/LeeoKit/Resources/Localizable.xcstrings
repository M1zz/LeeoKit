            "state": "translated",
            "value": "Что было неудобно?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad kändes krångligt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สะดวกตรงไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zorlayıcı geldi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều gì khiến bạn thấy bất tiện?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪里让你觉得不方便？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪裡讓你覺得不方便？"
          }
        }
      }
    },
    "예) 항목이 많아지면 찾는 데 시간이 걸려요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. Když je položek hodně, trvá dlouho nějakou najít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fx: Når der er mange elementer, tager det tid at finde ét."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Wenn es viele Einträge gibt, dauert es, einen zu finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Όταν υπάρχουν πολλά στοιχεία, θέλει χρόνο να βρω ένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Once there are many items, finding one takes a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P. ej.: Cuando hay muchos elementos, encontrar uno lleva tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. kun kohteita on paljon, yhden löytäminen kestää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : quand il y a beaucoup d’éléments, en trouver un prend du temps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. Kalau item sudah banyak, butuh waktu untuk menemukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Quando gli elementi sono tanti, trovarne uno richiede un po’ di tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）項目が増えると探すのに時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 항목이 많아지면 찾는 데 시간이 걸려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Når det er mange elementer, tar det tid å finne ett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. Als er veel onderdelen zijn, duurt het lang om er een te vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. gdy elementów jest dużo, znalezienie jednego zajmuje sporo czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: Quando há muitos itens, demora para encontrar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напр.: когда записей много, поиск занимает время."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. När det finns många objekt tar det tid att hitta ett."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น พอมีรายการเยอะ ต้องใช้เวลาหานาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. Öğe sayısı artınca birini bulmak zaman alıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví dụ: Khi có nhiều mục, tìm một mục mất khá lâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例）条目一多，找起来就很花时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例）項目一多，找起來就很花時間。"
          }
        }
      }
    },
    "그때 무엇을 하고 계셨나요?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste v tu chvíli dělali?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad var du i gang med på det tidspunkt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hast du in dem Moment gemacht?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι κάνατε εκείνη τη στιγμή;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What were you doing at the time?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué estabas haciendo en ese momento?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä olit silloin tekemässä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que faisiez-vous à ce moment-là ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang sedang Anda lakukan saat itu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa stavi facendo in quel momento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その時、何をしていましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때 무엇을 하고 계셨나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva holdt du på med da?"
