          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие в строке меню, те же фразы на Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกเดียวที่แถบเมนู ใช้ประโยคเดียวกันบน Mac"
