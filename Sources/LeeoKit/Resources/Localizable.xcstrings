            "value": "Konten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容"
          }
        }
      }
    },
    "내용을 입력하면 활성화됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter content to enable"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enter content to enable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を入力すると有効になります"
          }
        }
      }
    },
    "다른 메일 앱으로 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open with Another Mail App"
