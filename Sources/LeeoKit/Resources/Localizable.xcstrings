        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aconteceu e o que você estava fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда это случилось и что вы делали?"
          }
        },
        "th": {
