            "value": "名前"
          }
        }
      }
    },
    "이름 (선택)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name (optional)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お名前（任意）"
          }
        }
      }
    },
    "이메일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール"
          }
        }
      }
    },
    "자동 첨부 정보": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-attached Info"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auto-attached Info"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動添付情報"
          }
        }
      }
    },
    "자유롭게 의견을 남겨주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
