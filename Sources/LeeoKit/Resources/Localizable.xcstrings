          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Anda lakukan sebelum data hilang?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa hai fatto prima che sparisse?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消える前に何をしましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사라지기 전에 무엇을 했나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva gjorde du før det forsvant?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat deed je vlak voordat het verdween?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co robiłeś, zanim dane zniknęły?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você fez antes de sumir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы делали перед тем, как данные пропали?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad gjorde du innan det försvann?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนข้อมูลหาย คุณทำอะไรไปบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaybolmadan önce ne yaptınız?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi bị mất, bạn đã làm gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢失之前做过什么操作？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不見之前做過什麼操作？"
          }
        }
      }
    },
    "예) 앱을 업데이트했어요. 새 아이폰으로 옮겼어요. 앱을 지웠다 다시 깔았어요.": {
      "comment": "Data loss prompt placeholder: what happened before",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. aktualizoval jsem aplikaci. Přešel jsem na nový iPhone. Smazal jsem aplikaci a znovu ji nainstaloval."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Jeg opdaterede appen. Jeg skiftede til en ny iPhone. Jeg slettede appen og installerede den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Ich habe die App aktualisiert. Ich bin auf ein neues iPhone umgezogen. Ich habe die App gelöscht und neu installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Π.χ. Ενημέρωσα την εφαρμογή. Μετέφερα τα δεδομένα σε νέο iPhone. Διέγραψα και εγκατέστησα ξανά την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. I updated the app. I moved to a new iPhone. I deleted and reinstalled the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej.: Actualicé la app. Me pasé a un iPhone nuevo. Borré la app y la volví a instalar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. Päivitin sovelluksen. Siirryin uuteen iPhoneen. Poistin sovelluksen ja asensin sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : J'ai mis à jour l'app. Je suis passé à un nouvel iPhone. J'ai supprimé puis réinstallé l'app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis. Saya memperbarui app. Pindah ke iPhone baru. Menghapus lalu memasang ulang app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Es.: Ho aggiornato l'app. Sono passato a un nuovo iPhone. Ho eliminato e reinstallato l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）アプリをアップデートしました。新しいiPhoneに移行しました。アプリを削除して入れ直しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 앱을 업데이트했어요. 새 아이폰으로 옮겼어요. 앱을 지웠다 다시 깔았어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Jeg oppdaterte appen. Jeg byttet til en ny iPhone. Jeg slettet appen og installerte den på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. Ik heb de app bijgewerkt. Ik ben overgestapt op een nieuwe iPhone. Ik heb de app verwijderd en opnieuw geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. zaktualizowałem aplikację. Przeniosłem dane na nowego iPhone'a. Usunąłem i ponownie zainstalowałem aplikację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: Atualizei o app. Passei para um iPhone novo. Apaguei e reinstalei o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например: обновил приложение. Перешёл на новый iPhone. Удалил и заново установил приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. Jag uppdaterade appen. Jag bytte till en ny iPhone. Jag raderade appen och installerade om den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น อัปเดตแอป ย้ายไป iPhone เครื่องใหม่ ลบแอปแล้วติดตั้งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. Uygulamayı güncelledim. Yeni iPhone'a geçtim. Uygulamayı silip yeniden yükledim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VD: Tôi đã cập nhật ứng dụng. Chuyển sang iPhone mới. Xóa rồi cài lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：更新了 App。换了新 iPhone。删除后重新安装了 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：更新了 App。換了新 iPhone。刪除後重新安裝了 App。"
          }
        }
      }
    },
    "어떤 알림이, 언제 오기로 돼 있었나요?": {
      "comment": "Notification prompt: which and when",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaké oznámení a kdy mělo přijít?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken notifikation skulle komme, og hvornår?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Mitteilung hätte wann kommen sollen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια γνωστοποίηση και πότε έπρεπε να έρθει;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which notification, and when was it supposed to arrive?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué notificación debía llegar y cuándo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minkä ilmoituksen piti tulla, ja milloin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle notification devait arriver, et quand ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi apa, dan kapan seharusnya masuk?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale notifica doveva arrivare e quando?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの通知が、いつ届く予定でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 알림이, 언제 오기로 돼 있었나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilket varsel skulle komme, og når?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke melding had je verwacht, en wanneer?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakie powiadomienie i kiedy miało przyjść?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual notificação deveria chegar e quando?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое уведомление и когда должно было прийти?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken notis skulle komma, och när?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนอะไร และควรจะมาเมื่อไหร่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi bildirimin ne zaman gelmesi gerekiyordu?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo nào, lẽ ra phải đến lúc nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪条通知？原本应该什么时候收到？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪則通知？原本應該什麼時候收到？"
          }
        }
      }
    },
    "예) 오전 9시 알림이 안 왔어요. 5분 늦게 왔어요.": {
      "comment": "Notification prompt placeholder: which and when",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Např. oznámení na 9:00 nepřišlo. Přišlo o 5 minut později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Notifikationen kl. 9.00 kom ikke. Den kom 5 minutter for sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Die Mitteilung um 9 Uhr kam nicht. Sie kam 5 Minuten zu spät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Π.χ. Η γνωστοποίηση των 9 π.μ. δεν ήρθε. Ήρθε 5 λεπτά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. My 9 AM notification never came. It arrived 5 minutes late."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej.: No llegó la notificación de las 9:00. Llegó 5 minutos tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esim. Klo 9.00 ilmoitus ei tullut. Se tuli 5 minuuttia myöhässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex. : La notification de 9 h n'est pas arrivée. Elle est arrivée avec 5 minutes de retard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis. Notifikasi pukul 09.00 tidak masuk. Masuknya telat 5 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Es.: La notifica delle 9 non è arrivata. È arrivata con 5 minuti di ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例）午前9時の通知が来ませんでした。5分遅れて届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예) 오전 9시 알림이 안 왔어요. 5분 늦게 왔어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. Varselet kl. 9.00 kom ikke. Det kom 5 minutter for sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijv. De melding van 9:00 kwam niet. Hij kwam 5 minuten te laat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. powiadomienie na 9:00 nie przyszło. Przyszło 5 minut później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex.: A notificação das 9h não chegou. Chegou 5 minutos atrasada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например: уведомление на 9:00 не пришло. Пришло на 5 минут позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T.ex. Notisen kl. 9.00 kom inte. Den kom 5 minuter för sent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น การแจ้งเตือนตอน 9 โมงเช้าไม่มา มาช้าไป 5 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. Saat 9.00 bildirimi gelmedi. 5 dakika geç geldi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VD: Thông báo lúc 9 giờ sáng không đến. Đến trễ 5 phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：上午 9 点的通知没收到。晚了 5 分钟才到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：上午 9 點的通知沒收到。晚了 5 分鐘才到。"
          }
        }
      }
    },
    "그때 집중 모드나 무음 모드였나요? (선택)": {
      "comment": "Notification prompt: focus or silent mode",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Byl tehdy zapnutý režim soustředění nebo tichý režim? (nepovinné)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Var fokus eller lydløs tilstand slået til? (valgfrit)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "War gerade ein Fokus oder der Stummmodus aktiv? (optional)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ήταν ενεργή τότε κάποια λειτουργία εστίασης ή η αθόρυβη λειτουργία; (προαιρετικά)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was a Focus or Silent Mode on at the time? (optional)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tenías activado un modo de concentración o el modo silencio? (opcional)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oliko keskittyminen tai äänetön tila silloin päällä? (valinnainen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mode de concentration ou le mode silencieux était-il activé ? (facultatif)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah saat itu mode fokus atau mode senyap aktif? (opsional)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era attiva una modalità Full immersion o la modalità silenziosa? (facoltativo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのとき集中モードや消音モードでしたか？（任意）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때 집중 모드나 무음 모드였나요? (선택)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Var fokus eller stillemodus på da? (valgfritt)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stond er toen een focus of de stille modus aan? (optioneel)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy był wtedy włączony tryb skupienia lub tryb cichy? (opcjonalnie)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algum Foco ou o modo silencioso estava ativado? (opcional)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Был ли тогда включён режим фокусирования или бесшумный режим? (необязательно)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var fokus eller tyst läge på då? (valfritt)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนั้นเปิดโหมดโฟกัสหรือโหมดเงียบอยู่ไหม (ไม่บังคับ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O sırada odak modu veya sessiz mod açık mıydı? (isteğe bağlı)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc đó có bật Chế độ tập trung hoặc Chế độ im lặng không? (không bắt buộc)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当时开着专注模式或静音模式吗？（可选）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當時開著專注模式或靜音模式嗎？（選填）"
          }
        }
      }
    },
